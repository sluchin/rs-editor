(define (show label)
  (princ (format "%s: %d %s [%s]\n" label (point) (buffer-substring (point-min) (point-max)) (current-kill 0 #t))))
(begin (switch-to-buffer (generate-new-buffer "c"))
  (insert "alpha beta gamma")
  (goto-char 1)
  ;; C-<insert>, S-<delete>, S-<insert> (Emacs の既定のキー)
  (execute-kbd-macro (kbd "C-SPC M-f C-<insert>"))
  (show "C-insert")
  (execute-kbd-macro (kbd "C-SPC M-f S-<delete>"))
  (show "S-delete")
  (execute-kbd-macro (kbd "C-e S-<insert>"))
  (show "S-insert")
  ;; クリップボードのコマンド (バッチにはクリップボードが無い)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-SPC M-f M-x clipboard-kill-ring-save RET"))
  (show "clipboard-kill-ring-save")
  (execute-kbd-macro (kbd "C-e M-x clipboard-yank RET"))
  (show "clipboard-yank")
  (goto-char 1)
  (execute-kbd-macro (kbd "C-SPC M-f M-x clipboard-kill-region RET"))
  (show "clipboard-kill-region"))
