(define (show) (princ (format "%s %s %s\n" (buffer-name) (line-number-at-pos) (or (dired-get-filename #t) "nil"))))
(define (names)
  (princ (format "%s\n" (string-join (save-excursion
                                       (goto-char (point-min))
                                       (let loop ((r '()))
                                         (if (eobp)
                                             (reverse r)
                                             (let ((name (dired-get-filename #t)))
                                               (let ((r (if name
                                                            (cons (string-append (buffer-substring (line-beginning-position) (+ 1 (line-beginning-position))) name) r)
                                                            r)))
                                                 (forward-line 1)
                                                 (loop r))))))
                                     " "))))
(define (try keys) (condition-case e (execute-kbd-macro (kbd keys)) (error (princ (format "error %s\n" (error-message-string e))))))
(find-file "sub")
(show)
;; 割り当てない文字は undefined. 続くキーは動く
(try "z n") (show)
;; k は印を付けた行を一覧から消す. g で戻る (印と場所は残る)
(goto-char (point-min))
(re-search-forward "f2$")
(try "m m k") (names) (show)
(try "g") (names) (show)
(try "2 k") (names) (show)
(try "- 1 k") (names) (show)
(try "g")
(define (kill) (princ (format "%S\n" (current-kill 0))))
;; w は名前を kill-ring に写す
(goto-char (point-min)) (re-search-forward "f1$")
(try "w") (kill)
(try "2 w") (kill)
(try "0 w") (princ (format "%s %s\n" (substring (current-kill 0) 0 1) (file-name-nondirectory (current-kill 0))))
(goto-char (point-min)) (re-search-forward "s p$")
(try "m") (goto-char (point-min)) (re-search-forward "f1$")
(try "m w") (kill)
(try "U")
;; 開く
(goto-char (point-min)) (re-search-forward "d1$")
(try "RET") (show)
(try "^") (show)
(try "e") (show)
(try "^ n")
(try "f") (princ (format "%s %S\n" (buffer-name) (buffer-string)))
(switch-to-buffer "sub")
(show)
(goto-char (point-min)) (re-search-forward "f3$")
(try "o") (princ (format "%d %s\n" (length (window-list)) (buffer-name)))
(delete-other-windows)
(switch-to-buffer "sub")
(try "C-o") (princ (format "%d %s\n" (length (window-list)) (buffer-name)))
(delete-other-windows)
;; 前置引数の数のファイルを写す・名前を変える・消す
(goto-char (point-min)) (re-search-forward "f1$")
(try "2 C . . RET") (names)
(goto-char (point-min)) (re-search-forward "f2$")
(try "2 R d 1 RET") (names) (show)
(try "- 1 D y e s RET") (names) (show)
