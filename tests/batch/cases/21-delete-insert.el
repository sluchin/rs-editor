(with-current-buffer (generate-new-buffer "b")
  (insert "hello   world")
  (goto-char 6)
  (delete-horizontal-space)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (insert "   ")
  (just-one-space)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (delete-char 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (delete-char -1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (goto-char (point-max))
  (newline)
  (insert "x")
  (open-line 2)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (delete-blank-lines)
  (princ (format "%S\n" (buffer-string)))
  (goto-char (point-max))
  (delete-indentation)
  (princ (format "%S\n" (buffer-string)))
  (erase-buffer)
  (insert "a\n\n\n\nb")
  (goto-char 3)
  (delete-blank-lines)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (erase-buffer)
  (insert "abc")
  (goto-char 2)
  (delete-region 1 3)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (insert-char ?z 3)
  (princ (format "%S\n" (buffer-string))))
