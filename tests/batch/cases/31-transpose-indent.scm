(with-current-buffer (generate-new-buffer "b")
  (insert "line1\nline2\nline3\n")
  (goto-char 8)
  (transpose-lines 1)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (erase-buffer)
  (insert "    indented\n  less\n")
  (goto-char 1)
  (princ (format "%d\n" (current-indentation)))
  (back-to-indentation)
  (princ (format "%d\n" (point)))
  (indent-rigidly 1 (point-max) 2)
  (princ (format "%S\n" (buffer-string)))
  (indent-rigidly 1 (point-max) -4)
  (princ (format "%S\n" (buffer-string)))
  (goto-char 1)
  (indent-to 5)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (indent-line-to 3)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (indent-region 1 (point-max) 1)
  (princ (format "%S\n" (buffer-string)))
  (goto-char 1)
  (delete-trailing-whitespace)
  (princ (format "%S\n" (buffer-string))))
