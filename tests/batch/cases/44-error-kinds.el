(defun try (thunk)
  (condition-case e (progn (funcall thunk) "none") (error (format "%s" (car e)))))
(with-current-buffer (generate-new-buffer "b")
  (insert "abc")
  (princ (format "%s\n" (try (lambda () (goto-char 1) (backward-char 1)))))
  (princ (format "%s\n" (try (lambda () (goto-char 4) (forward-char 1)))))
  (princ (format "%s\n" (try (lambda () (search-forward "zzz")))))
  (princ (format "%s\n" (try (lambda () (error "boom")))))
  (princ (format "%s\n" (try (lambda () (buffer-substring 1 99)))))
  (princ (format "%s\n" (try (lambda () (/ 1 0)))))
  (princ (format "%s\n" (try (lambda () (forward-sexp 99)))))
  (princ (format "%s\n" (condition-case nil (forward-char 5) (end-of-buffer "eob"))))
  (princ (format "%s\n" (condition-case nil (search-forward "q") (search-failed "sf"))))
  (princ (format "%s\n" (condition-case nil (error "x") (end-of-buffer "eob") (error "generic"))))
  (princ (format "%s\n" (condition-case e (error "boom %d" 3) (error (error-message-string e))))))
