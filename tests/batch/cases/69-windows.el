(defun names ()
  (princ (format "%S %s\n" (mapcar (lambda (w) (buffer-name (window-buffer w))) (window-list nil nil (frame-first-window)))
                 (buffer-name (window-buffer (selected-window))))))
(defmacro try (&rest body)
  `(condition-case e (progn ,@body) (error (princ (format "%S\n" (cadr e))))))
;; windmove
(switch-to-buffer "a")
(split-window-right)
(other-window 1) (switch-to-buffer "b")
(split-window-below)
(other-window 1) (switch-to-buffer "c")
(names)
(windmove-left) (names)
(windmove-right) (names)
(windmove-down) (names)
(windmove-up) (names)
(try (windmove-up))
(try (windmove-right))
(windmove-down)
(try (windmove-down))
(windmove-left)
(windmove-right -1) (names)
(windmove-left)
(setq windmove-wrap-around t)
(windmove-left) (names)
(windmove-right) (names)
(try (windmove-down))
(windmove-right) (windmove-down) (windmove-down) (names)
(setq windmove-wrap-around nil)
(windmove-default-keybindings)
(execute-kbd-macro (kbd "S-<left> S-<right>")) (names)
;; dedicated windows
(execute-kbd-macro (kbd "C-x w d"))
(princ (format "dedicated %S\n" (window-dedicated-p)))
(execute-kbd-macro (kbd "C-x b d RET"))
(princ (format "dedicated %S\n" (window-dedicated-p)))
(names)
(execute-kbd-macro (kbd "C-u C-x w d"))
(princ (format "dedicated %S\n" (window-dedicated-p)))
(try (execute-kbd-macro (kbd "C-x b e RET")))
(names)
(execute-kbd-macro (kbd "C-x w d"))
(princ (format "dedicated %S\n" (window-dedicated-p)))
(delete-other-windows)
(set-window-dedicated-p (selected-window) t)
(display-buffer (get-buffer-create "f")) (names)
(set-window-dedicated-p (selected-window) nil)
;; the next command displays in another or the same window
(delete-other-windows)
(execute-kbd-macro (kbd "C-x 4 4 C-x b e RET")) (names)
(delete-other-windows)
(execute-kbd-macro (kbd "C-x 4 4 C-a C-x b h RET")) (names)
(execute-kbd-macro (kbd "C-x 4 1 C-x 4 b i RET")) (names)
(execute-kbd-macro (kbd "C-x 4 4 C-x 4 b j RET")) (names)
;; winner-mode
(delete-other-windows)
(winner-mode 1)
(execute-kbd-macro (kbd "C-x 2 C-c <left>")) (names)
(execute-kbd-macro (kbd "C-x 3 C-x 2 C-c <left> C-c <left> C-c <left> C-c <right>")) (names)
(try (execute-kbd-macro (kbd "C-x o C-c <right>")))
