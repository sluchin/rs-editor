(defun file-text (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))
(let* ((dir (file-name-as-directory (make-temp-file "fc" t)))
       (a (concat dir "a.txt"))
       (sub (concat dir "sub/")))
  (make-directory sub)
  (write-region "first\n" nil a)
  ;; append-to-file: リージョンをファイルの終わりに足す
  (switch-to-buffer (generate-new-buffer "x"))
  (insert "one two three")
  (append-to-file 5 8 a)
  (append-to-file "\n" nil a)
  (append-to-file nil nil a)
  (princ (format "append: %S\n" (file-text a)))
  (set-mark 1)
  (goto-char 4)
  (execute-kbd-macro (kbd (concat "M-x append-to-file RET " dir "new.txt RET")))
  (princ (format "append new: %S\n" (file-text (concat dir "new.txt"))))
  ;; rename-visited-file: ファイルの名前を変え, バッファもそれを訪れる
  (find-file a)
  (rename-visited-file (concat dir "b.txt"))
  (princ (format "rename: %s %s %s %s %S\n" (buffer-name) (file-name-nondirectory buffer-file-name)
                 (file-exists-p a) (buffer-modified-p) (file-text (concat dir "b.txt"))))
  ;; ディレクトリを指すと, その中へ同じ名前で
  (rename-visited-file sub)
  (princ (format "rename dir: %s %s %s\n" (buffer-name) (file-relative-name buffer-file-name dir)
                 (file-exists-p (concat dir "b.txt"))))
  ;; キーから
  (execute-kbd-macro (kbd (concat "M-x rename-visited-file RET C-a C-k " dir "c.txt RET")))
  (princ (format "rename key: %s %s\n" (buffer-name) (file-exists-p (concat dir "c.txt"))))
  ;; ファイルを訪れていないバッファ: 名前を付けるだけ
  (switch-to-buffer (generate-new-buffer "y"))
  (insert "y")
  (rename-visited-file (concat dir "y.txt"))
  (princ (format "no file: %s %s %s\n" (buffer-name) (file-exists-p (concat dir "y.txt")) (buffer-modified-p)))
  (condition-case err
      (progn (switch-to-buffer (generate-new-buffer "z")) (rename-visited-file sub))
    (error (princ (format "error: %s\n" (car err)))))
  (delete-directory dir t))
