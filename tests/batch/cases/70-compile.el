(defun show ()
  (with-current-buffer "*compilation*"
    (dolist (line (split-string (buffer-string) "\n"))
      (princ (concat (replace-regexp-in-string "default-directory: .*" "default-directory: DIR" (replace-regexp-in-string " at [A-Z][a-z][a-z] .*" " at TIME" line)) "\n")))))
(defun wait () (while (get-buffer-process "*compilation*") (accept-process-output nil 0.1)))
(defun pos ()
  (set-buffer (window-buffer (selected-window)))
  (princ (format "%s %d %d\n" (buffer-name) (line-number-at-pos) (current-column))))
(defmacro try (&rest body)
  `(condition-case e (progn ,@body) (error (princ (format "%S\n" (cadr e))))))
(find-file "a.txt")
(write-region "x\nyy\nzzz\n" nil "c1.c")
(write-region "1\n2\n3\n4\n" nil "c2.c")
(compile "printf 'c1.c:2:2: error: e1\\nother\\nc2.c:3: warning: w\\n  File \"c1.c\", line 3\\n'; exit 3")
(wait)
(show)
(princ (format "%S %S\n" compile-command (with-current-buffer "*compilation*" major-mode)))
(next-error) (pos)
(next-error) (pos)
(next-error) (pos)
(try (next-error))
(previous-error) (pos)
(first-error) (pos)
(next-error 2) (pos)
;; コンパイルのバッファの中で
(switch-to-buffer "*compilation*")
(goto-char (point-min))
(compilation-next-error 1) (pos)
(compilation-next-error 2) (pos)
(try (compilation-next-error 1))
(compilation-previous-error 1) (pos)
(try (compilation-previous-error 5))
(goto-char (point-min))
(compilation-next-file 1) (pos)
(compilation-next-file 1) (pos)
(compilation-previous-file 1) (pos)
(compile-goto-error) (pos)
;; recompile は, 同じコマンドを同じディレクトリで動かす
(delete-other-windows)
(switch-to-buffer "c2.c")
(recompile)
(wait)
(show)
(compile "true")
(wait)
(show)
