(with-current-buffer (generate-new-buffer "b")
  (insert "line1\nline2\nline3\n")
  (narrow-to-region 7 12)
  (princ (format "%S %d %d %d\n" (buffer-string) (point-min) (point-max) (point)))
  (goto-char (point-min))
  (princ (format "%S\n" (condition-case e (begin (backward-char 1) "ok") (error (error-message-string e)))))
  (insert "A")
  (princ (format "%S %d\n" (buffer-string) (buffer-size)))
  (princ (format "%s\n" (if (buffer-narrowed-p) "narrowed" "wide")))
  (widen)
  (princ (format "%S %s\n" (buffer-string) (if (buffer-narrowed-p) "narrowed" "wide")))
  (narrow-to-region 1 6)
  (save-restriction (widen) (insert "Z"))
  (princ (format "%S %d %d\n" (buffer-string) (point-min) (point-max)))
  (goto-char (point-max))
  (narrow-to-region 7 12)
  (princ (format "%d\n" (point))))
