(with-current-buffer (generate-new-buffer "b")
  (insert "pear\napple\nfig\napple\nbanana\n")
  (sort-lines #f 1 (point-max))
  (princ (format "%S\n" (buffer-string)))
  (sort-lines #t 1 (point-max))
  (princ (format "%S\n" (buffer-string)))
  (reverse-region 1 (point-max))
  (princ (format "%S\n" (buffer-string)))
  (goto-char 1)
  (flush-lines "an")
  (princ (format "%S\n" (buffer-string)))
  (goto-char 1)
  (keep-lines "p")
  (princ (format "%S\n" (buffer-string)))
  (goto-char 1)
  (princ (format "%d\n" (how-many "p")))
  (delete-duplicate-lines 1 (point-max))
  (princ (format "%S\n" (buffer-string))))
