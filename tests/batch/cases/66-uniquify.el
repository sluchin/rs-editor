(defun names ()
  (princ (format "%S\n" (sort (mapcar #'buffer-name (seq-filter (lambda (b) (or (buffer-file-name b) (string-prefix-p "a.txt" (buffer-name b)))) (buffer-list))) #'string<))))
(let* ((dir (file-name-as-directory (make-temp-file "un" t))))
  (dolist (d '("p/src/" "q/src/" "q/lib/" "r/x/src/" "s/"))
    (make-directory (concat dir d) t)
    (write-region "x" nil (concat dir d "a.txt")))
  ;; 開くたびに, 同じ名前のバッファをディレクトリで分ける (共通の後ろの部分は除く)
  (find-file (concat dir "p/src/a.txt")) (names)
  (find-file (concat dir "q/src/a.txt")) (names)
  (find-file (concat dir "q/lib/a.txt")) (names)
  (find-file (concat dir "r/x/src/a.txt")) (names)
  ;; 消すと, 残りの名前を付け直す
  (kill-buffer (get-file-buffer (concat dir "q/lib/a.txt"))) (names)
  (kill-buffer (get-file-buffer (concat dir "q/src/a.txt"))) (names)
  (kill-buffer (get-file-buffer (concat dir "r/x/src/a.txt"))) (names)
  ;; ファイルを訪れていないバッファの名前とは, 分けない
  (switch-to-buffer (get-buffer-create "a.txt<9>"))
  (find-file (concat dir "q/src/a.txt")) (names)
  ;; rename-buffer: UNIQUE なら付け直す. そうでなければ, 分けるのをやめる
  (with-current-buffer (get-file-buffer (concat dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "a.txt" t)))) (names)
  (with-current-buffer (get-file-buffer (concat dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "b.txt" t)))) (names)
  (with-current-buffer (get-file-buffer (concat dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "a.txt" t)))) (names)
  (with-current-buffer (get-file-buffer (concat dir "q/src/a.txt")) (rename-buffer "zz")) (names)
  (with-current-buffer "zz" (kill-buffer)) (names)
  ;; set-visited-file-name
  (find-file (concat dir "s/a.txt")) (names)
  (find-file (concat dir "q/src/a.txt")) (names)
  (with-current-buffer (get-file-buffer (concat dir "s/a.txt")) (set-visited-file-name (concat dir "s/c.txt"))) (names)
  (with-current-buffer (get-file-buffer (concat dir "s/c.txt")) (set-visited-file-name (concat dir "s/a.txt"))) (names)
  (dolist (b (buffer-list)) (when (buffer-file-name b) (with-current-buffer b (set-buffer-modified-p nil))))
  ;; 名前の形
  (dolist (style '(forward reverse post-forward))
    (setq uniquify-buffer-name-style style)
    (find-file (concat dir "r/x/src/a.txt")) (names)
    (kill-buffer (get-file-buffer (concat dir "r/x/src/a.txt"))))
  (delete-directory dir t))
