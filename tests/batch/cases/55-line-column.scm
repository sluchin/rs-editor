;; C-n / C-p は, 表示の桁 (タブと全角の文字の幅) を保つ
(define (show label)
  (princ (format "%s: %d col=%d\n" label (point) (current-column))))
(with-current-buffer (generate-new-buffer "t")
  (insert "ab\tcdef\n日本語日本語\nxxxxxxxxxxxxxxxxxx\n\tx\n")
  (goto-char 4)
  (show "start")
  (set! last-command #f)
  (next-line 1) (show "down1")
  (set! last-command 'next-line)
  (next-line 1) (show "down2")
  (next-line 1) (show "down3")
  (previous-line 1) (show "up1")
  (previous-line 1) (show "up2")
  (set! last-command #f)
  (goto-char 1)
  (forward-char 6)
  (show "ch6")
  (next-line 1) (show "ch6-down")
  (set! last-command 'next-line)
  (next-line 1) (show "ch6-down2")
  (set! last-command #f)
  (goto-char 12)
  (show "wide")
  (next-line 1) (show "wide-down")
  (set! last-command 'next-line)
  (previous-line 1) (show "wide-up"))
