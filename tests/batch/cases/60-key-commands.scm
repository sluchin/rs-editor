(define (show label)
  (princ (format "%s: %d %d %S\n" label (point) (current-column) fill-column)))
(begin (switch-to-buffer (generate-new-buffer "t"))
  (insert "abc 12 def\n\tline two #x41\nthree 0x1f\n")
  ;; M-g c: 数を読む. 前置引数があれば, それ. 点の自然数が既定の値
  (goto-char 1)
  (execute-kbd-macro (kbd "M-g c 7 RET"))
  (show "goto-char")
  (execute-kbd-macro (kbd "C-u 3 M-g c"))
  (show "goto-char prefix")
  (goto-char 6)
  (execute-kbd-macro (kbd "M-g c RET"))
  (show "goto-char default")
  (goto-char 1)
  (execute-kbd-macro (kbd "M-g c M-n RET"))
  (show "goto-char M-n")
  ;; M-g TAB: 桁へ
  (goto-char 12)
  (execute-kbd-macro (kbd "M-g TAB 10 RET"))
  (show "move-to-column")
  (execute-kbd-macro (kbd "C-u 3 M-g TAB"))
  (show "move-to-column prefix")
  ;; C-x f: 桁を読む. C-u は今の桁
  (execute-kbd-macro (kbd "C-x f 40 RET"))
  (show "set-fill-column")
  (execute-kbd-macro (kbd "C-u C-x f"))
  (show "set-fill-column C-u")
  (execute-kbd-macro (kbd "C-u 66 C-x f"))
  (show "set-fill-column 66")
  (execute-kbd-macro (kbd "C-x f RET"))
  (show "set-fill-column default")
  ;; C-x 8 RET: 16 進と #x, #o, #10r
  (goto-char (point-max))
  (execute-kbd-macro (kbd "C-x 8 RET 3042 RET C-x 8 RET #x41 RET C-x 8 RET #o102 RET C-u 2 C-x 8 RET #10r67 RET"))
  (show "insert-char")
  (princ (format "%S\n" (buffer-substring (line-beginning-position) (point))))
  ;; C-x n g
  (goto-char 1)
  (execute-kbd-macro (kbd "C-x n g 3 RET"))
  (show "goto-line-relative")
  ;; C-x x t
  (execute-kbd-macro (kbd "C-x x t"))
  (princ (format "truncate-lines: %s\n" (if truncate-lines "t" "nil")))
  ;; C-?: undo-redo
  (goto-char (point-max))
  (undo-boundary)
  (insert "X")
  (undo-boundary)
  (execute-kbd-macro (kbd "C-/"))
  (princ (format "%S\n" (buffer-substring (line-beginning-position) (point-max))))
  (execute-kbd-macro (kbd "C-?"))
  (princ (format "%S\n" (buffer-substring (line-beginning-position) (point-max)))))
