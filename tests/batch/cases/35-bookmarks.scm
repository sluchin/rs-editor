(set! bookmark-default-file "bm-file")
(set! bookmark-save-flag #f)
(find-file "multi.txt")
(goto-char (point-min))
(forward-line 1)
(forward-char 2)
(bookmark-set "second")
(goto-char (point-min))
(bookmark-jump "second")
(princ (format "%s %d %d\n" (file-name-nondirectory (buffer-file-name)) (point) (line-number-at-pos)))
(goto-char (point-max))
(bookmark-set "end")
(set-buffer (generate-new-buffer "other"))
(bookmark-jump "end")
(princ (format "%s %d\n" (buffer-name) (point)))
(princ (format "%S\n" (condition-case e (bookmark-jump "missing") (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (bookmark-set-no-overwrite "end") (error (error-message-string e)))))
