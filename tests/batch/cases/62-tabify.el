(defun show (label)
  (princ (format "%s: %d %S\n" label (point) (buffer-substring-no-properties (point-min) (point-max)))))
(progn (switch-to-buffer (generate-new-buffer "t"))
  (setq indent-tabs-mode t)
  (insert "\tone\t two\n  \t three  x\nfour        five\n\t\t six    seven\n")
  ;; untabify: リージョン. 点の桁を保つ
  (goto-char 1)
  (set-mark (point-max))
  (goto-char 22)
  (untabify (point-min) (point-max))
  (show "untabify")
  ;; tabify: 空白をタブに
  (goto-char 1)
  (tabify (point-min) (point-max))
  (show "tabify")
  ;; 行の途中から
  (erase-buffer)
  (insert "a       b       c\n        d\n")
  (tabify 5 (point-max))
  (show "tabify part")
  (untabify 3 12)
  (show "untabify part")
  ;; キーから: リージョン, 前置引数でバッファ全体
  (erase-buffer)
  (insert "x\ty\n\tz\n")
  (goto-char 1)
  (push-mark 4 t t)
  (execute-kbd-macro (kbd "M-x untabify RET"))
  (show "M-x untabify")
  (execute-kbd-macro (kbd "C-u M-x untabify RET"))
  (show "C-u M-x untabify")
  (execute-kbd-macro (kbd "C-u M-x tabify RET"))
  (show "C-u M-x tabify")
  ;; backward-delete-char-untabify: タブを空白に崩して消す
  (erase-buffer)
  (insert "a\tb\t\tc")
  (goto-char 3)
  (backward-delete-char-untabify 1)
  (show "untabify 1")
  (goto-char (+ (point) 2))
  (backward-delete-char-untabify 3)
  (show "untabify 3")
  (goto-char (point-max))
  (backward-char 1)
  (execute-kbd-macro (kbd "C-u 2 M-x backward-delete-char-untabify RET"))
  (show "untabify kill")
  (princ (format "%S\n" (current-kill 0 t)))
  (setq backward-delete-char-untabify-method 'hungry)
  (erase-buffer)
  (insert "x  \t  y")
  (goto-char 7)
  (backward-delete-char-untabify 1)
  (show "hungry")
  (setq backward-delete-char-untabify-method 'all)
  (erase-buffer)
  (insert "x \n\t y")
  (goto-char 6)
  (backward-delete-char-untabify 1)
  (show "all"))
