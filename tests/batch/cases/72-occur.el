(defun pos ()
  (set-buffer (window-buffer (selected-window)))
  (princ (format "%s %d %d\n" (buffer-name) (line-number-at-pos) (current-column))))
(defmacro try (&rest body)
  `(condition-case e (progn ,@body) (error (princ (format "%S\n" (cadr e))))))
(defun show () (princ (if (get-buffer "*Occur*") (with-current-buffer "*Occur*" (buffer-string)) "none\n")) (princ "|\n"))
(write-region "foo 1\nbar\nfoo 2 foo\n" nil "o1.txt")
(write-region "xfoo\nnone\nfo\no\n" nil "o2.txt")
(find-file "o2.txt")
(find-file "o1.txt")
;; occur の結果を next-error でたどる
(occur "foo")
(show)
(next-error) (pos)
(next-error) (pos)
(try (next-error))
(previous-error) (pos)
(try (previous-error))
(first-error) (pos)
(next-error 2) (pos)
(next-error -1) (pos)
;; *Occur* の中で
(switch-to-buffer "*Occur*")
(goto-char (point-min))
(next-error-no-select) (pos)
(next-error-no-select) (pos)
(previous-error-no-select) (pos)
;; multi-occur は, 後のバッファを先に出す
(delete-other-windows)
(switch-to-buffer "o1.txt")
(multi-occur (list (get-buffer "o1.txt") (get-buffer "o2.txt")) "foo")
(show)
(next-error) (pos) (next-error) (pos) (next-error) (pos)
(try (next-error))
(multi-occur (list (get-buffer "o1.txt") (get-buffer "o2.txt")) "o\nx\\|o$" 1)
(show)
(multi-occur-in-matching-buffers "2\\.txt\\'" "x")
(show)
(multi-occur-in-matching-buffers "^o" "bar" t)
(show)
;; 一致が無ければ, *Occur* を消す
(multi-occur (list (get-buffer "o1.txt") (get-buffer "o2.txt")) "zzz")
(show)
(try (occur ""))
