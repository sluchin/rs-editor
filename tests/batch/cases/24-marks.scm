(with-current-buffer (generate-new-buffer "b")
  (insert "0123456789")
  (set-mark 3)
  (goto-char 7)
  (princ (format "%d %d %d\n" (mark) (region-beginning) (region-end)))
  (exchange-point-and-mark)
  (princ (format "%d %d\n" (point) (mark)))
  (push-mark 5 #t)
  (princ (format "%d\n" (mark)))
  (pop-mark)
  (princ (format "%d\n" (mark)))
  (mark-whole-buffer)
  (princ (format "%d %d %d\n" (point) (mark) (region-end)))
  (goto-char 1)
  (mark-word)
  (princ (format "%d %d\n" (point) (mark)))
  (kill-ring-save 2 5)
  (princ (format "%S\n" (current-kill 0)))
  (let ((m (copy-marker 4)))
    (goto-char 1)
    (insert "XX")
    (princ (format "%d\n" (marker-position m)))
    (set-marker m 1)
    (princ (format "%d\n" (marker-position m)))))
