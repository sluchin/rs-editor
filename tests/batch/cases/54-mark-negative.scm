(define (show label)
  (princ (format "%s: %d %S\n" label (point) (mark))))
(with-current-buffer (generate-new-buffer "t")
  (scheme-mode)
  (insert "foo bar baz (a b) qux")
  (goto-char 12)
  (mark-word -1)
  (show "mark-word -1")
  (goto-char 12)
  (set-mark #f)
  (mark-word 2)
  (show "mark-word 2")
  (goto-char 22)
  (mark-sexp -1)
  (show "mark-sexp -1")
  (goto-char 12)
  (mark-sexp 1)
  (show "mark-sexp 1")
  (goto-char 19)
  (mark-sexp -2)
  (show "mark-sexp -2")
  (erase-buffer)
  (insert "(defun a ()\n  1)\n\n(defun b ()\n  2)\n\n(defun c ()\n  3)\n")
  (goto-char 30)
  (set-mark #f)
  (mark-defun -1)
  (show "mark-defun -1")
  (goto-char 30)
  (set-mark #f)
  (mark-defun 2)
  (show "mark-defun 2"))
