;; エラーの種類とデータ (signal, define-error, user-error) と, condition-case が受ける条件 (error-conditions)
(define-error 'my-problem "My problem")
(define-error 'my-sub "My sub" 'my-problem)
(define-error 'my-multi "My multi" '(my-problem file-error))
(princ (format "%S\n" (condition-case e (error "End of buffer") (end-of-buffer 'eob) (error (car e)))))
(princ (format "%S\n" (condition-case e (error "Quit") (quit 'q) (error (car e)))))
(princ (format "%S\n" (condition-case e (error "Search failed: x") (search-failed 'sf) (error (car e)))))
(princ (format "%S\n" (condition-case e (error "Args out of range: 1") (args-out-of-range 'ar) (error (cdr e)))))
(princ (format "%S\n" (condition-case e (signal 'my-kind '(1 "two" three)) (t e))))
(princ (format "%S\n" (condition-case e (signal 'end-of-buffer nil) (error e))))
(princ (format "%S\n" (condition-case e (signal 'args-out-of-range '(1 2)) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'wrong-type-argument '(listp 1)) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'file-missing '("Opening input file" "No such file or directory" "/x")) (file-error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'file-already-exists '("File exists" "/x")) (file-error (cdr e)))))
(princ (format "%S\n" (condition-case e (signal 'quit nil) (quit (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'text-read-only '("x")) (buffer-read-only (car e)))))
(princ (format "%S\n" (condition-case e (signal 'scan-error '("Unbalanced parentheses" 1 5)) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'invalid-regexp '("Unmatched [")) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'end-of-file '("Error reading from stdin")) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (user-error "Oops %d" 3) (user-error e))))
(princ (format "%S\n" (condition-case e (user-error "Oops %d" 3) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (error "plain") (user-error 'user) (error 'err))))
(princ (format "%S\n" (condition-case e (signal 'quit nil) (error 'err) (t 'tee))))
(princ (format "%S\n" (condition-case e (signal 'quit nil) ((error quit) 'either))))
(princ (format "%S\n" (condition-case e (signal 'whatever '(1)) (t e))))
(princ (format "%S\n" (condition-case e (signal 'whatever '(1)) (error 'err) (t 'tee))))
(princ (format "%S\n" (condition-case e (condition-case e (/ 1 0) (error (signal (car e) (cdr e)))) (arith-error 'again))))
(princ (format "%S\n" (condition-case e (condition-case e (/ 1 0) (error (signal nil e))) (arith-error 'again2))))
(princ (format "%S\n" (condition-case e (signal 'my-problem '(1 "x")) (error (error-message-string e)))))
(princ (format "%S\n" (condition-case e (signal 'my-sub nil) (my-problem 'parent))))
(princ (format "%S\n" (condition-case e (signal 'my-sub nil) (error 'any))))
(princ (format "%S\n" (condition-case e (signal 'my-multi '("f")) (file-error 'file))))
(princ (format "%S\n" (condition-case e (signal 'my-problem nil) (my-sub 'sub) (my-problem 'problem))))
(princ (format "%S\n" (error-message-string '(error))))
(princ (format "%S\n" (error-message-string '(error 5))))
(princ (format "%S\n" (error-message-string '(foo-bar 1 "x"))))
(princ (format "%S\n" (error-message-string '(quit 1))))
(princ (format "%S\n" (error-message-string '(user-error "a" "b"))))
(princ (format "%S\n" (error-message-string '(void-variable foo))))
(princ (format "%S\n" (error-message-string '(user-error))))
(princ (format "%S\n" (error-message-string '(user-error 5))))
