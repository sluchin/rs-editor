(with-current-buffer (generate-new-buffer "t")
  (insert "hello world\n")
  (write-region nil nil "all.txt")
  (write-region 1 6 "part.txt")
  (write-region "str\n" nil "str.txt")
  (write-region "1\n" nil "app.txt")
  (write-region "2\n" nil "app.txt" t)
