(with-current-buffer (find-file-noselect "a.txt")
  (insert "x")
  (write-file "b.txt")
  (princ (format "%s|%s|%s\n" (buffer-name) (file-name-nondirectory (buffer-file-name)) (if (buffer-modified-p) "modified" "clean"))))
(with-current-buffer (generate-new-buffer "scratch")
  (insert "y")
  (set-visited-file-name "c.txt")
  (princ (format "%s|%s|%s\n" (buffer-name) (file-name-nondirectory (buffer-file-name)) (if (buffer-modified-p) "modified" "clean")))
  (basic-save-buffer))
