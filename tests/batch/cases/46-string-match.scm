(princ (format "%S %S\n" (match-beginning 0) (match-end 0)))
(princ (format "%S\n" (match-string 0 "aabbbcc")))
(princ (format "%S\n" (string-match "\\(a\\)\\(c\\)" "zzacc")))
(princ (format "%S\n" (match-data)))
(princ (format "%S %S\n" (match-string 1 "zzacc") (match-string 2 "zzacc")))
(princ (format "%S\n" (string-match "z" "zz" 1)))
(princ (format "%S\n" (if (string-match "q" "zz") 1 2)))
(princ (format "%S\n" (string-match-p "a" "bab")))
(princ (format "%S\n" (match-data)))
(set! case-fold-search #f)
(princ (format "%S\n" (if (string-match "A" "a") 1 2)))
(set! case-fold-search #t)
(princ (format "%S\n" (string-match "A" "a")))
(princ (format "%S\n" (string-match "é+" "caféé")))
(princ (format "%S\n" (condition-case e (string-match "a" "b" 5) (error (car e)))))
;; 負の始め: 文字列の終わりから数える
(princ (format "%S\n" (string-match "b" "abab" -2)))
(princ (format "%S\n" (condition-case e (string-match "a" "abc" -9) (args-out-of-range e))))
;; 合った所は全体で 1 つ: バッファを替えても残り, 一番新しいものが使われる
(with-current-buffer (generate-new-buffer "m1")
  (insert "abc")
  (goto-char 1)
  (search-forward "b"))
(with-current-buffer (generate-new-buffer "m2")
