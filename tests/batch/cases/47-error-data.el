(defun try (thunk)
  (condition-case e (progn (funcall thunk) "none") (error (format "%S" e))))
(with-current-buffer (generate-new-buffer "b")
  (insert "abc")
  (princ (format "%s\n" (try (lambda () (error "boom %d" 3)))))
  (princ (format "%s\n" (try (lambda () (goto-char 1) (backward-char 1)))))
  (princ (format "%s\n" (try (lambda () (goto-char 4) (forward-char 1)))))
  (princ (format "%s\n" (try (lambda () (search-forward "zzz")))))
  (princ (format "%s\n" (try (lambda () (/ 1 0)))))
  (princ (format "%s\n" (try (lambda () undefined-var))))
  (princ (format "%s\n" (try (lambda () (undefined-fn 1)))))
  (princ (format "%S\n" (condition-case e (search-forward "q") (search-failed (cdr e)))))
  (princ (format "%S\n" (condition-case e (error "x") (error (error-message-string e))))))
(princ (format "%S\n" (condition-case e (insert-file-contents "nonexist") (file-missing (list (car e) (cadr e) (caddr e))))))
(princ (format "%S\n" (condition-case e (insert-file-contents "nonexist") (file-missing (error-message-string e)))))
(princ (format "%S\n" (condition-case e (load "nonexist-zz") (file-missing (cdr e)))))
(princ (format "%S\n" (condition-case e (load "nonexist-zz") (file-missing (error-message-string e)))))
(defun wt (f) (condition-case e (funcall f) (wrong-type-argument (format "%S" e))))
(princ (format "%s\n" (wt (lambda () (+ 1 "a")))))
(princ (format "%s\n" (wt (lambda () (* 2 'a)))))
(princ (format "%s\n" (wt (lambda () (abs "a")))))
(princ (format "%s\n" (wt (lambda () (car 1)))))
(princ (format "%s\n" (wt (lambda () (length 1)))))
(princ (format "%s\n" (wt (lambda () (member 1 2)))))
(princ (format "%s\n" (wt (lambda () (string-width 1)))))
(princ (format "%s\n" (wt (lambda () (goto-char "a")))))
(princ (format "%s\n" (wt (lambda () (kill-buffer 1)))))
(princ (format "%s\n" (condition-case e (+ 1 "a") (error (error-message-string e)))))
