(with-current-buffer (generate-new-buffer "b")
  (insert "foo bar foo baz")
  (goto-char 1)
  (re-search-forward "b\\(a\\)r")
  (princ (format "%d %d %d %d\n" (match-beginning 0) (match-end 0) (match-beginning 1) (match-end 1)))
  (princ (format "%s %s\n" (match-string 0) (match-string 1)))
  (replace-match "X")
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (princ (format "%s\n" (if (looking-at "foo") "yes" "no")))
  (princ (format "%s\n" (if (looking-at "bar") "yes" "no")))
  (goto-char 1)
  (while (search-forward "foo" #f #t) (replace-match "Q"))
  (princ (format "%s\n" (buffer-string)))
  (goto-char 1)
  (princ (format "%s\n" (if (looking-back "x" 1) "yes" "no")))
  (replace-string "Q" "zz" #f 1 (point-max))
  (princ (format "%s\n" (buffer-string)))
  (goto-char 1)
  (replace-regexp "z+" "[&]")
  (princ (format "%s\n" (buffer-string)))
  (princ (format "%s\n" (replace-regexp-in-string "o+" "0" "foo boo")))
  (princ (format "%s\n" (regexp-quote "a.b*c"))))
