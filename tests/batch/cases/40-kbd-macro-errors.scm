(begin (switch-to-buffer (generate-new-buffer "b"))
  (insert "one\ntwo\n")
  (goto-char 1)
  (princ (format "%S\n" (condition-case e (execute-kbd-macro (kbd "C-n C-n C-n C-n x")) (error (error-message-string e)))))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (princ (format "%S\n" (condition-case e (execute-kbd-macro (kbd "C-f x") 0) (error (error-message-string e)))))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (execute-kbd-macro "")
  (execute-kbd-macro (kbd "") 3)
  (princ (format "%S|%d\n" (buffer-string) (point))))
