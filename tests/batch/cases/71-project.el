(require 'project)
(defun names (title)
  (princ (format "%s %S\n" title (sort (seq-filter (lambda (b) (string-match-p "\\.txt\\|^pj\\|^src\\|^lib" b))
                                                    (mapcar #'buffer-name (buffer-list)))
                                        #'string<))))
(make-directory "pj/src" t)
(make-directory "pj/lib" t)
(write-region "hello\nfoo bar\n" nil "pj/src/a.txt")
(write-region "foo\n" nil "pj/lib/b.txt")
(write-region "foo\n" nil "pj/ignored.txt")
(write-region "ignored.txt\n" nil "pj/.gitignore")
(call-process-shell-command "cd pj && git init -q")
(find-file "pj/src/a.txt")
(princ (format "%S\n" (project-name (project-current))))
(princ (format "%S\n" (sort (mapcar (lambda (f) (file-relative-name f (project-root (project-current))))
                                    (project-files (project-current)))
                            #'string<)))
;; C-x p f: プロジェクトのファイルを開く
(execute-kbd-macro (kbd "C-x p f l i b / b . t x t RET"))
(princ (format "%s\n" (buffer-name)))
;; C-x p b: プロジェクトのバッファへ
(execute-kbd-macro (kbd "C-x p b a . t x t RET"))
(princ (format "%s\n" (buffer-name)))
;; C-x p D, C-x p d: dired
(execute-kbd-macro (kbd "C-x p D"))
(princ (format "%s\n" (buffer-name)))
(execute-kbd-macro (kbd "C-x p d l i b / RET"))
(princ (format "%s\n" (buffer-name)))
(names "buffers")
;; C-x p !: 根で動かす
(execute-kbd-macro (kbd "C-x p ! p w d RET"))
(princ (with-current-buffer "*Shell Command Output*" (buffer-string)))
;; C-x p g: 探して, next-error でたどる
(switch-to-buffer "a.txt")
(execute-kbd-macro (kbd "C-x p g f o o RET"))
(delete-other-windows)
(next-error)
(set-buffer (window-buffer (selected-window)))
(princ (format "%s %d\n" (buffer-name) (line-number-at-pos)))
(next-error)
(set-buffer (window-buffer (selected-window)))
(princ (format "%s %d\n" (buffer-name) (line-number-at-pos)))
;; C-x p c: 根でコンパイル
(execute-kbd-macro (kbd "C-x p c DEL DEL DEL DEL DEL DEL DEL DEL p w d RET"))
(while (get-buffer-process "*compilation*") (accept-process-output nil 0.1))
(princ (format "%s\n" (with-current-buffer "*compilation*" (goto-char (point-min)) (forward-line 4)
                        (buffer-substring (point) (line-end-position)))))
;; C-x p k: プロジェクトのバッファを消す
(delete-other-windows)
(execute-kbd-macro (kbd "C-x p k y e s RET"))
(names "killed")
(call-process-shell-command "rm -rf pj")
