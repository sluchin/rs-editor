(setq Buffer-menu-use-header-line nil)
(defun show (label)
  (let ((here (buffer-substring-no-properties (line-beginning-position) (line-end-position))))
    (princ (format "%s: %s\n" label (if (> (length here) 4) (car (split-string (substring here 4))) ""))))
  (save-excursion
    (goto-char (point-min))
    (while (not (eobp))
      (let ((line (buffer-substring-no-properties (point) (line-end-position))))
        (when (or (= (line-number-at-pos) 1) (string-match " \\(aa\\|bb\\|cc\\|dd\\|ff.txt\\) " line))
          (princ (format "  %s\n" (substring line 0 (min 10 (length line)))))))
      (forward-line 1))))
(defun to (name)
  (goto-char (point-min))
  (re-search-forward (concat "^...." (regexp-quote name) " "))
  (beginning-of-line))
(let* ((dir (file-name-as-directory (make-temp-file "bm" t)))
       (file (concat dir "ff.txt")))
  (write-region "old" nil file)
  (with-current-buffer (find-file-noselect file) (insert "new "))
  (dolist (name '("aa" "bb" "cc" "dd"))
    (with-current-buffer (get-buffer-create name) (insert name)))
  (with-current-buffer "bb" (setq buffer-read-only t))
  (list-buffers)
  (set-buffer "*Buffer List*")
  (switch-to-buffer "*Buffer List*")
  (show "list")
  ;; d, k, C-d: 消す印. s: 保存の印
  (to "aa") (execute-kbd-macro (kbd "d")) (show "d")
  (to "cc") (execute-kbd-macro (kbd "C-d")) (show "C-d")
  (to "ff.txt") (execute-kbd-macro (kbd "s")) (show "s")
  (to "dd") (execute-kbd-macro (kbd "C-u 2 k")) (show "C-u 2 k")
  ;; u, DEL, U: 印を消す
  (to "dd") (execute-kbd-macro (kbd "u")) (show "u")
  (to "dd") (execute-kbd-macro (kbd "DEL")) (show "DEL")
  (execute-kbd-macro (kbd "U")) (show "U")
  ;; ~, %
  (to "aa") (execute-kbd-macro (kbd "~")) (show "~")
  (princ (format "aa modified: %s\n" (buffer-modified-p (get-buffer "aa"))))
  (execute-kbd-macro (kbd "C-u ~")) (show "C-u ~")
  (to "bb") (execute-kbd-macro (kbd "%")) (show "%")
  (princ (format "bb read-only: %s\n" (with-current-buffer "bb" buffer-read-only)))
  ;; x: 保存して, 消す
  (to "aa") (execute-kbd-macro (kbd "C-u ~"))
  (to "cc") (execute-kbd-macro (kbd "d d"))
  (to "ff.txt") (execute-kbd-macro (kbd "s"))
  (execute-kbd-macro (kbd "x")) (show "x")
  (princ (format "killed: %s %s, saved: %S\n" (get-buffer "cc") (get-buffer "dd")
                 (with-temp-buffer (insert-file-contents file) (buffer-string))))
  (with-current-buffer "aa" (set-buffer-modified-p nil))
  (delete-directory dir t))
