(with-current-buffer (generate-new-buffer "b")
  (insert "(a (b c) \"d e\" f) g")
  (goto-char 1)
  (forward-sexp)
  (princ (format "%d\n" (point)))
  (goto-char 2)
  (forward-sexp 2)
  (princ (format "%d\n" (point)))
  (backward-sexp)
  (princ (format "%d\n" (point)))
  (goto-char 5)
  (up-list)
  (princ (format "%d\n" (point)))
  (goto-char 1)
  (down-list)
  (princ (format "%d\n" (point)))
  (goto-char 5)
  (backward-up-list)
  (princ (format "%d\n" (point)))
  (goto-char 1)
  (kill-sexp)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (erase-buffer)
  (insert "x (y) z")
  (goto-char 1)
  (transpose-sexps 1)
  (princ (format "%S\n" (buffer-string)))
  (princ (format "%S\n" (condition-case e (begin (goto-char 1) (forward-sexp 5) "no-error") (error (error-message-string e))))))
