(defun show (label)
  (princ (format "%s: %S %d\n" label (buffer-string) (point))))
(with-current-buffer (generate-new-buffer "t")
  (insert "foo     bar")
  (goto-char 6)
  (just-one-space 3)
  (show "just-one-space 3")
  (erase-buffer)
  (insert "foo \n\n  bar")
  (goto-char 5)
  (just-one-space -2)
  (show "just-one-space -2")
  (erase-buffer)
  (insert "foo    bar")
  (goto-char 6)
  (just-one-space 0)
  (show "just-one-space 0")
  (erase-buffer)
  (insert "foo    bar")
  (goto-char 6)
  (delete-horizontal-space t)
  (show "delete-horizontal-space t")
  (erase-buffer)
  (insert "a\n   b\nc")
  (goto-char 6)
  (delete-indentation t)
  (show "delete-indentation t")
  (erase-buffer)
  (insert "a\n   b\n  c\nd")
  (delete-indentation nil 1 10)
  (show "delete-indentation region")
  (erase-buffer)
  (insert "a\n   b\n  c\nd")
  (delete-indentation t 1 10)
  (show "delete-indentation t region"))
