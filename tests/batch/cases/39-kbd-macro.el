(progn (switch-to-buffer (generate-new-buffer "b"))
  (insert "one\ntwo\nthree\n")
  (goto-char 1)
  (execute-kbd-macro (kbd "C-e ! C-n C-a"))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (execute-kbd-macro (kbd "C-e ? C-n C-a") 2)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (execute-kbd-macro (kbd "abc DEL x SPC y RET"))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (execute-kbd-macro (kbd "M-f M-d"))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (execute-kbd-macro (kbd "C-SPC C-n C-w"))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (execute-kbd-macro (kbd "C-y"))
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (setq last-command nil)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-x ( Z C-x )"))
  (princ (format "%S %s\n" (buffer-string) (if last-kbd-macro 1 0)))
  (setq last-kbd-macro nil)
  (princ (format "%s\n" (if last-kbd-macro 1 0))))
