(define (names)
  (princ (format "%S\n" (sort (map (lambda (b) b) (filter (lambda (b) (or (buffer-file-name b) (string-prefix? "a.txt" b))) (buffer-list))) string<?))))
(let* ((dir (string-append (make-temp-file "un" #t) "/")))
  (for-each (lambda (d) (make-directory (string-append dir d))) '("p/" "q/" "r/" "r/x/"))
  (for-each (lambda (d)
              (make-directory (string-append dir d))
              (write-file-string (string-append dir d "a.txt") "x"))
            '("p/src/" "q/src/" "q/lib/" "r/x/src/" "s/"))
  ;; 開くたびに, 同じ名前のバッファをディレクトリで分ける (共通の後ろの部分は除く)
  (find-file (string-append dir "p/src/a.txt")) (names)
  (find-file (string-append dir "q/src/a.txt")) (names)
  (find-file (string-append dir "q/lib/a.txt")) (names)
  (find-file (string-append dir "r/x/src/a.txt")) (names)
  ;; 消すと, 残りの名前を付け直す
  (kill-buffer (find-buffer-visiting (string-append dir "q/lib/a.txt"))) (names)
  (kill-buffer (find-buffer-visiting (string-append dir "q/src/a.txt"))) (names)
  (kill-buffer (find-buffer-visiting (string-append dir "r/x/src/a.txt"))) (names)
  ;; ファイルを訪れていないバッファの名前とは, 分けない
  (switch-to-buffer (get-buffer-create "a.txt<9>"))
  (find-file (string-append dir "q/src/a.txt")) (names)
  ;; rename-buffer: UNIQUE なら付け直す. そうでなければ, 分けるのをやめる
  (with-current-buffer (find-buffer-visiting (string-append dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "a.txt" #t)))) (names)
  (with-current-buffer (find-buffer-visiting (string-append dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "b.txt" #t)))) (names)
  (with-current-buffer (find-buffer-visiting (string-append dir "q/src/a.txt")) (princ (format "%s " (rename-buffer "a.txt" #t)))) (names)
  (with-current-buffer (find-buffer-visiting (string-append dir "q/src/a.txt")) (rename-buffer "zz")) (names)
  (kill-buffer "zz") (names)
  ;; set-visited-file-name
  (find-file (string-append dir "s/a.txt")) (names)
  (find-file (string-append dir "q/src/a.txt")) (names)
  (with-current-buffer (find-buffer-visiting (string-append dir "s/a.txt")) (set-visited-file-name (string-append dir "s/c.txt"))) (names)
  (with-current-buffer (find-buffer-visiting (string-append dir "s/c.txt")) (set-visited-file-name (string-append dir "s/a.txt"))) (names)
  (for-each (lambda (b) (when (buffer-file-name b) (with-current-buffer b (set-buffer-modified-p #f)))) (buffer-list))
  ;; 名前の形
  (for-each (lambda (style)
    (set! uniquify-buffer-name-style style)
    (find-file (string-append dir "r/x/src/a.txt")) (names)
    (kill-buffer (find-buffer-visiting (string-append dir "r/x/src/a.txt"))))
    '(forward reverse post-forward))
  (delete-directory dir #t))
