(with-current-buffer (generate-new-buffer "b")
  (insert "hello big World foo")
  (upcase-region 1 6)
  (princ (format "%s\n" (buffer-string)))
  (downcase-region 1 3)
  (princ (format "%s\n" (buffer-string)))
  (capitalize-region 1 20)
  (princ (format "%s\n" (buffer-string)))
  (goto-char 1)
  (upcase-word 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (capitalize-word 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (downcase-word 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (goto-char (point-max))
  (backward-kill-word 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (goto-char 1)
  (kill-word 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (transpose-words 1)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (goto-char 2)
  (transpose-chars 1)
  (princ (format "%s|%d\n" (buffer-string) (point))))
