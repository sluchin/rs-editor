(with-current-buffer (generate-new-buffer "b")
  (insert "abcdef")
  (copy-to-register ?a 2 4)
  (goto-char (point-max))
  (insert-register ?a)
  (princ (format "%S|%d\n" (buffer-string) (point)))
  (point-to-register ?p)
  (goto-char 1)
  (jump-to-register ?p)
  (princ (format "%d\n" (point)))
  (number-to-register 5 ?n)
  (increment-register 3 ?n)
  (insert-register ?n)
  (princ (format "%S\n" (buffer-string)))
  (princ (format "%S\n" (get-register ?a)))
  (append-to-register ?a 1 2)
  (princ (format "%S\n" (get-register ?a)))
