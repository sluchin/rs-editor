(with-current-buffer (generate-new-buffer "t")
  (insert "foo bar foo baz")
  (goto-char 1)
  (princ (format "%d %d\n" (search-forward "foo") (point)))
  (princ (format "%d\n" (search-forward "foo")))
  (princ (format "%s\n" (if (search-forward "foo" #f #t) "found" "none")))
  (princ (format "%d\n" (point)))
  (goto-char 1)
  (princ (format "%d\n" (re-search-forward "ba[rz]")))
  (goto-char (point-max))
  (princ (format "%d\n" (search-backward "foo")))
  (princ (format "%s\n" (condition-case e (search-forward "zzz") (error (error-message-string e))))))
