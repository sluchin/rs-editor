(defvar root (expand-file-name "sub"))
(defun names ()
  (save-excursion
  (goto-char (point-min))
  (forward-line 1)
  (let ((items (list)))
    (while (not (eobp))
      (let ((mark (buffer-substring (line-beginning-position) (+ (line-beginning-position) 1))))
        (end-of-line)
        (skip-chars-backward "^ ")
        (setq items (cons (concat mark (buffer-substring (point) (line-end-position))) items)))
      (forward-line 1))
    (princ (format "%s|%s\n" (mapconcat (lambda (x) x) (sort items (lambda (a b) (string< a b))) " ") (mapconcat (lambda (x) x) (directory-files root) ","))))))
(write-region "a" nil "sub/f1")
(write-region "b" nil "sub/f2")
(write-region "c" nil "sub/f3")
(switch-to-buffer (dired-noselect "sub"))
(names)
(execute-kbd-macro (kbd "n n"))
(names)
(princ (format "%s\n" (buffer-substring (line-beginning-position) (+ (line-beginning-position) 2))))
(execute-kbd-macro (kbd "d"))
(names)
(execute-kbd-macro (kbd "m p u"))
(names)
(execute-kbd-macro (kbd "p d U"))
(names)
(goto-char (point-min))
(re-search-forward "f1$")
(execute-kbd-macro (kbd "d"))
(execute-kbd-macro (kbd "x y e s RET"))
(names)
(execute-kbd-macro (kbd "+ n e w RET"))
(names)
(goto-char (point-min))
(re-search-forward "f2$")
(execute-kbd-macro (kbd "C f 4 RET"))
(names)
(goto-char (point-min))
(re-search-forward "f3$")
(execute-kbd-macro (kbd "R f 5 RET"))
(names)
(goto-char (point-min))
(re-search-forward "f4$")
(execute-kbd-macro (kbd "D y e s RET"))
(names)
(princ (format "%s\n" (buffer-name)))
