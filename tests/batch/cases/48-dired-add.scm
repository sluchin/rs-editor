(define (names )
  (save-excursion
    (goto-char (point-min))
    (forward-line 1)
    (let ((items (list)))
      (while (not (eobp))
        (end-of-line)
        (skip-chars-backward "^ ")
        (set! items (cons (buffer-substring (point) (line-end-position)) items))
        (forward-line 1))
      (princ (format "%s\n" (mapconcat (lambda (x) x) (reverse items) " "))))))
(write-region "a" #f "sub/f1")
(write-region "b" #f "sub/f2")
(write-region "c" #f "sub/f3")
(switch-to-buffer (dired-noselect "sub"))
(goto-char (point-min))
(re-search-forward "f3$")
(execute-kbd-macro (kbd "C g 1 RET"))
(names)
(goto-char (point-min))
(re-search-forward "f1$")
(execute-kbd-macro (kbd "C a 0 RET"))
(names)
(goto-char (point-min))
(re-search-forward "f2$")
(execute-kbd-macro (kbd "R z 9 RET"))
(names)
(execute-kbd-macro (kbd "+ n e w RET"))
(names)
(goto-char (point-min))
(re-search-forward "f3$")
(execute-kbd-macro (kbd "+ x x RET"))
(names)
