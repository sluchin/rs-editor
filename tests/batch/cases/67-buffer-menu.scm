(define (show label)
  (let ((here (buffer-substring (line-beginning-position) (line-end-position))))
    (princ (format "%s: %s\n" label (if (> (string-length here) 4) (car (split-string (substring here 4))) ""))))
  (save-excursion
    (goto-char (point-min))
    (let loop ()
      (unless (eobp)
        (let ((line (buffer-substring (point) (line-end-position))))
          (when (or (= (line-number-at-pos) 1) (string-match " \\(aa\\|bb\\|cc\\|dd\\|ff.txt\\) " line))
            (princ (format "  %s\n" (substring line 0 (min 10 (string-length line)))))))
        (forward-line 1)
        (loop)))))
(define (to name)
  (goto-char (point-min))
  (re-search-forward (string-append "^...." (regexp-quote name) " "))
  (beginning-of-line))
(let* ((dir (string-append (make-temp-file "bm" #t) "/"))
       (file (string-append dir "ff.txt")))
  (write-file-string file "old")
  (with-current-buffer (find-file-noselect file) (insert "new "))
  (for-each (lambda (name) (with-current-buffer (get-buffer-create name) (insert name)))
            '("aa" "bb" "cc" "dd"))
  (with-current-buffer "bb" (set-buffer-read-only #t))
  (list-buffers)
  (switch-to-buffer "*Buffer List*")
  (show "list")
  ;; d, k, C-d: 消す印. s: 保存の印
  (to "aa") (execute-kbd-macro (kbd "d")) (show "d")
  (to "cc") (execute-kbd-macro (kbd "C-d")) (show "C-d")
  (to "ff.txt") (execute-kbd-macro (kbd "s")) (show "s")
  (to "dd") (execute-kbd-macro (kbd "C-u 2 k")) (show "C-u 2 k")
  ;; u, DEL, U: 印を消す
  (to "dd") (execute-kbd-macro (kbd "u")) (show "u")
  (to "dd") (execute-kbd-macro (kbd "DEL")) (show "DEL")
  (execute-kbd-macro (kbd "U")) (show "U")
  ;; ~, %
  (to "aa") (execute-kbd-macro (kbd "~")) (show "~")
  (princ (format "aa modified: %s\n" (buffer-modified-p "aa")))
  (execute-kbd-macro (kbd "C-u ~")) (show "C-u ~")
  (to "bb") (execute-kbd-macro (kbd "%")) (show "%")
  (princ (format "bb read-only: %s\n" (with-current-buffer "bb" (buffer-read-only))))
  ;; x: 保存して, 消す
  (to "aa") (execute-kbd-macro (kbd "C-u ~"))
  (to "cc") (execute-kbd-macro (kbd "d d"))
  (to "ff.txt") (execute-kbd-macro (kbd "s"))
  (execute-kbd-macro (kbd "x")) (show "x")
  (princ (format "killed: %s %s, saved: %S\n" (get-buffer "cc") (get-buffer "dd") (read-file-string file)))
  (with-current-buffer "aa" (set-buffer-modified-p #f))
  (delete-directory dir #t))
