(with-current-buffer (generate-new-buffer "b")
  (insert "foo bar\nbaz  qux\n\nend")
  (goto-char 1)
  (forward-char 2)
  (princ (format "%d\n" (point)))
  (backward-char 1)
  (princ (format "%d\n" (point)))
  (end-of-line)
  (princ (format "%d %s %s\n" (point) (if (eolp) "eolp" "-") (if (bolp) "bolp" "-")))
  (beginning-of-line)
  (princ (format "%d %s\n" (point) (if (bolp) "bolp" "-")))
  (princ (format "%d\n" (forward-line 1)))
  (princ (format "%d %d\n" (point) (current-column)))
  (forward-word 1)
  (princ (format "%d\n" (point)))
  (forward-word 1)
  (princ (format "%d\n" (point)))
  (backward-word 1)
  (princ (format "%d\n" (point)))
  (princ (format "%d %d\n" (line-beginning-position) (line-end-position)))
  (princ (format "%d\n" (count-lines 1 (point-max))))
  (princ (format "%d\n" (forward-line 10)))
  (princ (format "%d %s\n" (point) (if (eobp) "eobp" "-")))
  (goto-char 1)
  (princ (format "%d\n" (forward-line -1)))
  (princ (format "%s\n" (if (bobp) "bobp" "-")))
  (move-to-column 4)
  (princ (format "%d\n" (point)))
  (forward-line 1)
  (move-to-column 20)
  (princ (format "%d %d\n" (point) (current-column)))
  (goto-char 1)
  (end-of-line 2)
  (princ (format "%d\n" (point)))
  (beginning-of-line 2)
  (princ (format "%d\n" (point))))
