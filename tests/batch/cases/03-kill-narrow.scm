(with-current-buffer (generate-new-buffer "t")
  (insert "abcdef")
  (kill-region 2 4)
  (princ (format "%s\n" (buffer-string)))
  (goto-char (point-max))
  (yank)
  (princ (format "%s|%d\n" (buffer-string) (point)))
  (narrow-to-region 2 5)
  (princ (format "%s|%d|%d\n" (buffer-string) (point-min) (point-max)))
  (widen)
  (princ (format "%d|%d\n" (point-min) (point-max)))
  (goto-char 3)
  (save-excursion (goto-char 1) (insert "XY"))
  (princ (format "%d\n" (point))))
