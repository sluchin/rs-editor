(define (show)
  (with-current-buffer "*compilation*"
    (for-each (lambda (line)
                (princ (string-append (replace-regexp-in-string "default-directory: .*" "default-directory: DIR" (replace-regexp-in-string " at [A-Z][a-z][a-z] .*" " at TIME" line)) "\n")))
              (split-string (buffer-string) "\n"))))
;; コンパイルは, 終わるまで待つ
(define (wait) #f)
(define (pos)
  (set-buffer (window-buffer (selected-window)))
  (princ (format "%s %d %d\n" (buffer-name) (line-number-at-pos) (current-column))))
(define (try thunk)
  (condition-case e (thunk) (error (princ (format "%S\n" (cadr e))))))
(find-file "a.txt")
(write-region "x\nyy\nzzz\n" #f "c1.c")
(write-region "1\n2\n3\n4\n" #f "c2.c")
(compile "printf 'c1.c:2:2: error: e1\\nother\\nc2.c:3: warning: w\\n  File \"c1.c\", line 3\\n'; exit 3")
(wait)
(show)
(princ (format "%S %S\n" compile-command (with-current-buffer "*compilation*" major-mode)))
(next-error) (pos)
(next-error) (pos)
(next-error) (pos)
(try (lambda () (next-error)))
(previous-error) (pos)
(first-error) (pos)
(next-error 2) (pos)
;; コンパイルのバッファの中で
(switch-to-buffer "*compilation*")
(goto-char (point-min))
(compilation-next-error 1) (pos)
(compilation-next-error 2) (pos)
(try (lambda () (compilation-next-error 1)))
(compilation-previous-error 1) (pos)
(try (lambda () (compilation-previous-error 5)))
(goto-char (point-min))
(compilation-next-file 1) (pos)
(compilation-next-file 1) (pos)
(compilation-previous-file 1) (pos)
(compile-goto-error) (pos)
;; recompile は, 同じコマンドを同じディレクトリで動かす
(delete-other-windows)
(switch-to-buffer "c2.c")
(recompile)
(wait)
(show)
(compile "true")
(wait)
(show)
