(defun show (label)
  (princ (format "%s: %d %S %s\n" label (point) (or (mark t) 0) (buffer-substring (point-min) (point-max)))))
(progn (switch-to-buffer (generate-new-buffer "r"))
  (insert "one two three four five six seven")
  (goto-char 1)
  ;; C-x z は, 前のコマンドを, 同じ前置引数で繰り返す. z を続けると, また繰り返す
  (execute-kbd-macro (kbd "M-f C-x z"))
  (show "repeat")
  (execute-kbd-macro (kbd "M-f C-x z z z"))
  (show "repeat z")
  (goto-char 1)
  (execute-kbd-macro (kbd "C-u 2 C-f C-x z"))
  (show "repeat prefix")
  (goto-char 1)
  (execute-kbd-macro (kbd "C-f C-u 3 C-x z"))
  (show "repeat new prefix")
  ;; 文字を入れたなら, その文字
  (goto-char (point-max))
  (execute-kbd-macro (kbd "! C-x z z"))
  (show "repeat insert")
  (execute-kbd-macro (kbd "C-u 2 ? C-x z"))
  (show "repeat insert prefix")
  ;; z の後のほかのキーは, いつもどおり
  (goto-char 1)
  (execute-kbd-macro (kbd "C-f C-x z z a"))
  (show "repeat then a")
  ;; C-u C-SPC: マークの履歴をたどる
  (goto-char 1)
  (dotimes (_ 3) (execute-kbd-macro (kbd "C-SPC")) (deactivate-mark) (execute-kbd-macro (kbd "M-f")))
  (show "marks")
  (execute-kbd-macro (kbd "C-u C-SPC"))
  (show "C-u C-SPC 1")
  (execute-kbd-macro (kbd "C-u C-SPC"))
  (show "C-u C-SPC 2")
  (execute-kbd-macro (kbd "C-u C-SPC C-u C-SPC"))
  (show "C-u C-SPC 3")
  (condition-case err (progn (execute-kbd-macro (kbd "C-x ESC ESC RET")) (show "C-x ESC ESC")) (error (princ "error\n"))))
