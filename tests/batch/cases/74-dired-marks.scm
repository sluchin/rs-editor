(define (show) (princ (format "%s %s\n" (line-number-at-pos) (or (dired-get-filename #t) "nil"))))
(define (marks)
  (princ (format "%s\n" (string-join (save-excursion
                                       (goto-char (point-min))
                                       (let loop ((r '()))
                                         (if (eobp)
                                             (reverse r)
                                             (let ((name (dired-get-filename #t)))
                                               (let ((r (if name
                                                            (cons (string-append (buffer-substring (line-beginning-position) (+ 1 (line-beginning-position))) name) r)
                                                            r)))
                                                 (forward-line 1)
                                                 (loop r))))))
                                     " "))))
(define (try keys) (condition-case e (execute-kbd-macro (kbd keys)) (error (princ (format "error %s\n" (error-message-string e))))))
;; ディレクトリを開くと dired. 読み込み専用で, 始めは . .. と # で始まる名前の後の行
(find-file "sub")
(princ (format "%s %S\n" (buffer-name) (if (buffer-read-only) 't 'nil)))
(show)
(try "z")
(condition-case e (insert "x") (error (princ (format "error %s\n" (error-message-string e)))))
;; 前置引数
(try "3 m") (marks) (show)
(try "- 2 u") (marks) (show)
(try "U")
(try "C-u m") (marks) (show)
(try "2 DEL") (marks) (show)
(try "U t") (marks)
(try "t U")
(try "* /") (marks)
(try "C-u * /") (marks)
(try "* *") (marks)
(try "* @") (marks)
(try "U % m f [12] RET") (marks)
(try "C-u % m f 2 RET") (marks)
(try "U % d l RET") (marks)
(try "U % &") (marks)
(try "U ~ #") (marks)
(try "C-u ~") (marks)
(try "M-DEL D") (marks)
(try "* m M-DEL RET") (marks)
;; d は . と .. に付けない
(goto-char (point-min))
(try "n n d d") (marks) (show)
(try "U")
;; 移る
(goto-char (point-min))
(try "> >") (show)
(try "<") (show)
(try "<") (show)
(try "< <") (show)
(try "j f 2 . c RET") (show)
(try "j n o n e RET") (show)
(try "2 m") (goto-char (point-min))
(try "M-}") (show)
(try "M-}") (show)
(try "M-}") (show)
(try "M-{") (show)
(try "U M-}") (show)
