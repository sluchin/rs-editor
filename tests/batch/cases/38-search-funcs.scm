(define (p x) (if x (format "%S" x) "nil"))
(with-current-buffer (generate-new-buffer "b")
  (insert "Foo bar foo baz\nFOO qux\nlast foo")
  (goto-char 1)
  (princ (format "%s %d\n" (p (search-forward "foo" #f #t)) (point)))
  (set! case-fold-search #f)
  (princ (format "%s %d\n" (p (search-forward "foo" #f #t)) (point)))
  (goto-char 1)
  (princ (format "%s\n" (p (search-forward "foo" #f #t 2))))
  (goto-char 1)
  (princ (format "%s %d\n" (p (search-forward "foo" 5 #t)) (point)))
  (goto-char 1)
  (princ (format "%s %d\n" (p (search-forward "zzz" #f 'move)) (point)))
  (goto-char 1)
  (princ (format "%S\n" (condition-case e (search-forward "zzz") (error (error-message-string e)))))
  (princ (format "%s\n" (p (search-backward "foo" #f #t))))
  (princ (format "%s %d\n" (p (search-backward "FOO" #f #t)) (point)))
  (set! case-fold-search #t)
  (goto-char (point-max))
  (princ (format "%s %s\n" (p (re-search-backward "f[a-z]+" #f #t)) (match-string 0)))
  (goto-char 1)
  (princ (format "%S %S\n" (re-search-forward "\\(ba.\\) \\(f..\\)" #f #t) (list (match-string 1) (match-string 2))))
  (goto-char 1)
  (princ (format "%s %d\n" (p (re-search-forward "^FOO" #f #t)) (point)))
  (goto-char 1)
  (princ (format "%s\n" (p (search-forward-regexp "q.x" #f #t))))
  (princ (format "%s\n" (if (looking-at "$") 1 0)))
  (goto-char 1)
  (princ (format "%s\n" (p (word-search-forward "bar" #f #t)))))
