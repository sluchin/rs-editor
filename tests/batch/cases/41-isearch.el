(defun state () (princ (format "%d %s\n" (point) (if (region-active-p) 1 0))))
(progn (switch-to-buffer (generate-new-buffer "b"))
  (insert "foo bar Foo baz\nfoo qux\nlast FOO")
  (goto-char 1)
  (execute-kbd-macro (kbd "C-s foo RET"))
  (state)
  (execute-kbd-macro (kbd "C-s foo C-s RET"))
  (state)
  (execute-kbd-macro (kbd "C-s foo C-s C-s C-r RET"))
  (state)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-s bar DEL u RET"))
  (state)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-s q C-g"))
  (state)
  (goto-char (point-max))
  (execute-kbd-macro (kbd "C-r foo RET"))
  (state)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-M-s ba. RET"))
  (state)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-s Foo RET"))
  (state)
  (goto-char 1)
  (execute-kbd-macro (kbd "C-s zzz"))
  (state)
  (execute-kbd-macro (kbd "C-g"))
  (state))
