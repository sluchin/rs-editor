(with-current-buffer (find-file-noselect "a.txt")
  (insert "new\n")
  (save-buffer)
  (princ (format "%s\n" (if (buffer-modified-p) "modified" "clean")))
  (insert "more\n")
  (save-buffer))
(with-current-buffer (find-file-noselect "fresh.txt")
  (insert "1")
  (save-buffer)
  (princ (format "%s\n" (if (file-exists? "fresh.txt~") "backup" "no-backup")))
  (insert "2")
  (save-buffer)
  (princ (format "%s\n" (if (file-exists? "fresh.txt~") "backup" "no-backup"))))
