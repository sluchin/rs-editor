(defun ar (f) (condition-case e (funcall f) (args-out-of-range (concat (format "%S" e) " | " (error-message-string e)))))
(with-current-buffer (generate-new-buffer "rng")
  (insert "abcdef")
  (princ (format "%s\n" (ar (lambda () (buffer-substring 0 2)))))
  (princ (format "%s\n" (ar (lambda () (buffer-substring 5 0)))))
  (princ (format "%s\n" (ar (lambda () (buffer-substring 9 1)))))
  (princ (format "%s\n" (ar (lambda () (delete-region 0 2)))))
  (princ (format "%s\n" (ar (lambda () (kill-region 0 2)))))
  (princ (format "%s\n" (ar (lambda () (upcase-region 0 2)))))
  (princ (format "%s\n" (ar (lambda () (narrow-to-region 0 2)))))
  (princ (format "%s\n" (ar (lambda () (narrow-to-region 9 1)))))
  (princ (format "%s\n" (buffer-substring 2 4)))
  (princ (format "%s\n" (buffer-substring 4 2)))
  (goto-char 0)
  (princ (format "%d\n" (point)))
  (goto-char 99)
  (princ (format "%d\n" (point))))
(princ (format "%s\n" (ar (lambda () (string-search "a" "b" 5)))))
(princ (format "%s\n" (ar (lambda () (string-search "a" "b" -1)))))
(princ (format "%s\n" (if (string-search "a" "abc" 1) "found" "none")))
(princ (format "%s %s %s\n" (if (car nil) "x" "nil") (length (cdr nil)) (length (cdr '(1)))))
