(define (show label)
  (princ (format "%s: %d %S\n" label (point) (buffer-substring (point-min) (point-max)))))
(define (out label value) (princ (format "%s: %S\n" label value)))
(switch-to-buffer (generate-new-buffer "ev"))
;; C-u C-x C-e: 値を本文に入れる
(insert "(+ 1 2)")
(execute-kbd-macro (kbd "C-u C-x C-e"))
(show "C-u C-x C-e")
;; *scratch* の C-j

(switch-to-buffer "*scratch*")
(erase-buffer)
(insert "(list 1 \"a\" (* 2 3))")
(execute-kbd-macro (kbd "C-j"))
(show "C-j")
(insert "(concat \"x\" \"y\")")
(execute-kbd-macro (kbd "C-j"))
(show "C-j string")
;; C-M-x: 点のある, または後ろの, 一番外側の式 (Emacs はバッチでは値を標準出力に出すので, 同じく出す)
(erase-buffer)
(insert "(+ 1\n   (* 2 3))\n\n(- 10 4)\n")
(goto-char 8)
(out "eval-defun" (let ((v (eval-defun #f))) (princ v) v))
(goto-char 17)
(out "eval-defun after" (let ((v (eval-defun #f))) (princ v) v))
(goto-char (point-max))
(out "eval-defun before" (let ((v (eval-defun #f))) (princ v) v))
(show "eval-defun point")
;; eval-region, eval-buffer: 式を順に評価する
(get-buffer-create "out")
(switch-to-buffer (generate-new-buffer "ev2"))
(insert "(with-current-buffer \"out\" (insert \"a\"))\n;; comment\n(with-current-buffer \"out\" (insert \"b\")) (with-current-buffer \"out\" (insert \"c\"))\n")
(eval-region 1 42)
(out "eval-region" (with-current-buffer "out" (buffer-string)))
(eval-buffer)
(out "eval-buffer" (with-current-buffer "out" (buffer-string)))
(show "eval-buffer")
;; load-file
(let ((file (make-temp-file "ld")))
  (write-file-string file "(with-current-buffer \"out\" (insert \"L\"))\n")
  (load-file file)
  (delete-file file))
(out "load-file" (with-current-buffer "out" (buffer-string)))
;; check-parens
(erase-buffer)
(insert "(a (b) \"c\"\n(d e))) (f")
(goto-char 1)
(out "check-parens" (condition-case err (check-parens) (user-error (cadr err))))
(show "check-parens")
(erase-buffer)
(insert "(a (b) (c")
(out "check-parens 2" (condition-case err (check-parens) (user-error (cadr err))))
(show "check-parens 2")
(erase-buffer)
(insert "(a) b")
(goto-char 2)
(out "check-parens ok" (check-parens))
(show "check-parens ok")
