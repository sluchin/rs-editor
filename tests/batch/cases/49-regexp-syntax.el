(defun m (re s) (princ (format "%S " (if (string-match re s) (list (match-beginning 0) (match-end 0)) 0))))
(m "\\s-+" "a  b")
(m "\\S-+" "  ab ")
(m "\\sw+" "  ab")
(m "\\s(" "ab(")
(m "\\(a\\)\\1" "xaa")
(m "\\(a\\)\\(b\\)\\2\\1" "abba")
(m "\\w+" "  ab")
(m "\\W+" "ab  c")
(m "\\_<ab\\_>" "x ab")
(m "\\<ab\\>" "xab ab")
(m "\\bab\\b" "xab ab")
(m "\\Bab" "xab ab")
(m "a\\{2\\}" "aaa")
(m "a\\{2,\\}" "baaaa")
(m "a\\{1,2\\}b" "aaab")
(m "[[:alpha:]]+" "12ab")
(m "[[:digit:][:space:]]+" "ab1 2c")
(m "[[:upper:]]" "abC")
(m "\\`a" "a")
(m "a\\'" "ba")
(m "a\\|b" "cb")
(m "a+?" "aaa")
(m "a*?b" "aab")
(m "[a-c]+" "xabcd")
(m "[^a-c]+" "abxyc")
(m "[]a]+" "x]a")
(m "[a-]+" "x-a")
(m "^b" "a\nb")
(m "a$" "a\nb")
(m "." "\nx")
(m "\\(?:ab\\)+" "xababy")
(m "x*" "abc")
(m "\\." "a.b")
(m "a.c" "abc")
(m "(a)" "(a)")
(m "a{2}" "a{2}")
(m "a|b" "a|b")
(m "[\\]" "a\\b")
(m "\\$" "a$")
(m "a\\??" "ab")
(terpri)
