(define (show label)
  (princ (format "%s: %d %S\n" label (point) (buffer-substring (point-min) (point-max)))))
(define (try label functions text pos keys)
  (set! hippie-expand-try-functions-list functions)
  (erase-buffer)
  (insert text)
  (goto-char pos)
  (set! last-command #f)
  (execute-kbd-macro (kbd keys))
  (show label))
(global-set-key "C-;" 'hippie-expand)
(begin (switch-to-buffer (generate-new-buffer "h"))
  ;; dabbrev: 後ろ, 前の順に, 試したものを飛ばす. 尽きたら元に戻す
  (let ((text "foobar foo-baz Foxtrot\nfo\nfoot food foobar\n"))
    (try "dabbrev 1" '(try-expand-dabbrev) text 26 "C-;")
    (try "dabbrev 3" '(try-expand-dabbrev) text 26 "C-; C-; C-;")
    (try "dabbrev 5" '(try-expand-dabbrev) text 26 "C-; C-; C-; C-; C-;")
    (try "dabbrev end" '(try-expand-dabbrev) text 26 "C-; C-; C-; C-; C-; C-;")
    ;; 前置引数: C-u で元に戻す. 正の数で, 次の関数へ飛ぶ
    (try "C-u" '(try-expand-dabbrev) text 26 "C-; C-; C-u C-;")
    (try "C-u 1" '(try-expand-line try-expand-dabbrev) text 26 "C-u 1 C-;")
    (try "next function" '(try-expand-line try-expand-dabbrev) "fo bar\nfoo bar\nfo" 18 "C-; C-u 1 C-;")
    ;; 大文字の略語
    (try "case" '(try-expand-dabbrev) text 26 "DEL DEL F O C-; C-;")
    (try "case up" '(try-expand-dabbrev) text 26 "DEL DEL F O O C-;"))
  ;; 他のバッファ
  (with-current-buffer (get-buffer-create "other")
    (insert "zebra zeppelin zone"))
  (try "all buffers" '(try-expand-dabbrev try-expand-dabbrev-all-buffers) "zest ze" 8 "C-; C-; C-;")
  (try "all buffers end" '(try-expand-dabbrev try-expand-dabbrev-all-buffers) "zest ze" 8 "C-; C-; C-; C-; C-;")
  ;; 行
  (try "line" '(try-expand-line) "  hello world\n(foo (bar) baz)\nhello there  \n  hel" 50 "C-; C-;")
  (try "line forward" '(try-expand-line) "hel\nhelp me\n" 4 "C-;")
  ;; リスト
  (try "list" '(try-expand-list) "(foo (bar) baz)\n(foo bar)\n(foo" 31 "C-; C-;")
  (try "list inner" '(try-expand-list) "(a (bar x) (b" 14 "C-;")
  ;; kill ring
  (kill-new "quick quiet")
  (kill-new "quote")
  (try "kill" '(try-expand-dabbrev-from-kill) "qu" 3 "C-; C-; C-;")
  (try "kill end" '(try-expand-dabbrev-from-kill) "qu" 3 "C-; C-; C-; C-;")
  ;; 略語
  (define-abbrev global-abbrev-table "hx" "hippie expansion")
  (try "abbrev" '(try-expand-all-abbrevs try-expand-dabbrev) "hxy hx" 7 "C-;")
  (try "abbrev then dabbrev" '(try-expand-all-abbrevs try-expand-dabbrev) "hxy hx" 7 "C-; C-;")
  ;; ファイルの名前
  (let ((dir (string-append (make-temp-file "he" #t) "/")))
    (write-file-string (string-append dir "alpha-one") "")
    (write-file-string (string-append dir "alpha-two") "")
    (make-directory (string-append dir "beta"))
    (for-each (lambda (case)
                (set! hippie-expand-try-functions-list '(try-complete-file-name-partially try-complete-file-name))
                (erase-buffer)
                (insert dir (list-ref case 1))
                (set! last-command #f)
                (execute-kbd-macro (kbd (list-ref case 2)))
                (princ (format "%s: %S\n" (list-ref case 0) (substring (buffer-string) (min (string-length dir) (buffer-size))))))
              '(("file partial" "al" "C-;") ("file 2" "al" "C-; C-;") ("file 3" "al" "C-; C-; C-;")
                ("file end" "al" "C-; C-; C-; C-;") ("dir" "b" "C-;") ("dir all" "" "C-; C-;")))
    (delete-directory dir #t)))
