(defun show (label)
  (princ (format "%s: %d %S\n" label (point) (mark t))))
(let ((file (make-temp-file "ins")))
  (with-temp-buffer (insert "XYZ") (write-region (point-min) (point-max) file))
  (with-current-buffer (generate-new-buffer "t")
    (emacs-lisp-mode)
    (insert "(defun a ()\n  1)\n\n(defun b ()\n  2)\n")
    (goto-char 1)
    (set-mark nil)
    (deactivate-mark)
    (insert-file-contents file)
    (show "insert-file-contents")
    (goto-char 3)
    (deactivate-mark)
    (set-mark nil)
    (insert-file file)
    (show "insert-file")
    (setq killed-rectangle '("ab" "cd"))
    (goto-char 5)
    (deactivate-mark)
    (set-mark nil)
    (yank-rectangle)
    (show "yank-rectangle")
    (set-register ?a "REG")
    (goto-char 5)
    (deactivate-mark)
    (set-mark nil)
    (insert-register ?a)
    (show "insert-register")
    (set-register ?a "REG")
    (goto-char 5)
    (deactivate-mark)
    (set-mark nil)
    (insert-register ?a t)
    (show "insert-register arg")))
