;;; Emacs の rust-mode の font-lock の結果を, 範囲ごとに, 始まり, 終わり, 種類の順に, タブで区切って出す.
;;; 位置は 1 から数え, 終わりは含まない. 種類は rs-editor の `token-spans' と同じ名前.
;;; 色を付けない文字と, 改行は出さない (範囲は, 行をまたがない. rs-editor の Lisp の解析も同じ).
;;; コメントの区切り (font-lock-comment-delimiter-face) は, コメントと同じ種類にする.
(setq enable-local-variables nil)
(require 'rust-mode)
(defun dump--kind (pos)
  "POS の文字の種類 (無ければ nil)."
  (let ((faces (get-text-property pos 'face)))
    (unless (listp faces) (setq faces (list faces)))
    (catch 'found
      (dolist (face faces)
        (let ((kind (pcase face
                      ('font-lock-comment-face 'comment)
                      ('font-lock-comment-delimiter-face 'comment)
                      ('font-lock-doc-face 'doc)
                      ('rust-unsafe 'warning)
                      ('rust-question-mark 'builtin)
                      ('rust-builtin-formatting-macro 'builtin)
                      ('rust-string-interpolation 'string)
                      ('font-lock-preprocessor-face 'preprocessor)
                      ('font-lock-string-face 'string)
                      ('font-lock-keyword-face 'keyword)
                      ('font-lock-function-name-face 'function-name)
                      ('font-lock-variable-name-face 'variable-name)
                      ('font-lock-type-face 'type)
                      ('font-lock-constant-face 'constant)
                      ('font-lock-builtin-face 'builtin)
                      ('font-lock-warning-face 'warning)
                      ('font-lock-regexp-grouping-backslash 'regexp-group)
                      ('font-lock-regexp-grouping-construct 'regexp-group)
                      (_ nil))))
          (when kind (throw 'found kind)))))))
(let ((runs nil))
  (rust-mode)
  (font-lock-mode 1)
  (font-lock-ensure)
  (let ((pos (point-min)))
    (while (< pos (point-max))
      (let ((kind (and (not (eq (char-after pos) ?\n)) (dump--kind pos))))
        (when kind
          (if (and runs (eq (nth 2 (car runs)) kind) (= (nth 1 (car runs)) pos))
              (setcar (cdr (car runs)) (1+ pos))
            (push (list pos (1+ pos) kind) runs))))
      (setq pos (1+ pos))))
  (dolist (run (nreverse runs))
    (princ (format "%d\t%d\t%s\n" (nth 0 run) (nth 1 run) (nth 2 run)))))
