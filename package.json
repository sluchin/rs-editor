{
  "name": "rseditor",
  "version": "1.0.0",
  "description": "Scheme editor built with Tauri + React + Rust",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prelint": "vite build",
    "lint": "eslint src tests/frontend",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:all": "npm run lint && npm run lint:rust && npm run po:check",
    "po:update": "python3 tools/po/update.py",
    "po:check": "python3 tools/po/update.py --check",
    "lint:fix": "eslint src tests/frontend --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/frontend/**/*.{ts,tsx}\" && cargo fmt --all && npm run format:markdown",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/frontend/**/*.{ts,tsx}\" && cargo fmt --all --check && npm run format:markdown:check",
    "pretest": "vite build",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:scheme": "cargo test -p rseditor-core --test lisp_ert_test -- --nocapture",
    "test:all": "npm run test && npm run test:rust",
    "coverage:fe": "vitest run --coverage",
    "coverage:be": "cargo tarpaulin --workspace --skip-clean --engine llvm --fail-under 100 --out Html",
    "coverage:be:clean": "cargo tarpaulin --workspace --engine llvm --fail-under 100 --out Html",
    "coverage": "npm run coverage:fe && npm run coverage:be",
    "coverage:clean": "npm run coverage:fe && npm run coverage:be:clean",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint:all && npm run test:all",
    "doc:fe": "typedoc --entryPointStrategy expand ./src --out build/docs/fe",
    "doc:be": "CARGO_TARGET_DIR=target/doc_build cargo doc --workspace --no-deps && rm -rf build/docs/be && mkdir -p build/docs/be && cp -r target/doc_build/doc/* build/docs/be/",
    "doc": "npm run doc:fe && npm run doc:be",
    "format:markdown": "markdownlint-cli2 --fix",
    "format:markdown:check": "markdownlint-cli2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "loglevel": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "jsdom": "^30",
    "prettier": "^3",
    "typedoc": "^0.28.20",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "markdownlint-cli2": "^0.17.2"
  }
}