{
  "name": "rseditor",
  "version": "1.0.0",
  "description": "Scheme editor built with Tauri + React + Rust",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prelint": "vite build",
    "lint": "eslint src",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "lint:all": "npm run lint && npm run lint:rust",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" && cd src-tauri && cargo fmt",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" && cd src-tauri && cargo fmt --check",
    "pretest": "vite build",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm run test && npm run test:rust",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint:all && npm run test:all"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "loglevel": "^1.9.2",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "jsdom": "^29",
    "prettier": "^3",
    "typescript": "^7",
    "typescript-eslint": "^8",
    "vite": "^5",
    "vitest": "^4"
  }
}
