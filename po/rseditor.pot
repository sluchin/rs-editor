msgstr ""

#: lisp/winner.scm
msgctxt "function:winner--set"
msgid "Restore the configuration CONF, except windows of boring buffers.  The selected window stays if it is in CONF."
msgstr ""

#: lisp/winner.scm
msgctxt "function:winner-mode"
msgid ""
"Toggle Winner mode on or off.\n"
"Winner mode is a global minor mode that records the changes in\n"
"the window configuration (i.e. how the frames are partitioned\n"
"into windows) so that the changes can be \"undone\" using the\n"
"command `winner-undo'.  By default this one is bound to the key\n"
"sequence C-c <left>.  If you change your mind (while undoing),\n"
"you can press C-c <right> (calling `winner-redo')."
msgstr ""

#: lisp/winner.scm
msgctxt "function:winner-undo"
msgid ""
"Switch back to an earlier window configuration saved by Winner mode.\n"
"In other words, \"undo\" changes in window configuration."
msgstr ""

#: lisp/winner.scm
msgctxt "function:winner-redo"
msgid "Restore a more recent window configuration saved by Winner mode."
msgstr ""

#: lisp/xref.scm
