#: lisp/winner.scm
msgctxt "variable:winner-ring-size"
msgid "Maximum number of stored window configurations."
msgstr ""

#: lisp/winner.scm
msgctxt "variable:winner-boring-buffers"
msgid "List of buffer names whose windows `winner-undo' will not restore."
msgstr ""

#: lisp/winner.scm
msgctxt "variable:winner--ring"
msgid ""
"The stored configurations, the newest first.  Each is (CONFIGURATION DATA),\n"
"where DATA lists the edges and the buffer of each window."
msgstr ""

