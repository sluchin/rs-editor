msgctxt "function:org-open-at-point"
msgid "Open the link at point."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-link-open"
msgid ""
"Open LINK.\n"
"http and so on use `browse-url', file: opens in the editor,\n"
"and others are searched in the buffer."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-link-search"
msgid ""
"Search the buffer for TARGET.\n"
"TARGET is *HEADING, #ID, a line number, /REGEXP/, <<TARGET>>, a title or words."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-agenda-buffer-name"
msgid "Name of the agenda buffer."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-agenda-markers"
msgid "Entries of the agenda lines, a list of (LINE FILE HEADING-LINE)."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-agenda-redo-command"
msgid "Procedure to rebuild the agenda (called by r and g)."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-agenda-start-day"
msgid "First day of the weekly agenda."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-agenda-previous-buffer"
msgid "Buffer shown before the agenda."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-file-list"
msgid ""
"Return the agenda files.\n"
"A directory in `org-agenda-files' means the .org files in it."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-file-text"
msgid "Return the contents of FILE, or of its buffer if the buffer is modified."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-entries"
msgid ""
"Return the headings of FILE as a list of\n"
"(FILE LINE TODO PRIORITY TITLE TAGS CATEGORY SCHEDULED DEADLINE (DATES...) BODY)."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-all-entries"
msgid "Return the headings of all the agenda files."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-file"
msgid "Return the file of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-line"
msgid "Return the line of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-todo"
msgid "Return the TODO state of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-priority"
msgid "Return the priority of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-title"
msgid "Return the title of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-tags"
msgid "Return the tags of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-entry-category"
msgid "Return the category of the agenda entry E."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-timestamp-on?"
msgid "Return #t if the timestamp PARSED falls on DAY, including repeats."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-line"
msgid ""
"Return an agenda line of the entry E with TIME and EXTRA.\n"
"It shows the category, time, planning mark, state, title and tags."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-time"
msgid ""
"Return the time of PARSED as shown in the agenda, like 10:00...... or 10:00-11:00.\n"
"A one-digit hour is padded with a space."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-day-items"
msgid ""
"Return the agenda lines of DAY from ENTRIES, as a list of (TIME LINE ENTRY PRIORITY).\n"
"TODAY is today's date."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-priority"
msgid ""
"Return the priority of the entry E as a number, like `org-get-priority' in Emacs.\n"
"The lowest priority is 0, and each step up adds 1000."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-sort"
msgid ""
"Sort ITEMS: lines with a time first, in time order;\n"
"lines with the same time or no time by priority, highest first.\n"
"This is the default of `org-agenda-sorting-strategy' in Emacs\n"
"(time-up priority-down category-keep)."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-show"
msgid ""
"Show ROWS in the agenda buffer, and remember REDO to rebuild it.\n"
"ROWS is a list of (LINE ENTRY); ENTRY is #f for a heading line."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-mode"
msgid "Set the keys and highlighting of the agenda buffer."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-date-line"
msgid "Return the line of DAY, like \"Monday     26 October 2026 W44\"."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-list-from"
msgid "Show the weekly agenda for `org-agenda-span' days from START."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-week-start"
msgid "Return the first day of the week of DAY, on `org-agenda-start-on-weekday'."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-list"
msgid "Show the weekly agenda."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-todo-list"
msgid "Show the list of TODO entries."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-tags-view"
msgid ""
"Show the entries matching tags.\n"
"a+b means both, a|b either, and -a without a."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-tags-match?"
msgid "Return #t if TAGS match MATCH."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-search-view"
msgid "Show the headings containing all the words, ignoring case."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda"
msgid "Select an agenda view."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-marker"
msgid ""
"Return the entry of the agenda line at point as (FILE LINE).\n"
"Signal an error if there is none."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-switch-to"
msgid "Open the file of the entry at point."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-show-and-scroll-up"
msgid "Show the entry at point in another window."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-goto"
msgid "Show the entry at point in another window."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-next-line"
msgid "Move to the next line of the agenda."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-previous-line"
msgid "Move to the previous line of the agenda."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-move"
msgid "Move the weekly agenda by DAYS days (f and b)."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-later"
msgid "Show the next week."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-earlier"
msgid "Show the previous week."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-goto-today"
msgid "Show the week of today."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-redo"
msgid "Rebuild the agenda."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-todo"
msgid "Change the TODO state of the entry at point."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-agenda-quit"
msgid "Kill the agenda buffer."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-capture-buffer-name"
msgid "Name of the capture buffer."
msgstr ""

#: lisp/org.scm
msgctxt "variable:org-capture-current"
msgid ""
"Current capture, as (TEMPLATE BUFFER POSITION).\n"
"BUFFER and POSITION are where the capture started."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-templates-list"
msgid "Return the capture templates, or the default ones if there are none."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-expand-file"
msgid ""
"Return the target file of FILE.\n"
"\"\" means `org-default-notes-file'; a relative name is in `org-directory'."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-fill-template"
msgid ""
"Fill TEMPLATE, and return (TEXT POSITION).\n"
"ANNOTATION is the link to the original location, and FILE is its file."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture"
msgid "Select a template and write in *Capture*."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-place"
msgid ""
"Insert the captured TEXT of TYPE into TARGET.\n"
"This is called in the target buffer."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-adjust-level"
msgid "Change the levels of the headings in TEXT to LEVEL."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-finalize"
msgid "Finish the capture, add it to the target and save it."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-capture-kill"
msgid "Abort the capture."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-buffer-list"
msgid "Return the Org buffers (.org files)."
msgstr ""

#: lisp/org.scm
msgctxt "function:org-switchb"
msgid "Switch to an Org buffer."
msgstr ""

#: lisp/rect.scm
msgctxt "variable:killed-rectangle"
msgid "Rectangle for `yank-rectangle' to insert: a list of strings, one for each line."
msgstr ""

#: lisp/rect.scm
msgctxt "variable:string-rectangle-history"
msgid "History list for `string-rectangle'."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--without-tabs"
msgid "Call THUNK with indent-tabs-mode turned off."
msgstr ""

#: lisp/rect.scm
msgctxt "function:apply-on-rectangle"
msgid ""
"Call FUNCTION for each line of the rectangle with corners at START and END.\n"
"FUNCTION is called with the start and end columns of the rectangle, plus ARGS,\n"
"and point is at the beginning of the line.  Return point after the last call."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--delete-line"
msgid "Delete the columns from LEFT to RIGHT of the current line."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--delete-extract-line"
msgid "Delete the columns from LEFT to RIGHT of the current line, and return the deleted text."
msgstr ""

#: lisp/rect.scm
msgctxt "function:delete-extract-rectangle"
msgid ""
"Delete the contents of the rectangle with corners at START and END.\n"
"Return it as a list of strings, one for each line of the rectangle.\n"
"With an optional FILL argument, also fill lines where nothing has to be deleted."
msgstr ""

#: lisp/rect.scm
msgctxt "function:insert-rectangle"
msgid ""
"Insert text of RECTANGLE with upper left corner at point.\n"
"RECTANGLE's first line is inserted at point, its second line is inserted at a point\n"
"vertically under point, etc.  RECTANGLE should be a list of strings.\n"
"After this command, the mark is at the upper left corner and point is at the lower right corner."
msgstr ""

#: lisp/rect.scm
msgctxt "function:kill-rectangle"
msgid ""
"Delete the region-rectangle and save it as the last killed one.\n"
"Called from a program with the corners START and END, delete that rectangle.\n"
"With a prefix argument (or a FILL argument), also fill lines where nothing has to be deleted."
msgstr ""

#: lisp/rect.scm
msgctxt "function:yank-rectangle"
msgid "Yank the last killed rectangle with upper left corner at point."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--string-line"
msgid "Replace the columns from LEFT to RIGHT of the current line with STRING."
msgstr ""

#: lisp/rect.scm
msgctxt "function:string-rectangle"
msgid ""
"Replace rectangle contents with STRING on each line.\n"
"The length of STRING need not be the same as the rectangle width.\n"
"Called from a program, takes three arguments: START, END and STRING."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--args"
msgid "Return (START END FILL) for a rectangle command: from ARGS (START END [FILL]), or the region and the prefix argument."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--extract-line"
msgid "Return the text of the columns from LEFT to RIGHT of the current line, with tabs and missing columns as spaces."
msgstr ""

#: lisp/rect.scm
msgctxt "function:extract-rectangle"
msgid ""
"Return the contents of the rectangle with corners at START and END.\n"
"Return it as a list of strings, one for each line of the rectangle."
msgstr ""

#: lisp/rect.scm
msgctxt "function:copy-rectangle-as-kill"
msgid "Copy the region-rectangle and save it as the last killed one."
msgstr ""

#: lisp/rect.scm
msgctxt "function:delete-rectangle"
msgid ""
"Delete (don't save) text in the region-rectangle.\n"
"The same range of columns is deleted in each line starting with the\n"
"line where the region begins and ending with the line where the region ends.\n"
"With a prefix (or a FILL) argument, also fill lines where nothing has to be deleted."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--open-line"
msgid "Open a blank of the width of the rectangle at column LEFT of the current line."
msgstr ""

#: lisp/rect.scm
msgctxt "function:open-rectangle"
msgid ""
"Blank out the region-rectangle, shifting text right.\n"
"The text previously in the region is not overwritten by the blanks,\n"
"but instead winds up to the right of the rectangle.\n"
"With a prefix (or a FILL) argument, fill with blanks even if there is\n"
"no text on the right side of the rectangle."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--clear-line"
msgid "Blank out the columns from LEFT to RIGHT of the current line."
msgstr ""

#: lisp/rect.scm
msgctxt "function:clear-rectangle"
msgid ""
"Blank out the region-rectangle.\n"
"The text previously in the region is overwritten with blanks.\n"
"With a prefix (or a FILL) argument, also fill with blanks the parts of the\n"
"rectangle which were empty."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rect--default-line-number-format"
msgid "Return the default format string for numbering the lines from START-AT."
msgstr ""

#: lisp/rect.scm
msgctxt "function:rectangle-number-lines"
msgid ""
"Insert numbers in front of the region-rectangle.\n"
"START-AT, if given, is the number from which to begin counting.  FORMAT, if given,\n"
"is a format string for the line count.  With a prefix argument, read START-AT and FORMAT."
msgstr ""

#: lisp/register.scm
msgctxt "variable:register-alist"
msgid ""
"List of elements (NAME CONTENTS), one for each Emacs register.\n"
"NAME is a one-character string, and CONTENTS is a string, a number or a rectangle."
msgstr ""

#: lisp/register.scm
msgctxt "function:get-register"
msgid "Return the contents of the register REGISTER, or #f if it is empty."
msgstr ""

#: lisp/register.scm
msgctxt "function:set-register"
msgid "Set the contents of the register REGISTER to VALUE, and return VALUE."
msgstr ""

#: lisp/register.scm
msgctxt "function:register--read"
msgid "Read the name of a register with PROMPT."
msgstr ""

#: lisp/register.scm
msgctxt "function:copy-to-register"
msgid ""
"Copy the region into the register REGISTER.\n"
"Called from a program with REGISTER, START and END (and a true DELETE-FLAG to delete the text),\n"
"copy the text between START and END.  Interactively, with a prefix argument, delete the region."
msgstr ""

#: lisp/register.scm
msgctxt "function:insert-register"
msgid ""
"Insert contents of the register REGISTER.  REGISTER is a one-character string.\n"
"Normally puts point before and mark after the inserted text.\n"
"If the optional second argument ARG is true, puts mark before and point after.\n"
"Interactively, ARG is true unless there is a prefix argument."
msgstr ""

#: lisp/register.scm
msgctxt "function:copy-rectangle-to-register"
msgid ""
"Copy rectangular region of text between START and END into REGISTER.\n"
"If DELETE-FLAG is true (interactively, with a prefix argument), delete the region after copying.\n"
"Called from Lisp, takes four arguments: REGISTER, START, END and DELETE-FLAG."
msgstr ""

#: lisp/register.scm
msgctxt "function:number-to-register"
msgid ""
"Store NUMBER in REGISTER.  If NUMBER is false, read a decimal number from the buffer\n"
"at point, and move point to the end of that number.\n"
"Interactively, NUMBER is the prefix argument (none means false)."
msgstr ""

#: lisp/register.scm
msgctxt "function:append-to-register"
msgid ""
"Append the region between START and END to REGISTER.\n"
"If DELETE-FLAG is true (interactively, with a prefix argument), delete the region after appending."
msgstr ""

#: lisp/register.scm
msgctxt "function:increment-register"
msgid ""
"Augment contents of REGISTER using PREFIX.\n"
"If REGISTER contains a number, add the numeric value of PREFIX to it.\n"
"If REGISTER is empty or contains text, append the region to it, deleting the region\n"
"if PREFIX is true.  Interactively, PREFIX is the raw prefix argument."
msgstr ""

#: lisp/register.scm
msgctxt "function:point-to-register"
msgid ""
"Store the current location of point in REGISTER.\n"
"Use jump-to-register to go to that location."
msgstr ""

#: lisp/register.scm
msgctxt "function:window-configuration-to-register"
msgid ""
"Store the window configuration of the selected frame in REGISTER.\n"
"Use jump-to-register to restore the configuration."
msgstr ""

#: lisp/register.scm
msgctxt "function:jump-to-register"
msgid ""
"Go to the location stored in REGISTER, or restore the configuration stored there.\n"
"Push the mark if going to the location moves point, unless called in succession."
msgstr ""

#: lisp/replace.scm
msgctxt "variable:case-replace"
msgid "Non-nil means `query-replace' should preserve case in replacements."
msgstr ""

#: lisp/replace.scm
msgctxt "variable:query-replace-from-history"
msgid "History list for the search strings of `query-replace'."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--no-upper-p"
msgid "Return #t if STRING has no uppercase letter (a letter after a backslash does not count in a regexp)."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--search"
msgid "Search for STRING from point up to LIMIT.  Return #t on success, leaving point after (before if BACKWARD) the match."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--shift"
msgid "Shift every position of the match data DATA by DELTA."
msgstr ""

#: lisp/replace.scm
msgctxt "function:perform-replace"
msgid ""
"Replace some occurrences of FROM with TO, and return #f.\n"
"QUERY means ask about each match.  REGEXP means FROM is a regexp, and TO may use \\& and \\N.\n"
"DELIMITED means match only whole words.  START and END (or #f) bound the replacement; BACKWARD searches backward."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--read-args"
msgid "Read the string to replace and its replacement from the minibuffer.  Return (FROM TO)."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--region-bounds"
msgid "Return (START END) of the active region, or (#f #f)."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace--command"
msgid "Run a replace command: ARGS are (FROM TO DELIMITED START END BACKWARD), read interactively if empty."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace-string"
msgid ""
"Replace occurrences of FROM-STRING with TO-STRING, from point to the end of the buffer (or in the region).\n"
"Arguments: FROM-STRING TO-STRING [DELIMITED START END BACKWARD]."
msgstr ""

#: lisp/replace.scm
msgctxt "function:replace-regexp"
msgid ""
"Replace things after point matching REGEXP with TO-STRING.\n"
"In TO-STRING, \\& stands for the whole match, and \\N for the Nth parenthesized group."
msgstr ""

#: lisp/replace.scm
msgctxt "function:query-replace"
msgid ""
"Replace some occurrences of FROM-STRING with TO-STRING, asking about each.\n"
"Keys: SPC or y replaces, DEL or n skips, RET or q exits, . replaces and exits, , replaces and asks again, ! replaces all the rest."
msgstr ""

#: lisp/replace.scm
msgctxt "function:query-replace-regexp"
msgid ""
"Replace some things after point matching REGEXP with TO-STRING, asking about each.\n"
"See `query-replace' for the keys."
msgstr ""

#: lisp/replace.scm
msgctxt "variable:occur--targets"
msgid "Alist of the occur buffers and their targets: (BUFFER-NAME (OCCUR-LINE SOURCE-BUFFER POSITION) ...)."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur--collect"
msgid "Return the matching lines of the current buffer as a list of (LINE TEXT POSITION MATCHES), and the number of matches."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur--indent-continuation"
msgid "Prefix each line of TEXT after the first (a match across lines) with the context marker."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur--lines-of"
msgid "Return the line numbers to show: each matching line (in TEXT-LINES, with the lines it spans) and NLINES lines around it."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur"
msgid ""
"Show all lines in the current buffer containing a match for REGEXP, in the *Occur* buffer.\n"
"With a numeric prefix argument NLINES, also show NLINES lines of context around each match.\n"
"In the *Occur* buffer, RET goes to the match on the current line."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur--current-target"
msgid "Return (SOURCE POSITION) of the occurrence on the current line of the *Occur* buffer, or #f."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur-mode-goto-occurrence"
msgid "Go to the occurrence on the current line of the *Occur* buffer."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur-next"
msgid "Move to the next occurrence in the *Occur* buffer."
msgstr ""

#: lisp/replace.scm
msgctxt "function:occur-prev"
msgid "Move to the previous occurrence in the *Occur* buffer."
msgstr ""

#: lisp/replace.scm
msgctxt "variable:hi-lock-face-defaults"
msgid "Default face names for the hi-lock commands."
msgstr ""

#: lisp/replace.scm
msgctxt "function:hi-lock--next-face"
msgid "Return the next face of `hi-lock-face-defaults', cycling through them."
msgstr ""

#: lisp/replace.scm
msgctxt "function:highlight-regexp"
msgid ""
"Highlight each match of REGEXP in the current buffer with FACE (SUBEXP selects a group).\n"
"Interactively, read REGEXP and use the next face of `hi-lock-face-defaults'."
msgstr ""

#: lisp/replace.scm
msgctxt "function:unhighlight-regexp"
msgid ""
"Remove the highlighting of REGEXP set by `highlight-regexp'.\n"
"With #t, or with a prefix argument interactively, remove all of it."
msgstr ""

#: lisp/replace.scm
msgctxt "function:highlight-phrase"
msgid "Highlight each match of PHRASE, in which any run of white space matches any other."
msgstr ""

#: lisp/replace.scm
msgctxt "function:hi-lock--symbol-at-point"
msgid "Return the symbol at or next to point, or #f."
msgstr ""

#: lisp/replace.scm
msgctxt "function:highlight-symbol-at-point"
msgid "Highlight each occurrence of the symbol at point."
msgstr ""

#: lisp/replace.scm
msgctxt "function:highlight-lines-matching-regexp"
msgid "Highlight the lines that match REGEXP."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:last-command"
msgid ""
"The name (a symbol) of the previous command.\n"
"A command can look at it, for example to append a kill to the previous one."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:this-command"
msgid ""
"The name (a symbol) of the running command.\n"
"A command can set it, so that the next command sees it as last-command."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:temporary-goal-column"
msgid "The column that next-line and previous-line try to stay in."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:pending-undo-list"
msgid "The undo records that are not undone yet, while undo is repeated."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:simple--interactive"
msgid "True while a command is run from the keyboard (the terminal app sets it), like called-interactively-p."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--allow-extend"
msgid "Return the ALLOW-EXTEND argument of a mark command: the second of ARGS, or true when called from the keyboard."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--arg"
msgid "Return the first of ARGS, or the numeric value of the prefix argument if ARGS is empty."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:goal-column"
msgid ""
"The goal column of next-line and previous-line, or #f.\n"
"If it is a number, those commands move to that column of the line they move to."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--raw-arg"
msgid "Return the first of ARGS, or the raw prefix argument (#f, a number, - or a list like (4)) if ARGS is empty."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-char"
msgid ""
"Move point N characters forward (backward if N is negative).\n"
"N is the prefix argument, or 1.  Signal an error at the end of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-char"
msgid ""
"Move point N characters backward (forward if N is negative).\n"
"N is the prefix argument, or 1.  Signal an error at the beginning of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:left-char"
msgid ""
"Move point N characters to the left (to the right if N is negative).\n"
"The text is written from left to right, so this is backward-char."
msgstr ""

#: lisp/simple.scm
msgctxt "function:right-char"
msgid ""
"Move point N characters to the right (to the left if N is negative).\n"
"The text is written from left to right, so this is forward-char."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--move-line"
msgid ""
"Move point N lines, one line at a time, and to the goal column.\n"
"Signal an error if there are not N lines: point is then at the end of the buffer\n"
"(moving down) or at the beginning of the buffer (moving up)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:next-line"
msgid ""
"Move point to the next line, staying in the same column if possible.\n"
"If goal-column is a number, move to that column instead.  Signal an error at the last line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:previous-line"
msgid ""
"Move point to the previous line, staying in the same column if possible.\n"
"If goal-column is a number, move to that column instead.  Signal an error at the first line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:set-goal-column"
msgid ""
"Set the current column as the goal column of next-line and previous-line.\n"
"With an argument, clear the goal column."
msgstr ""

#: lisp/simple.scm
msgctxt "function:move-beginning-of-line"
msgid ""
"Move point to the beginning of the line.\n"
"With argument N other than 1, move forward N - 1 lines first."
msgstr ""

#: lisp/simple.scm
msgctxt "function:move-end-of-line"
msgid ""
"Move point to the end of the line.\n"
"With argument N other than 1, move forward N - 1 lines first.\n"
"If there are not that many lines above, go to the beginning of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:back-to-indentation"
msgid "Move point to the first non-whitespace character on this line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:beginning-of-buffer"
msgid ""
"Move point to the beginning of the buffer.\n"
"With numeric argument N, put point N/10 of the way from the beginning.\n"
"Push the mark at the previous position, unless the argument is a list like (4)\n"
"or the mark is active."
msgstr ""

#: lisp/simple.scm
msgctxt "function:end-of-buffer"
msgid ""
"Move point to the end of the buffer.\n"
"With numeric argument N, put point N/10 of the way from the end.\n"
"Push the mark at the previous position, unless the argument is a list like (4)\n"
"or the mark is active."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-word"
msgid "Move point forward over N words (backward if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-word"
msgid "Move point backward over N words (forward if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:left-word"
msgid ""
"Move point N words to the left (to the right if N is negative).\n"
"The text is written from left to right, so this is backward-word."
msgstr ""

#: lisp/simple.scm
msgctxt "function:right-word"
msgid ""
"Move point N words to the right (to the left if N is negative).\n"
"The text is written from left to right, so this is forward-word."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--goto-line"
msgid ""
"Go to the line given by ARGS (or the prefix argument, or read with PROMPT).\n"
"If RELATIVE, count from the beginning of the accessible part; otherwise widen first, then\n"
"widen the buffer for good if the line is outside the accessible part."
msgstr ""

#: lisp/simple.scm
msgctxt "function:goto-line"
msgid ""
"Go to line N, counting from line 1 at the beginning of the buffer.\n"
"N is the argument or the numeric prefix argument; otherwise read it in the minibuffer.\n"
"Push the mark at the previous position, unless the mark is active.\n"
"If the line is outside the narrowed part, widen the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:goto-line-relative"
msgid ""
"Go to line N, counting from the line at the beginning of the accessible part.\n"
"N is the argument or the numeric prefix argument; otherwise read it in the minibuffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:scroll-up-command"
msgid ""
"Scroll the text of the window up by almost one window height.\n"
"Signal an error at the end of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:scroll-down-command"
msgid ""
"Scroll the text of the window down by almost one window height.\n"
"Signal an error at the beginning of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:recenter-top-bottom"
msgid "Put the line of point in the middle of the window."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:indent-tabs-mode"
msgid "Non-nil means indentation can use tab characters."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:fill-prefix"
msgid "The string that is inserted after a line break in filled text, or #f."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--spaces"
msgid "Return a string of N spaces (the empty string if N is not positive)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--indent-to"
msgid "Insert tabs (if indent-tabs-mode) and spaces so that point gets to COLUMN."
msgstr ""

#: lisp/simple.scm
msgctxt "function:move-to-column"
msgid ""
"Move point to column COLUMN in the current line, and return the column where it ends up.\n"
"The column of a tab or a wide character can be beyond COLUMN.\n"
"If the optional second argument FORCE is #t and the line is too short, add spaces (and tabs if\n"
"indent-tabs-mode) at the end of the line to reach COLUMN.  If FORCE is another true value and COLUMN\n"
"is in the middle of a tab, change the tab into spaces."
msgstr ""

#: lisp/simple.scm
msgctxt "function:newline"
msgid ""
"Insert N newlines.  N is the prefix argument, or 1.\n"
"Signal an error if N is negative."
msgstr ""

#: lisp/simple.scm
msgctxt "function:open-line"
msgid "Insert N newlines and leave point before them.  N is the prefix argument, or 1."
msgstr ""

#: lisp/simple.scm
msgctxt "function:split-line"
msgid ""
"Split the current line, moving the part beyond point to a new line below.\n"
"The new line gets the same indentation as the column of point."
msgstr ""

#: lisp/simple.scm
msgctxt "function:indent-for-tab-command"
msgid ""
"Indent the current line or the region, or insert whitespace at point.\n"
"In a Lisp buffer, fix the indentation of the line; with an active region, indent the region.\n"
"Elsewhere, move to the next indent point of the previous line (indent-relative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:indent-region"
msgid ""
"Indent each nonblank line in the region (the lines from START to END).\n"
"Without arguments, the region is used."
msgstr ""

#: lisp/simple.scm
msgctxt "function:indent-sexp"
msgid "Indent each line of the list starting just after point (Lisp buffers only)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:indent-rigidly"
msgid ""
"Indent all lines starting in the region by ARG columns (the prefix argument, default 1).\n"
"Without START and END, the region is used."
msgstr ""

#: lisp/simple.scm
msgctxt "function:tab-to-tab-stop"
msgid "Insert whitespace at point, then move to the next tab stop (a multiple of 8 columns)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:set-fill-prefix"
msgid ""
"Set the fill prefix to the current line up to point.\n"
"At the beginning of a line, cancel the fill prefix."
msgstr ""

#: lisp/simple.scm
msgctxt "function:fill-paragraph"
msgid "Fill the paragraph at or after point (the comment paragraph in a Lisp buffer)."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:comment-column"
msgid "Column to indent a comment to."
msgstr ""

#: lisp/simple.scm
msgctxt "function:comment-dwim"
msgid "Comment or uncomment the region, or insert a comment or move to the one on this line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:comment-line"
msgid ""
"Comment or uncomment the current line, then move to the next line.\n"
"With an active region, comment or uncomment the lines it covers instead."
msgstr ""

#: lisp/simple.scm
msgctxt "function:comment-set-column"
msgid "Set the comment column to the argument, or to the current column."
msgstr ""

#: lisp/simple.scm
msgctxt "function:default-indent-new-line"
msgid ""
"Break the line at point and delete the spaces around the break.\n"
"The new line is not indented yet: indentation comes with the indentation commands."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-char"
msgid ""
"Delete the following N characters (previous if N is negative).\n"
"Optional second arg KILLFLAG non-nil means to kill (save in kill ring) instead of delete.\n"
"Interactively, N is the prefix argument, and KILLFLAG is true if there is a prefix argument."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-forward-char"
msgid "Delete the N characters after point (the N characters before point if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-backward-char"
msgid "Delete the N characters before point (the N characters after point if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--delete-space"
msgid "Delete the characters of CHARS around point (only before point if BACKWARD-ONLY is true)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-horizontal-space"
msgid ""
"Delete all spaces and tabs around point.\n"
"With an argument, delete them only before point."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--fixup-whitespace"
msgid "Fix up white space between objects around point: leave no space or one space."
msgstr ""

#: lisp/simple.scm
msgctxt "function:just-one-space"
msgid ""
"Delete all spaces and tabs around point, leaving one space (or N spaces).\n"
"If N is negative, delete newlines as well, leaving -N spaces."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:simple--cycle-context"
msgid "The state of cycle-spacing: (original-point whitespace-string n last-action)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--cycle-restore"
msgid "Put back the white space cycle-spacing found."
msgstr ""

#: lisp/simple.scm
msgctxt "function:cycle-spacing"
msgid ""
"Manipulate the white space around point in a cycle.\n"
"The first call leaves one space (just-one-space), the second deletes all the\n"
"white space, and the third restores it.  Repeat the command to cycle."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-indentation"
msgid ""
"Join this line to the previous one and fix up the white space at the join.\n"
"With an argument, join the current line to the following line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-blank-lines"
msgid ""
"On a blank line, delete all the surrounding blank lines, leaving just one.\n"
"On an isolated blank line, delete that one.\n"
"On a nonblank line, delete any blank lines that follow it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--kill"
msgid ""
"Delete the text between FROM and TO and save it in the kill ring.\n"
"If the previous command was a kill, append the text to its kill."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-region"
msgid ""
"Kill the text between point and the mark, or between the two positions FROM and TO.\n"
"The killed text is saved in the kill ring."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-ring-save"
msgid "Save the text between point and the mark in the kill ring, without killing it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-line"
msgid ""
"Kill the rest of the line; if there are no nonblanks there, kill through the newline.\n"
"With an argument N, kill that many lines from point; a negative N kills backward,\n"
"and 0 kills the text before point on the line.  Signal an error at the end of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--marker"
msgid "Return where POSITION is after the text from FROM to TO was deleted."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-whole-line"
msgid ""
"Kill the current line, with its newline.\n"
"With an argument N, kill that many lines from the current line; a negative N kills\n"
"backward, also killing the preceding newline.  With 0, kill the line without its newline."
msgstr ""

#: lisp/simple.scm
msgctxt "function:start-kbd-macro"
msgid ""
"Record subsequent keyboard input, defining a keyboard macro.\n"
"The commands are recorded even as they are executed.\n"
"With a prefix argument (or APPEND), append to the last macro instead of starting a new one."
msgstr ""

#: lisp/simple.scm
msgctxt "function:end-kbd-macro"
msgid ""
"Finish defining a keyboard macro.\n"
"The definition was started by start-kbd-macro.  The macro is now available for use with\n"
"call-last-kbd-macro.  With numeric arg, repeat the macro now that many times, counting the\n"
"definition just completed as the first repetition.  An argument of zero means repeat until error."
msgstr ""

#: lisp/simple.scm
msgctxt "function:call-last-kbd-macro"
msgid ""
"Call the last keyboard macro that you defined.\n"
"A prefix argument serves as a repeat count.  Zero means repeat until error."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:kmacro-counter"
msgid "Current keyboard macro counter."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:kmacro-last-counter"
msgid "Last counter inserted by `kmacro-insert-counter'."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:kmacro-counter-format"
msgid "Format to use when inserting the keyboard macro counter."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-start-macro"
msgid ""
"Record subsequent keyboard input, defining a keyboard macro.\n"
"Without a prefix argument, the counter is reset to 0.  With a numeric prefix argument, the\n"
"counter is set to it.  With C-u, append to the last macro and keep the counter."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-insert-counter"
msgid ""
"Insert the next value of the keyboard macro counter and increment it.\n"
"With a numeric prefix argument, increment by that amount.  With C-u, insert the previous\n"
"value without incrementing."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-start-macro-or-insert-counter"
msgid "Start defining a keyboard macro, or insert the counter if one is being defined."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-end-macro"
msgid ""
"Finish defining a keyboard macro.\n"
"With numeric arg, repeat the macro now that many times, counting the definition just\n"
"completed as the first repetition.  An argument of zero means repeat until error."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-end-and-call-macro"
msgid ""
"Call the last keyboard macro, ending the definition first if one is in progress.\n"
"A prefix argument serves as a repeat count; zero means repeat until error."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-end-or-call-macro"
msgid "End the keyboard macro being defined, or call the last one."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kmacro-name-last-macro"
msgid "Assign a name to the last keyboard macro defined."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--casify-region"
msgid "Convert the text between point and the mark, or between the two positions in ARGS, with MODE."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--casify-word"
msgid ""
"Convert the N words after point (before point if N is negative) with MODE.\n"
"Point moves to the end of the converted text, except for a negative N."
msgstr ""

#: lisp/simple.scm
msgctxt "function:upcase-region"
msgid ""
"Convert the region to upper case.\n"
"Called from Lisp with the two positions BEG and END, convert the text between them."
msgstr ""

#: lisp/simple.scm
msgctxt "function:downcase-region"
msgid ""
"Convert the region to lower case.\n"
"Called from Lisp with the two positions BEG and END, convert the text between them."
msgstr ""

#: lisp/simple.scm
msgctxt "function:upcase-initials-region"
msgid ""
"Upcase the initial of each word in the region.\n"
"Subsequent letters of each word are not changed.\n"
"Called from Lisp with the two positions BEG and END, convert the text between them."
msgstr ""

#: lisp/simple.scm
msgctxt "function:capitalize-region"
msgid ""
"Convert the region to capitalized form.\n"
"Capitalized form means each word's first character is upper case and the rest lower case.\n"
"Called from Lisp with the two positions BEG and END, convert the text between them."
msgstr ""

#: lisp/simple.scm
msgctxt "function:upcase-word"
msgid ""
"Convert to upper case from point to end of word, moving over.\n"
"With argument N, do this to that many words; a negative N converts the words before point\n"
"and leaves point where it is."
msgstr ""

#: lisp/simple.scm
msgctxt "function:downcase-word"
msgid ""
"Convert to lower case from point to end of word, moving over.\n"
"With argument N, do this to that many words; a negative N converts the words before point\n"
"and leaves point where it is."
msgstr ""

#: lisp/simple.scm
msgctxt "function:capitalize-word"
msgid ""
"Capitalize from point to the end of word, moving over.\n"
"With argument N, capitalize that many words; a negative N converts the words before point\n"
"and leaves point where it is."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-word"
msgid ""
"Kill the characters forward until the end of a word.\n"
"With argument N, kill that many words."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-kill-word"
msgid ""
"Kill the characters backward until the beginning of a word.\n"
"With argument N, kill that many words."
msgstr ""

#: lisp/simple.scm
msgctxt "function:zap-to-char"
msgid ""
"Kill up to and including the Nth occurrence of CHAR.\n"
"Interactively, N is the prefix argument and CHAR is read as a key."
msgstr ""

#: lisp/simple.scm
msgctxt "function:append-next-kill"
msgid ""
"Cause the following command, if it is a kill, to append to the previous kill.\n"
"Interactively, it takes effect after this command."
msgstr ""

#: lisp/simple.scm
msgctxt "function:ignore-preserving-kill-region"
msgid "Do nothing, but keep the kill that the previous command made for the next kill."
msgstr ""

#: lisp/simple.scm
msgctxt "function:yank"
msgid ""
"Insert the most recent kill at point, and leave the mark at the start of the text.\n"
"With a plain prefix argument (C-u), leave point at the start and the mark at the end.\n"
"With a number N, insert the Nth most recent kill; with -, the second most recent."
msgstr ""

#: lisp/simple.scm
msgctxt "function:yank-pop"
msgid ""
"Replace the text just yanked with the previous kill in the kill ring.\n"
"With an argument N, use the Nth previous kill.  Signal an error if the previous\n"
"command was not a yank."
msgstr ""

#: lisp/simple.scm
msgctxt "function:insert-buffer"
msgid ""
"Insert after point the contents of BUFFER, and leave point before it and the mark after it.\n"
"Interactively, read the name of BUFFER in the minibuffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--transpose"
msgid "Transpose the objects that MOVER moves over, as transpose-chars, transpose-words and transpose-lines do."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--transpose-pairs"
msgid "Transpose the objects whose start and end AUX returns (a list of two positions) for a direction."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--transpose-1"
msgid "Swap the text of the two regions POS1 and POS2, each a list (start end), keeping the markers at their ends."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-chars"
msgid ""
"Interchange the characters around point, and move point forward over them.\n"
"At the end of a line, the previous two characters are interchanged.\n"
"With argument N, drag the character before point forward over N other characters."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-words"
msgid ""
"Interchange the words around point, and move point over the second.\n"
"With argument N, drag the word before or around point forward over N other words."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-lines"
msgid ""
"Exchange the current line and the previous line, and leave point after both.\n"
"With argument N, move the previous line past N lines."
msgstr ""

#: lisp/simple.scm
msgctxt "function:quoted-insert"
msgid ""
"Read a character and insert it as it is, N times.\n"
"Only the keys that stand for one character can be inserted."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:set-mark-command-repeat-pop"
msgid "Non-nil means that repeating set-mark-command after popping a mark pops another one."
msgstr ""

#: lisp/simple.scm
msgctxt "function:push-mark-command"
msgid ""
"Set the mark at point; with an argument, set it even if it is already there.\n"
"If the mark is already at point, activate it instead.  The second argument\n"
"NOMSG, if true, suppresses the message."
msgstr ""

#: lisp/simple.scm
msgctxt "function:pop-to-mark-command"
msgid "Jump to the mark, and pop a new position for the mark off the mark ring."
msgstr ""

#: lisp/simple.scm
msgctxt "function:pop-global-mark"
msgid "Pop off the global mark ring and jump to the top location."
msgstr ""

#: lisp/simple.scm
msgctxt "function:set-mark-command"
msgid ""
"Set the mark where point is, and activate it; or jump to the mark.\n"
"With a plain prefix argument (C-u), jump to the mark and pop the mark ring.\n"
"With C-u C-u, set the mark and activate it without the special cases.\n"
"Repeated, it activates or deactivates the mark."
msgstr ""

#: lisp/simple.scm
msgctxt "function:exchange-point-and-mark"
msgid ""
"Put the mark where point is now, and point where the mark is now.\n"
"The mark is activated, unless there is an argument (which deactivates it)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-whole-buffer"
msgid "Put point at the beginning and the mark at the end of the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-word"
msgid ""
"Set the mark at the end of the next word, or extend the region by a word.\n"
"With argument N, do it for N words (backward if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:keyboard-quit"
msgid "Deactivate the mark and cancel the running command by signaling a quit."
msgstr ""

#: lisp/simple.scm
msgctxt "function:keyboard-escape-quit"
msgid ""
"Exit the current mode in a general sense: deactivate the region, clear a prefix\n"
"argument, or go back to just one window."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:prefix-arg"
msgid "The prefix argument for the next command: #f, a number, the symbol -, or a list like (4)."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:last-command-event"
msgid "The key (a string such as \"5\" or \"M-5\") that ran the command."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:universal-argument-mode"
msgid "True while the keys 0-9, - and C-u make up a prefix argument (the universal-argument-map)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--prefix-state"
msgid "Pass the prefix command state to the next command: it will see the previous last-command."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--event-digit"
msgid "Return the digit of the key that ran the command (the last character of last-command-event)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:universal-argument"
msgid ""
"Begin a numeric argument for the following command.\n"
"Digits or minus sign following it make up the numeric argument.\n"
"C-u without digits or minus sign provides 4 as argument."
msgstr ""

#: lisp/simple.scm
msgctxt "function:universal-argument-more"
msgid "Multiply the prefix argument by 4 (C-u after C-u), or end the argument after digits."
msgstr ""

#: lisp/simple.scm
msgctxt "function:digit-argument"
msgid "Part of the numeric argument for the next command: add the digit of the key."
msgstr ""

#: lisp/simple.scm
msgctxt "function:negative-argument"
msgid "Begin a negative numeric argument for the next command, or negate it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--single-key-description"
msgid "Return how Emacs writes the ASCII character CHAR as a key, such as C-a or SPC."
msgstr ""

#: lisp/simple.scm
msgctxt "function:what-cursor-position"
msgid ""
"Print information about the cursor position in the echo area:\n"
"the character after point with its codes, the position, and the column.\n"
"In a narrowed buffer, also show the accessible range as <BEG-END>."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--round-percent"
msgid "Return 100 * N / TOTAL rounded to the nearest integer, ties to even (like Emacs round)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--count-lines"
msgid "Return the number of lines between START and END."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--count-words"
msgid "Return the number of words between START and END."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--count-sentences"
msgid "Return the number of sentences between START and END."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--count-words-format"
msgid "Return the message about the lines, sentences, words and characters between START and END."
msgstr ""

#: lisp/simple.scm
msgctxt "function:count-words-region"
msgid ""
"Print the number of lines, sentences, words and characters in the region.\n"
"With a prefix argument, report on the whole buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:fill-column"
msgid "The column beyond which automatic line breaking should happen."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:truncate-lines"
msgid "Non-nil means do not display continuation lines: give each line one row, cut at the window edge."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:selective-display"
msgid "A number N means that lines indented by N columns or more are not displayed."
msgstr ""

#: lisp/simple.scm
msgctxt "function:set-fill-column"
msgid "Set fill-column to the argument.  With C-u, use the current column."
msgstr ""

#: lisp/simple.scm
msgctxt "function:toggle-truncate-lines"
msgid ""
"Toggle truncating of long lines for the current buffer.\n"
"With a positive argument, truncate; with zero or a negative one, wrap."
msgstr ""

#: lisp/simple.scm
msgctxt "function:set-selective-display"
msgid ""
"Set selective-display to the argument; clear it if there is none.\n"
"When it is a number, lines indented by that many columns or more are not displayed."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:simple--undo-equiv"
msgid ""
"Which undo lists were made by undo: a list of (length value).\n"
"The value is what is left to undo (a list, #t or empty).  It is keyed by the length of the undo list."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--skip-boundaries"
msgid "Return the undo list UL without the boundaries (#f) at its front."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--equiv-ref"
msgid "Return what undo recorded for the undo list UL, or #f."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--equiv-set"
msgid "Record VALUE for the undo list UL."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--last-change-was-undo-p"
msgid "Return what undo recorded if the last change in UNDO-LIST was made by undo, else #f."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--undo-more"
msgid "Undo N more groups of changes from the pending undo list."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--drop-point-records"
msgid "Return the undo list UL without the position records that undo made in its newest group."
msgstr ""

#: lisp/simple.scm
msgctxt "function:undo"
msgid ""
"Undo some previous changes.  Repeat the command to undo more.\n"
"With a number N, undo N groups of changes.  After the other commands, the\n"
"undo starts again from the newest change, so undoing an undo redoes the change."
msgstr ""

#: lisp/simple.scm
msgctxt "function:undo-redo"
msgid "Undo the last N undos, that is redo the last N changes that were undone."
msgstr ""

#: lisp/simple.scm
msgctxt "function:split-window-below"
msgid "Split the selected window into two windows, one above the other."
msgstr ""

#: lisp/simple.scm
msgctxt "function:split-window-right"
msgid "Split the selected window into two windows side by side."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-window"
msgid "Delete the selected window, or the window given as the argument."
msgstr ""

#: lisp/simple.scm
msgctxt "function:delete-other-windows"
msgid "Make the selected window fill the screen."
msgstr ""

#: lisp/simple.scm
msgctxt "function:other-window"
msgid "Select another window.  With argument N, select the Nth window after this one."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--modified-file-buffers"
msgid "Return the names of the buffers that visit a file and are modified."
msgstr ""

#: lisp/simple.scm
msgctxt "function:save-buffers-kill-terminal"
msgid ""
"Offer to save the modified buffers, and exit the editor.\n"
"Ask once more if modified buffers remain."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--symbol-constituent-at"
msgid "True if the character at POS has word or symbol syntax (Emacs \\sw\\|\\s_)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--transpose-sexps-pair"
msgid "Return the start and end of the sexp to transpose in the direction ARG (Emacs transpose-sexps-default-function)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-sexps"
msgid ""
"Like transpose-chars, but applies to sexps.  Point must be between the two sexps.\n"
"With argument N, drag the sexp before point forward past N other sexps (backward if negative).\n"
"With zero, interchange the sexps ending at or after point and at or after mark."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-sentences"
msgid ""
"Interchange the current sentence with the next one.\n"
"With argument N, move the current sentence past N sentences."
msgstr ""

#: lisp/simple.scm
msgctxt "function:transpose-paragraphs"
msgid ""
"Interchange the current paragraph with the next one.\n"
"With argument N, move the current paragraph past N paragraphs."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:simple--page-mark"
msgid "The form feed character that starts a page boundary line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--page-forward-search"
msgid "Move point past the next page delimiter (a form feed at the start of a line); return false if none."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--page-backward-search"
msgid "Move point to the start of the previous page delimiter; return false if none."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-page"
msgid ""
"Move forward to page boundary.  With argument N, repeat, or go back if negative.\n"
"A page boundary is a line that starts with a form feed."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-page"
msgid "Move backward to page boundary.  With argument N, repeat, or go forward if negative."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-page"
msgid ""
"Put the mark at the end of the page and point at the beginning.\n"
"With argument N, mark the page N pages forward (backward if negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:narrow-to-region"
msgid ""
"Restrict editing in this buffer to the current region.\n"
"The rest of the text becomes temporarily invisible and unchangeable.\n"
"Called from Lisp with START and END, restrict to that range instead."
msgstr ""

#: lisp/simple.scm
msgctxt "function:widen"
msgid ""
"Remove restrictions (narrowing) from the current buffer.\n"
"This allows the buffer's full text to be seen and edited."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--page-delimiter-p"
msgid "Return true if point is at a page delimiter: a form feed at the start of a line."
msgstr ""

#: lisp/simple.scm
msgctxt "function:narrow-to-page"
msgid ""
"Make text outside current page invisible.\n"
"A numeric argument specifies to move forward or backward by that many pages,\n"
"thus showing a page other than the one point was originally in."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:narrow-to-defun-include-comments"
msgid "Whether narrow-to-defun includes the comments before a defun."
msgstr ""

#: lisp/simple.scm
msgctxt "function:narrow-to-defun"
msgid ""
"Make text outside current defun invisible.\n"
"The current defun is the one that contains point or follows point.\n"
"Preceding comments are included if INCLUDE-COMMENTS is true.\n"
"Called from the keyboard, use the value of narrow-to-defun-include-comments."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--page-line-counts"
msgid "Return (TOTAL BEFORE AFTER): the number of lines on the current page, before point and after point."
msgstr ""

#: lisp/simple.scm
msgctxt "function:count-lines-page"
msgid "Report number of lines on current page, and how many are before or after point."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--forward-sexp"
msgid "Move forward across N sexps, signalling the scan error as is."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-sexp"
msgid ""
"Move forward across one balanced expression (sexp).\n"
"With argument N, do it N times; a negative N moves backward.\n"
"From the keyboard, report a failure as \"No next sexp\" or \"No previous sexp\"."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-sexp"
msgid ""
"Move backward across one balanced expression (sexp).\n"
"With argument N, do it N times; a negative N moves forward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-list"
msgid ""
"Move forward across one balanced group of parentheses.\n"
"With argument N, do it N times; a negative N moves backward.\n"
"From the keyboard, report a failure as \"No next group\" or \"No previous group\"."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-list"
msgid ""
"Move backward across one balanced group of parentheses.\n"
"With argument N, do it N times; a negative N moves forward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:down-list"
msgid ""
"Move forward down one level of parentheses.\n"
"With argument N, do this N times; a negative N moves backward but still goes down a level.\n"
"From the keyboard, report a failure as \"At bottom level\"."
msgstr ""

#: lisp/simple.scm
msgctxt "function:up-list"
msgid ""
"Move forward out of one level of parentheses.\n"
"With argument N, do this N times; a negative N moves backward.\n"
"Inside a string, move out of the string first."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-up-list"
msgid ""
"Move backward out of one level of parentheses.\n"
"With argument N, do this N times; a negative N moves forward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-sexp"
msgid ""
"Kill the sexp (balanced expression) following point.\n"
"With argument N, kill N sexps; a negative N kills backward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-kill-sexp"
msgid ""
"Kill the sexp (balanced expression) preceding point.\n"
"With argument N, kill N sexps; a negative N kills forward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--forward-sexp-to-select"
msgid "Return the end of N sexps from point; signal NONE if there is no sexp to select."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-sexp"
msgid ""
"Set the mark at the end of the next sexp, or extend the region by one sexp.\n"
"With argument N, do it for N sexps (backward if N is negative)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--push-mark-for-defun"
msgid "Push the mark before a defun motion NAME, unless it repeats NAME or the region is active."
msgstr ""

#: lisp/simple.scm
msgctxt "function:beginning-of-defun"
msgid ""
"Move backward to the beginning of a defun (an open paren in column 0).\n"
"With argument N, do it N times.  Push the mark first, unless repeated."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--end-of-defun"
msgid "Move forward N defuns.  If SCAN-ERRORS, an unbalanced defun signals the scan error that Lisp code sees."
msgstr ""

#: lisp/simple.scm
msgctxt "function:end-of-defun"
msgid ""
"Move forward to the end of a defun.  With argument N, do it N times.\n"
"Push the mark first, unless repeated."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-defun"
msgid ""
"Put the region around the current defun, including the comments before it.\n"
"If the region is active, extend it to the end of the next defun."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-paragraph"
msgid ""
"Move forward to the end of the paragraph.  With argument N, do it N times;\n"
"a negative N moves backward to the start of the paragraph."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-paragraph"
msgid "Move backward to the start of the paragraph.  With argument N, do it N times."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-paragraph"
msgid ""
"Put the mark at the end of this paragraph, point at the beginning.\n"
"If the region is active, extend it by one more paragraph."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-paragraph"
msgid "Kill forward to the end of the paragraph.  With argument N, kill N paragraphs."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-kill-paragraph"
msgid "Kill back to the start of the paragraph.  With argument N, kill N paragraphs."
msgstr ""

#: lisp/simple.scm
msgctxt "function:forward-sentence"
msgid ""
"Move forward to next end of sentence.  With argument N, do it N times;\n"
"a negative N moves backward to the start of the sentence."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-sentence"
msgid "Move backward to the start of the sentence.  With argument N, do it N times."
msgstr ""

#: lisp/simple.scm
msgctxt "function:kill-sentence"
msgid "Kill from point to the end of the current sentence.  With argument N, kill N sentences."
msgstr ""

#: lisp/simple.scm
msgctxt "function:backward-kill-sentence"
msgid "Kill back from point to the start of the sentence.  With argument N, kill N sentences."
msgstr ""

#: lisp/simple.scm
msgctxt "function:mark-end-of-sentence"
msgid "Put the mark at the end of this sentence.  With argument N, N sentences forward."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--command-names"
msgid "Return the names of all commands, sorted."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:command-history"
msgid "The commands run with M-x, newest first, each written as an expression such as \"(forward-char)\"."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--remember-command"
msgid "Put the command NAME on the front of command-history, unless it is already there."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--run-named-command"
msgid "Read a command name with PROMPT, remember it, and run it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:execute-extended-command"
msgid "Read a command name in the minibuffer, with completion, and run it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:execute-extended-command-for-buffer"
msgid ""
"Read a command name in the minibuffer, with completion, and run it.\n"
"Unlike Emacs, every command is offered, not only those that fit the major mode."
msgstr ""

#: lisp/simple.scm
msgctxt "function:repeat-complex-command"
msgid ""
"Edit and re-evaluate the last command run with M-x.\n"
"With the argument N, use the Nth previous command (1 is the last)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--remember-command-expression"
msgid "Put EXPRESSION on the front of command-history, unless it is already there."
msgstr ""

#: lisp/simple.scm
msgctxt "function:eval-expression"
msgid "Read an expression in the minibuffer, evaluate it, and show the value."
msgstr ""

#: lisp/simple.scm
msgctxt "function:eval-last-sexp"
msgid "Evaluate the sexp before point and show its value in the echo area."
msgstr ""

#: lisp/simple.scm
msgctxt "function:electric-newline-and-maybe-indent"
msgid ""
"Insert a newline without indenting it, as `electric-indent-mode' makes C-j do.\n"
"With argument N, insert N newlines."
msgstr ""

#: lisp/simple.scm
msgctxt "function:abort-recursive-edit"
msgid "Abort the command that requested this recursive edit or minibuffer input."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:parens-require-spaces"
msgid ""
"If true, add whitespace as needed when inserting parentheses.\n"
"This affects `insert-parentheses'."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--insert-pair"
msgid "Enclose following sexps in OPEN and CLOSE as `insert-parentheses' does for the prefix argument RAW."
msgstr ""

#: lisp/simple.scm
msgctxt "function:insert-parentheses"
msgid ""
"Enclose following ARG sexps in parentheses.\n"
"Leave point after open-paren.\n"
"A negative ARG encloses the preceding ARG sexps instead.\n"
"No argument is equivalent to zero: just insert `()' and leave point between.\n"
"If `parens-require-spaces' is true, this command also inserts a space\n"
"before and after, depending on the surrounding characters.\n"
"If region is active, insert enclosing characters at region boundaries.\n"
"\n"
"This command assumes point is not in a string or comment."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--newline-and-indent"
msgid "Delete the horizontal space before point, insert a newline, and indent the new line (not the previous one)."
msgstr ""

#: lisp/simple.scm
msgctxt "function:move-past-close-and-reindent"
msgid "Move past next `)', delete indentation before it, then indent after it."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:shell-command-buffer-name"
msgid "Name of the output buffer for shell commands."
msgstr ""

#: lisp/simple.scm
msgctxt "variable:shell-command-buffer-name-async"
msgid "Name of the output buffer for asynchronous shell commands."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--max-mini-window-lines"
msgid "Return the number of lines the echo area may use before a buffer is displayed instead."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--nth"
msgid "Return the Nth element of ARGS (from 0), or #f if there are not that many."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--screen-lines"
msgid "Return the number of screen lines TEXT takes in WIDTH columns."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--display-message-or-buffer"
msgid "Show the text of the buffer NAME in the echo area if it is short, otherwise display the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--call-shell-region"
msgid ""
"Run COMMAND with the text from START to END as input, and insert the output at point.\n"
"If DELETE is true, delete that text first.  Return the exit code."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--shell-report"
msgid "Report an EXIT-STATUS of a shell command that printed no output."
msgstr ""

#: lisp/simple.scm
msgctxt "function:shell-command-on-region"
msgid ""
"Execute string COMMAND in inferior shell with region as input.\n"
"Normally display output (if any) in temp buffer `*Shell Command Output*';\n"
"Prefix arg means replace the region with it.  Return the exit code of COMMAND.\n"
"\n"
"Called from Lisp with START, END, COMMAND, OUTPUT-BUFFER and REPLACE (and the unused\n"
"ERROR-BUFFER and DISPLAY-ERROR-BUFFER).  If OUTPUT-BUFFER is a buffer name, erase that buffer and\n"
"insert the output there; if it is another non-nil value, replace the region with the output.\n"
"If REPLACE is non-nil, delete the region and insert the output in its place."
msgstr ""

#: lisp/simple.scm
msgctxt "function:shell-command"
msgid ""
"Execute string COMMAND in inferior shell; display output, if any.\n"
"With prefix argument, insert the COMMAND's output at point.\n"
"If COMMAND ends in `&', execute it asynchronously (this editor runs it to the end first, and\n"
"shows its output in `*Async Shell Command*').\n"
"The output appears in the buffer `*Shell Command Output*'.  If the output is short enough to\n"
"display in the echo area, it is shown there.\n"
"\n"
"The optional second argument OUTPUT-BUFFER, if non-nil, says to put the output in some other\n"
"buffer.  If OUTPUT-BUFFER is a buffer name, erase that buffer and insert the output there.  If it\n"
"is not a buffer name and not nil (which happens interactively when the prefix argument is\n"
"given), insert the output in the current buffer after point leaving mark after it."
msgstr ""

#: lisp/simple.scm
msgctxt "function:async-shell-command"
msgid ""
"Execute string COMMAND asynchronously in background.\n"
"Like `shell-command', but adds `&' at the end of COMMAND to execute it asynchronously.\n"
"The output appears in the buffer `*Async Shell Command*'.\n"
"In this editor the command is run to the end before the next command is read."
msgstr ""

#: lisp/simple.scm
msgctxt "function:rename-buffer"
msgid ""
"Change current buffer's name to NEWNAME (a string).\n"
"If second arg UNIQUE is nil or omitted, it is an error if a buffer named NEWNAME already exists.\n"
"If UNIQUE is non-nil, come up with a new name using `generate-new-buffer-name'.\n"
"Interactively, you can set UNIQUE with a prefix argument.\n"
"Return the name actually given to the buffer."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--clone-name"
msgid "Return NAME without a trailing <N>."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--clone-buffer"
msgid "Create a twin copy of the current buffer named after NEWNAME, and return its name."
msgstr ""

#: lisp/simple.scm
msgctxt "function:clone-buffer"
msgid ""
"Create and return a twin copy of the current buffer.\n"
"Unlike an indirect buffer, the new buffer can be edited independently of the old one.\n"
"NEWNAME is the name of the new buffer.  It may be modified by adding or incrementing <N> at the\n"
"end as necessary to create a unique buffer name.  If nil, it defaults to the name of the current\n"
"buffer, with the proper suffix.  If DISPLAY-FLAG is non-nil, the new buffer is shown in another\n"
"window.  Trying to clone a file-visiting buffer results in an error.\n"
"Interactively, DISPLAY-FLAG is t and NEWNAME is the name of the current buffer with appropriate\n"
"suffix.  However, if a prefix argument is given, then the command prompts for NEWNAME."
msgstr ""

#: lisp/simple.scm
msgctxt "function:clone-indirect-buffer-other-window"
msgid ""
"Like `clone-buffer' but display in another window and select it.\n"
"This editor has no indirect buffers: the new buffer is a twin copy whose text is not shared."
msgstr ""

#: lisp/simple.scm
msgctxt "function:simple--mode-arg"
msgid "Return what a minor mode command does for ARGS: 1 to enable, 0 to disable, or toggle."
msgstr ""

#: lisp/simple.scm
msgctxt "function:read-only-mode"
msgid ""
"Change whether the current buffer is read-only.\n"
"With no argument (or `toggle'), toggle it.  With a positive argument, make the buffer read-only;\n"
"with zero or a negative argument, make it writable."
msgstr ""

#: lisp/subr.scm
msgctxt "function:y-or-n-p"
msgid ""
"Ask the user a y or n question, and return #t if the answer is y.\n"
"PROMPT is followed by \"(y or n) \". y or SPC means yes, and n or DEL means no.\n"
"Other keys ask again."
msgstr ""

#: lisp/subr.scm
msgctxt "function:yes-or-no-p"
msgid ""
"Ask the user a yes or no question, and return #t if the answer is yes.\n"
"PROMPT is followed by \"(yes or no) \". The answer must be typed in full, and ended with RET.\n"
"Other answers ask again."
msgstr ""

#: lisp/subr.scm
msgctxt "function:file-name-directory"
msgid ""
"Return the directory part of FILENAME, up to and including the last /.\n"
"Return #f if FILENAME has no /."
msgstr ""

#: lisp/subr.scm
msgctxt "function:file-name-nondirectory"
msgid "Return the file name of FILENAME without its directory part."
msgstr ""

#: lisp/subr.scm
msgctxt "function:shell-quote-argument"
msgid "Quote ARGUMENT for passing as argument to an inferior shell."
msgstr ""

#: lisp/subr.scm
msgctxt "function:display-warning"
msgid ""
"Display a warning message in the `*Warnings*' buffer, creating it if needed.\n"
"TYPE is a symbol or a list of symbols that says what the warning is about.\n"
"MESSAGE is the text.  The optional LEVEL (a symbol: debug, warning or error) is warning by default;\n"
"a debug warning is only added to the buffer, the other levels also show it in another window."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--other-buffer"
msgid "Return the name of a buffer other than the current one, or #f if there is none."
msgstr ""

#: lisp/window.scm
msgctxt "function:switch-to-buffer"
msgid ""
"Display buffer BUFFER-OR-NAME in the selected window.\n"
"If there is no buffer named BUFFER-OR-NAME, create one.\n"
"Interactively, read the name in the minibuffer with completion;\n"
"the default is another buffer."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--other-window-for-scrolling"
msgid "Return the window after the selected one, the one the scrolling commands act on."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--call-in-window"
msgid "Call THUNK with WINDOW selected, then select the window that was selected before."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--pop-to-buffer-other-window"
msgid "Show buffer NAME in another window (splitting if there is only one) and select that window."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--default-buffer-name"
msgid "Return the buffer name in ARGS, or read one (default: another buffer) with PROMPT."
msgstr ""

#: lisp/window.scm
msgctxt "function:switch-to-buffer-other-window"
msgid ""
"Select the buffer BUFFER-OR-NAME in another window.\n"
"If there is only one window, split it.  If there is no buffer named BUFFER-OR-NAME, create one."
msgstr ""

#: lisp/window.scm
msgctxt "function:display-buffer"
msgid ""
"Show buffer BUFFER-OR-NAME in some window, without selecting it.\n"
"If there is only one window, split it.  Interactively, read the name in the minibuffer."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--buffer-names"
msgid "Return the names of the buffers that `next-buffer' and `previous-buffer' may show."
msgstr ""

#: lisp/window.scm
msgctxt "function:next-buffer"
msgid ""
"In the selected window, switch to the next buffer in the buffer list.\n"
"With a numeric prefix argument N, switch N buffers forward."
msgstr ""

#: lisp/window.scm
msgctxt "function:previous-buffer"
msgid ""
"In the selected window, switch to the previous buffer in the buffer list.\n"
"With a numeric prefix argument N, switch N buffers back."
msgstr ""

#: lisp/window.scm
msgctxt "function:delete-windows-on"
msgid ""
"Delete all windows showing the buffer BUFFER-OR-NAME (default: the current buffer).\n"
"If it is the only window, show another buffer in it instead."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--show-buffer"
msgid "Show buffer NAME in WINDOW; if WINDOW is the selected one, make the buffer current too."
msgstr ""

#: lisp/window.scm
msgctxt "function:kill-buffer"
msgid ""
"Kill the buffer named by the argument.  Interactively, read the name in the minibuffer.\n"
"The default is the current buffer.  Ask before killing a modified file buffer.\n"
"Called from Lisp with a name, kill the buffer without asking (an error if it visits a modified file)."
msgstr ""

#: lisp/window.scm
msgctxt "function:kill-buffer-and-window"
msgid "Kill the current buffer and delete the selected window."
msgstr ""

#: lisp/window.scm
msgctxt "function:quit-window"
msgid ""
"Quit the selected window and bury its buffer.\n"
"If there are other windows, delete the window; otherwise show another buffer in it.\n"
"With a prefix argument, kill the buffer instead of burying it."
msgstr ""

#: lisp/window.scm
msgctxt "function:scroll-other-window"
msgid ""
"Scroll next window upward ARG lines; or near full screen if no ARG.\n"
"A negative ARG scrolls downward, and `-' means a screenful downward."
msgstr ""

#: lisp/window.scm
msgctxt "function:scroll-other-window-down"
msgid "Scroll the next window downward ARG lines; or near full screen if no ARG."
msgstr ""

#: lisp/window.scm
msgctxt "function:beginning-of-buffer-other-window"
msgid ""
"Move point to the beginning of the buffer in the next window.\n"
"With numeric argument N, put point N/10 of the way from the beginning."
msgstr ""

#: lisp/window.scm
msgctxt "function:end-of-buffer-other-window"
msgid ""
"Move point to the end of the buffer in the next window.\n"
"With numeric argument N, put point N/10 of the way from the end."
msgstr ""

#: lisp/window.scm
msgctxt "function:recenter-other-window"
msgid "Call `recenter-top-bottom' in the next window."
msgstr ""

#: lisp/window.scm
msgctxt "variable:window-min-height"
msgid "The minimum total height, in lines, of any window (the mode line included)."
msgstr ""

#: lisp/window.scm
msgctxt "function:split-root-window-below"
msgid "Split the whole screen into two windows, one above the other; the new one is at the bottom."
msgstr ""

#: lisp/window.scm
msgctxt "function:split-root-window-right"
msgid "Split the whole screen into two windows side by side; the new one is at the right."
msgstr ""

#: lisp/window.scm
msgctxt "function:balance-windows"
msgid "Make all windows the same height and width."
msgstr ""

#: lisp/window.scm
msgctxt "function:enlarge-window"
msgid ""
"Make the selected window ARG lines taller (negative: shorter).\n"
"Take the lines from the neighbouring window."
msgstr ""

#: lisp/window.scm
msgctxt "function:shrink-window"
msgid "Make the selected window ARG lines shorter (negative: taller)."
msgstr ""

#: lisp/window.scm
msgctxt "function:enlarge-window-horizontally"
msgid "Make the selected window ARG columns wider (negative: narrower)."
msgstr ""

#: lisp/window.scm
msgctxt "function:shrink-window-horizontally"
msgid "Make the selected window ARG columns narrower (negative: wider)."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--buffer-lines"
msgid "Return the number of lines of text in the current buffer."
msgstr ""

#: lisp/window.scm
msgctxt "function:window--fit-height"
msgid "Return the total height, in lines, that shows all the text of the current buffer."
msgstr ""

#: lisp/window.scm
msgctxt "function:shrink-window-if-larger-than-buffer"
msgid ""
"Shrink the selected window if it is taller than its buffer's text.\n"
"Do nothing if there is only one window."
msgstr ""

#: lisp/window.scm
msgctxt "function:fit-window-to-buffer"
msgid ""
"Adjust the height of the selected window to show all the text of its buffer.\n"
"Do nothing if there is only one window."
msgstr ""

#: lisp/window.scm
msgctxt "variable:window--line-position"
msgid "Where `move-to-window-line-top-bottom' put point last: 0 middle, 1 top, 2 bottom."
msgstr ""

#: lisp/window.scm
msgctxt "function:move-to-window-line-top-bottom"
msgid ""
"Position point relative to the window: the middle, then the top, then the bottom.\n"
"With a numeric argument N, put point at the beginning of line N of the window\n"
"(negative: counted from the bottom)."
msgstr ""

#: lisp/window.scm
msgctxt "function:project-tree"
msgid "Show or hide the tree of the files of the project in the side bar."
msgstr ""

#: lisp/xref.scm
msgctxt "variable:xref--back-stack"
msgid "List of (BUFFER-NAME MARKER) to go back to, the latest first."
msgstr ""

#: lisp/xref.scm
msgctxt "variable:xref--forward-stack"
msgid "List of (BUFFER-NAME MARKER) to go forward to, the latest first."
msgstr ""

#: lisp/xref.scm
msgctxt "variable:xref-prompt-for-identifier"
msgid "If non-nil, `xref-find-definitions' always reads the identifier in the minibuffer."
msgstr ""

#: lisp/xref.scm
msgctxt "variable:xref-project-directory"
msgid "The directory `xref-find-references' searches."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--location"
msgid "Return (BUFFER-NAME MARKER) for point."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--push-marker-stack"
msgid "Remember the current location, for `xref-go-back'."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--jump"
msgid "Show the buffer of LOCATION in the selected window and put point at its marker."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-go-back"
msgid "Go back to the previous position in xref history."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-go-forward"
msgid "Go to the point where we previously were, before `xref-go-back'."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--identifier-at-point"
msgid "Return the symbol at or next to point, or #f."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--read-identifier"
msgid "Read an identifier with PROMPT; the default is the symbol at point."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--identifier"
msgid "Return the identifier ARGS name, the symbol at point, or one read with PROMPT."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--definition-regexp"
msgid "Return a regexp (for `grep') that matches the line that defines NAME."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--definition"
msgid "Return (FILE LINE) of the definition of NAME, or #f."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--goto-definition"
msgid "Go to the definition of NAME, in another window if OTHER-WINDOW."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-find-definitions"
msgid ""
"Find the definition of the identifier at point.\n"
"With a prefix argument, or if there is no identifier at point, read it in the minibuffer."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-find-definitions-other-window"
msgid "Like `xref-find-definitions' but switch to the other window."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--project-files"
msgid "Return the files below `xref-project-directory', not those in .git, target, or node_modules."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref--show"
msgid ""
"Show LINES (strings) under TITLE in the *xref* buffer, in another window; return the buffer name.\n"
"If LOCATIONS is not empty, the lines are `FILE:LINE:TEXT' and `next-error' visits them."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-find-references"
msgid ""
"Find references to the identifier at point.\n"
"With a prefix argument, or if there is no identifier at point, read it in the minibuffer.\n"
"The references are listed in the *xref* buffer as FILE:LINE:TEXT."
msgstr ""

#: lisp/xref.scm
msgctxt "function:xref-find-apropos"
msgid ""
"Find all meaningful symbols that match PATTERN, a regexp.\n"
"They are listed in the *xref* buffer as NAME (FILE)."
msgstr ""

#: lisp/xref.scm
msgctxt "function:help-find-source"
msgid ""
"Switch to the source of the function whose description is shown in *Help*, in another window.\n"
"Interactively, read the function name in the minibuffer."
msgstr ""
