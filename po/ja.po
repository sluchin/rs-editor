# Japanese translations of the docstrings of rs-editor.
# msgctxt is "function:NAME" or "variable:NAME"; msgid is the English docstring.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

#: lisp/files.scm
msgctxt "function:find-file"
msgid ""
"Edit file FILENAME.\n"
"Switch to a buffer visiting file FILENAME, creating one if none already exists.\n"
"Interactively, read FILENAME in the minibuffer with file name completion."
msgstr ""
"ファイル FILENAME を編集する。\n"
"FILENAME のファイルのバッファに切り替える (無ければ, 作る)。\n"
"対話的に呼ぶと, FILENAME をミニバッファで (ファイルの名前を補完しながら) 聞く。"

#: lisp/help-fns.scm
msgctxt "function:help-language-from-locale"
msgid ""
"Return the language of LOCALE, such as \"ja\" for \"ja_JP.UTF-8\".\n"
"Return \"en\" if LOCALE is #f, empty, \"C\" or \"POSIX\"."
msgstr ""
"LOCALE の言語を返す (\"ja_JP.UTF-8\" なら \"ja\")。\n"
"LOCALE が #f, 空, \"C\", \"POSIX\" なら \"en\" を返す。"

#: lisp/help-fns.scm
msgctxt "variable:help-language"
msgid ""
"Language of the docstrings shown in *Help*, such as \"ja\".\n"
"If there is no translation in this language, or it is \"en\", show the original docstring.\n"
"The default is taken from the environment variable LANG."
msgstr ""
"*Help* に出す docstring の言語 (\"ja\" など)。\n"
"この言語の翻訳が無いか, \"en\" なら, 元の docstring を出す。\n"
"既定は, 環境変数 LANG から取る。"

#: lisp/help-fns.scm
msgctxt "function:help-file-name-nondirectory"
msgid "Return FILE without its directory."
msgstr "FILE から, ディレクトリを除いたものを返す"

#: lisp/help-fns.scm
msgctxt "function:help-function-names"
msgid ""
"Return the names of all functions and commands, sorted.\n"
"They are the functions defined in Lisp or Rust, and the commands written in TypeScript."
msgstr ""
"全ての関数とコマンドの名前を, 名前の順で返す。\n"
"Lisp か Rust で定義した関数と, TypeScript で書いたコマンド。"

#: lisp/help-fns.scm
msgctxt "function:help-unique"
msgid "Return ITEMS without duplicates, keeping the first ones."
msgstr "ITEMS から重なりを除いたものを返す (始めのものを残す)"

#: lisp/help-fns.scm
msgctxt "function:help-lisp-function-p"
msgid "Return true if FUNCTION is defined in Lisp."
msgstr "FUNCTION が Lisp で定義した関数なら, 真を返す"

#: lisp/help-fns.scm
msgctxt "function:help-arglist-string"
msgid ""
"Return the argument list of the Lisp function FUNCTION as a string.\n"
"For example, \"(find-file &rest ARGS)\"."
msgstr ""
"Lisp の関数 FUNCTION の引数の形を, 文字列で返す。\n"
"例えば \"(find-file &rest ARGS)\"。"

#: lisp/help-fns.scm
msgctxt "function:help-function-kind"
msgid ""
"Return the first line of the help of FUNCTION, such as\n"
"\"find-file is an interactive Lisp function in `files.scm'.\""
msgstr ""
"FUNCTION のヘルプの 1 行目を返す。例えば\n"
"\"find-file is an interactive Lisp function in `files.scm'.\""

#: lisp/help-fns.scm
msgctxt "function:help-function-text"
msgid "Return the text of the help of FUNCTION (a symbol)."
msgstr "FUNCTION (記号) のヘルプの文を返す"

#: lisp/help-fns.scm
msgctxt "function:help-show"
msgid "Show TEXT in the *Help* buffer, in another window."
msgstr "TEXT を *Help* バッファに入れ, ほかのウィンドウに出す"

#: lisp/help-fns.scm
msgctxt "function:describe-function"
msgid ""
"Display the full documentation of FUNCTION (a symbol).\n"
"Interactively, read FUNCTION in the minibuffer with completion."
msgstr ""
"FUNCTION (記号) の説明を全て出す。\n"
"対話的に呼ぶと, FUNCTION をミニバッファで (補完しながら) 聞く。"

#: lisp/howm.scm
msgctxt "variable:howm-directory"
msgid "Directory where memos are stored."
msgstr "メモを置くディレクトリ"

#: lisp/howm.scm
msgctxt "variable:howm-file-name-format"
msgid ""
"Format of a new memo file name, relative to `howm-directory'.\n"
"It is passed to `format-time-string'."
msgstr "メモのファイルの名前 (format-time-string の書式. howm-directory からのパス)"

#: lisp/howm.scm
msgctxt "variable:howm-file-name-regexp"
msgid "Regexp of the file names treated as memos."
msgstr "メモのファイルの名前 (正規表現. これに合うファイルを, メモとして扱う)"

#: lisp/howm.scm
msgctxt "variable:howm-excluded-file-regexp"
msgid ""
"Regexp of the paths not treated as memos.\n"
"The menu file, the history, backups and so on match it."
msgstr "メモとして扱わないファイル (パスの正規表現. メニューのファイル, 履歴, バックアップなど)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-file"
msgid ""
"Menu file, or #f to use the default one in `howm-directory'.\n"
"The default menu is written if the file does not exist."
msgstr "メニューのファイル (無ければ, 既定のメニューを書く)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-schedule-days"
msgid "Number of days of the schedule shown in the menu, counted from today."
msgstr "メニューに出す, 予定の日数 (今日から), todo の数, 最近のメモの数, ランダムなメモの数"

#: lisp/howm.scm
msgctxt "variable:howm-menu-todo-num"
msgid "Number of todo items shown in the menu."
msgstr "メニューに出す todo の数"

#: lisp/howm.scm
msgctxt "variable:howm-menu-recent-num"
msgid "Number of recent memos shown in the menu."
msgstr "メニューに出す, 最近のメモの数"

#: lisp/howm.scm
msgctxt "variable:howm-menu-random-num"
msgid "Number of random memos shown in the menu."
msgstr "メニューに出す, 無作為に選んだメモの数"

#: lisp/howm.scm
msgctxt "variable:howm-menu-allow"
msgid "Procedures that %here% in the menu may call."
msgstr "メニューの %here% で呼べる手続き"

#: lisp/howm.scm
msgctxt "variable:howm-view-title-header"
msgid "String that starts the title line of a memo."
msgstr "メモの題の行の始め"

#: lisp/howm.scm
msgctxt "variable:howm-date-format"
msgid "Format of a date inserted into a memo."
msgstr "日付と日時の書式 (メモを作るとき, 日付を入れるときに使う)"

#: lisp/howm.scm
msgctxt "variable:howm-dtime-format"
msgid "Format of a date and time inserted into a memo."
msgstr "メモに入れる日時の書式"

#: lisp/howm.scm
msgctxt "variable:howm-view-contents"
msgid ""
"If true, show the memo of the current line in the other window.\n"
"This is used when moving in the summary buffer."
msgstr "一覧で動くと, その行のメモを, もう 1 つの窓に出す (#f なら出さない)"

#: lisp/howm.scm
msgctxt "variable:howm-history-file"
msgid ""
"File of the search history.\n"
"If #f, use .howm-history in `howm-directory'."
msgstr "検索の履歴のファイル (#f なら, howm-directory の .howm-history) と, 覚える数"

#: lisp/howm.scm
msgctxt "variable:howm-history-limit"
msgid "Number of keywords kept in the search history."
msgstr "検索の履歴に残すキーワードの数"

#: lisp/howm.scm
msgctxt "variable:howm-date-repeat-max"
msgid "Maximum number of lines added when repeating a date (~yymmdd)."
msgstr "日付を繰り返すとき (~yymmdd) に, 足す行の数の上限"

#: lisp/howm.scm
msgctxt "variable:howm-menu-name"
msgid "Name of the menu buffer."
msgstr "メニュー, 一覧, 速記のバッファの名前"

#: lisp/howm.scm
msgctxt "variable:howm-summary-name"
msgid "Name of the summary buffer."
msgstr "一覧のバッファの名前"

#: lisp/howm.scm
msgctxt "variable:howm-remember-name"
msgid "Name of the buffer for quick notes (`howm-remember')."
msgstr "手早く書くメモ (`howm-remember') のバッファの名前"

#: lisp/howm.scm
msgctxt "variable:howm-set-mode-on-find-file"
msgid ""
"If true, turn on `howm-mode' for memos opened by \\[find-file].\n"
"If #f, only memos opened from howm use it."
msgstr "C-x C-f などで開いたメモも, メモのバッファ (howm-mode) にする (#f なら, howm から開いたメモだけ)"

#: lisp/howm.scm
msgctxt "variable:howm-refresh-after-save"
msgid "If true, underline the memo again after saving it."
msgstr "保存したら, 下線を引き直す. メニューを出していれば, 出し直す"

#: lisp/howm.scm
msgctxt "variable:howm-menu-refresh-after-save"
msgid "If true, refresh the menu after saving a memo."
msgstr "真なら, メモを保存したあとに, メニューを作り直す"

#: lisp/howm.scm
msgctxt "variable:howm-after-save-hook"
msgid "Hook run after saving a memo."
msgstr "メモを保存したあとに実行するフック"

#: lisp/howm.scm
msgctxt "variable:howm-default-menu"
msgid ""
"Default menu, written when the menu file does not exist.\n"
"It is taken from ja/0000-00-00-000000.txt of howm."
msgstr "既定のメニュー (howm の ja/0000-00-00-000000.txt から, この版で使えるものを残した)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-buttons"
msgid ""
"Alist of button labels and commands.\n"
"A command marked menu runs in the menu; the others run in the buffer\n"
"shown before the menu."
msgstr "ボタンの名前と, コマンド. menu と書いたものはメニューで, ほかはメニューを開く前のバッファで動かす"

#: lisp/howm.scm
msgctxt "variable:howm-summary-items"
msgid ""
"Items of the current summary, a list of (FILE LINE TEXT).\n"
"If FILE is #f, TEXT is searched for."
msgstr "今の一覧の項目 ((ファイル 行の番号 文字) のリスト. ファイルが #f なら, 文字を探す)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-data"
msgid ""
"Data of each menu buffer.\n"
"A list of (BUFFER-NAME REFRESH SHORTCUTS ITEMS FILE)."
msgstr "メニューのバッファごとの, ((バッファの名前 出し直す手続き ショートカット 項目 ファイル) ...)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-previous-buffer"
msgid "Name of the buffer shown before the menu."
msgstr "メニューと速記を開く前のバッファの名前"

#: lisp/howm.scm
msgctxt "variable:howm-remember-previous-buffer"
msgid "Name of the buffer shown before `howm-remember'."
msgstr "`howm-remember' の前に出していたバッファの名前"

#: lisp/howm.scm
msgctxt "variable:howm-history-list"
msgid "Search history, newest first, or #f before it is loaded."
msgstr "検索の履歴 (新しい順. 読む前は #f) と, キーワード (\"<<< 言葉\" の言葉. 集める前は #f)"

#: lisp/howm.scm
msgctxt "variable:howm-keyword-cache"
msgid "Keywords (words of \"<<< word\"), or #f before they are collected."
msgstr "キーワード (\"<<< 語\" の語). 集める前は #f"

#: lisp/howm.scm
msgctxt "function:howm-replace-all"
msgid "Return TEXT with every FROM replaced by TO."
msgstr "文字列の中の from を, 全て to にする"

#: lisp/howm.scm
msgctxt "function:howm-take"
msgid "Return the first N elements of ITEMS."
msgstr "ITEMS の始めの N 個を返す"

#: lisp/howm.scm
msgctxt "function:howm-drop"
msgid "Return ITEMS without the first N elements."
msgstr "ITEMS から, 始めの N 個を除いたものを返す"

#: lisp/howm.scm
msgctxt "function:howm-unique"
msgid "Return ITEMS without duplicates, keeping the first ones."
msgstr "同じものを除く (始めのものを残す)"

#: lisp/howm.scm
msgctxt "function:howm-range"
msgid "Return the list of numbers from 0 to N - 1."
msgstr "0 から n - 1 までの数"

#: lisp/howm.scm
msgctxt "function:howm-index-of"
msgid "Return the position of ITEM in ITEMS, counted from 0, or #f."
msgstr "リストの中の位置 (0 から. 無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-pick"
msgid "Return a random element of ITEMS."
msgstr "ランダムに 1 つ"

#: lisp/howm.scm
msgctxt "function:howm-floor"
msgid "Return X rounded down."
msgstr "数の切り捨て"

#: lisp/howm.scm
msgctxt "function:howm-case-fold"
msgid ""
"Make REGEXP ignore case if KEYWORD has no upper case letters.\n"
"This is the same as howm."
msgstr "大文字を含まなければ, 大文字と小文字を区別しない正規表現にする (howm と同じ)"

#: lisp/howm.scm
msgctxt "function:howm-matches"
msgid ""
"Return the positions of the matches of REGEXP in LINE.\n"
"Each element is the list of (START END) of the match and of each group,\n"
"counted in characters.  A group that did not match is #f."
msgstr "行の中の, 正規表現に合う所の位置のリスト. それぞれ, 合った所と括弧ごとの (始め 終わり) (文字の数. 合わなかった括弧は #f)"

#: lisp/howm.scm
msgctxt "function:howm-group"
msgid "Return the text of LINE at POSITION, a list of (START END)."
msgstr "位置 ((始め 終わり)) の文字"

#: lisp/howm.scm
msgctxt "function:howm-replace-matches"
msgid "Replace each match of REGEXP in LINE with (PROC LINE POSITION)."
msgstr "正規表現に合う所を, 全て (proc 行 位置) の文字にする"

#: lisp/howm.scm
msgctxt "function:howm-trim-trailing-lines"
msgid "Return LINES without the empty lines at the end."
msgstr "終わりの空の行を除く"

#: lisp/howm.scm
msgctxt "function:howm-pad2"
msgid "Return N as a string of 2 digits, such as \"01\"."
msgstr "2 桁の数 (1 → \"01\")"

#: lisp/howm.scm
msgctxt "variable:howm-day"
msgid "Number of seconds in a day."
msgstr "1 日の秒の数"

#: lisp/howm.scm
msgctxt "variable:howm-day-of-week-names"
msgid "Names of the days of the week in Japanese, from Sunday."
msgstr "曜日の名前 (日本語. 日曜から)"

#: lisp/howm.scm
msgctxt "function:howm-date-time"
msgid ""
"Return the time of DATE at noon.\n"
"Noon keeps the date right across daylight saving time."
msgstr "日付の時刻 (その日の昼. 夏時間でずれないように)"

#: lisp/howm.scm
msgctxt "function:howm-today-date"
msgid "Return the date of today, such as \"2026-10-25\"."
msgstr "今日の日付"

#: lisp/howm.scm
msgctxt "function:howm-date-shift"
msgid "Return the date DAYS days after DATE."
msgstr "日付の n 日後"

#: lisp/howm.scm
msgctxt "function:howm-day-of-week"
msgid "Return the day of the week of DATE in Japanese."
msgstr "曜日 (日, 月, ...)"

#: lisp/howm.scm
msgctxt "function:howm-date-parts"
msgid "Return the year, the month and the day of DATE as numbers."
msgstr "年, 月, 日の数と, 日付"

#: lisp/howm.scm
msgctxt "function:howm-make-date"
msgid "Return the date of year Y, month M and day D."
msgstr "Y 年 M 月 D 日の日付を返す"

#: lisp/howm.scm
msgctxt "function:howm-days-in-month"
msgid "Return the number of days of month M of year Y."
msgstr "月の日数"

#: lisp/howm.scm
msgctxt "function:howm-date-add-months"
msgid ""
"Return the date MONTHS months after DATE.\n"
"The day is limited to the end of the month."
msgstr "日付の n か月後 (日は, その月の終わりまでにする)"

#: lisp/howm.scm
msgctxt "function:howm-date-expand"
msgid ""
"Return the date written as DIGITS (yyyymmdd, yymmdd, mmdd or dd).\n"
"Omitted parts and parts of 0 are taken from BASE."
msgstr "数字 (yyyymmdd, yymmdd, mmdd, dd) の日付. 省いた所 (と 0 の所) は, base の年, 月, 日にする"

#: lisp/howm.scm
msgctxt "function:howm-dir"
msgid "Return the absolute path of `howm-directory'."
msgstr "メモのディレクトリ (絶対パス)"

#: lisp/howm.scm
msgctxt "function:howm-files"
msgid ""
"Return the memo files, sorted by name.\n"
"Files matching `howm-excluded-file-regexp' are excluded."
msgstr "メモのファイル (名前の順). 除くファイルは, howm-directory からのパスで決める"

#: lisp/howm.scm
msgctxt "function:howm-memo-file?"
msgid "Return #t if FILE is under `howm-directory'."
msgstr "howm-directory の下のファイルなら #t"

#: lisp/howm.scm
msgctxt "function:howm-file-label"
msgid "Return the name of FILE without its directory and .txt."
msgstr "ファイルの名前 (ディレクトリと .txt を除く. 一覧に出す)"

#: lisp/howm.scm
msgctxt "function:howm-file-directory"
msgid "Return the directory of FILE."
msgstr "ファイルのディレクトリ"

#: lisp/howm.scm
msgctxt "function:howm-title-line?"
msgid "Return #t if LINE is a title line, which starts with \"= \"."
msgstr "題の行なら #t (\"= \" で始まる行)"

#: lisp/howm.scm
msgctxt "function:howm-title-of"
msgid "Return the title of the title LINE."
msgstr "題の行の, 題"

#: lisp/howm.scm
msgctxt "function:howm-title"
msgid ""
"Return the title of the memo FILE, or \"\" if it has none.\n"
"The title is the first line starting with \"= \"."
msgstr "メモの題 (最初の \"= \" の行. 無ければ空)"

#: lisp/howm.scm
msgctxt "function:howm-title-or-label"
msgid "Return the title of FILE, or its name if it has no title."
msgstr "題 (無ければ, ファイルの名前)"

#: lisp/howm.scm
msgctxt "function:howm-recent-files"
msgid "Return the memo files, newest first by modification time."
msgstr "新しい順 (更新の時刻)"

#: lisp/howm.scm
msgctxt "function:howm-random-files"
msgid "Return N random memo files."
msgstr "ランダムに n 個"

#: lisp/howm.scm
msgctxt "function:howm-new-file"
msgid ""
"Return the path of a new memo file.\n"
"If the file exists, use a time one second later."
msgstr "新しいメモのファイルのパス (同じ名前のファイルがあれば, 1 秒ずつ後の時刻にする)"

#: lisp/howm.scm
msgctxt "function:howm-write-memo"
msgid "Write a new memo with TITLE, the date and time, and LINES."
msgstr "新しいメモを書く (題, 日時, 本文の行)"

#: lisp/howm.scm
msgctxt "variable:howm-come-from-regexp"
msgid "Regexp of a keyword definition, \"<<< word\"."
msgstr "キーワード (メモの \"<<< 言葉\" の言葉. 集めたものを使い回す)"

#: lisp/howm.scm
msgctxt "function:howm-keywords"
msgid ""
"Return the keywords, the words of \"<<< word\" in the memos.\n"
"The collected keywords are reused."
msgstr ""
"キーワード (メモの \"<<< 語\" の語) を返す。\n"
"集めたキーワードは, 使い回す。"

#: lisp/howm.scm
msgctxt "function:howm-keyword-regexp"
msgid "Return a regexp matching any of KEYWORDS, longer ones first."
msgstr "キーワードのどれかに合う正規表現 (長いものを先に)"

#: lisp/howm.scm
msgctxt "function:howm-set-buffer-text"
msgid "Replace the whole text of the current buffer with TEXT."
msgstr "バッファの本文を, 全て置き換える"

#: lisp/howm.scm
msgctxt "function:howm-current-line"
msgid "Return the line number of point, counted from 1."
msgstr "カーソルの行の番号 (1 から)"

#: lisp/howm.scm
msgctxt "function:howm-line-start"
msgid "Return the position of the start of LINE in TEXT, counted from 1."
msgstr "行の始めの位置 (1 から)"

#: lisp/howm.scm
msgctxt "function:howm-current-line-start"
msgid "Return the position of the start of the current line."
msgstr "カーソルの行の始めの位置"

#: lisp/howm.scm
msgctxt "function:howm-current-line-and-column"
msgid "Return the current line and the column of point in it, counted from 0."
msgstr "カーソルの行の文字と, 行の中の位置 (0 から)"

#: lisp/howm.scm
msgctxt "function:howm-replace-in-line"
msgid ""
"Replace the text from FROM to TO in the current line with TEXT.\n"
"FROM and TO are columns.  Point does not move."
msgstr "カーソルの行の, from から to まで (行の中の位置) を, text にする. カーソルは動かさない"

#: lisp/howm.scm
msgctxt "function:howm-section-range"
msgid ""
"Return the range of the memo containing LINE in LINES.\n"
"A memo runs from a title line to the line before the next title line.\n"
"LINE counts from 1; the range is (START END), counted from 0, END excluded."
msgstr "行の中の, line 行目 (1 から) を含むメモ (題の行から, 次の題の行の前まで) の, 始めと終わりの行 (0 から. 終わりは含まない)"

#: lisp/howm.scm
msgctxt "function:howm-lines-in"
msgid "Return the lines of LINES in RANGE."
msgstr "行の中の, 範囲の行"

#: lisp/howm.scm
msgctxt "function:howm-current-section"
msgid "Return the lines of the memo at point."
msgstr "カーソルのメモ (題の行から, 次の題の行の前まで) の行"

#: lisp/howm.scm
msgctxt "function:howm-current-title"
msgid "Return the title of the memo at point, or #f."
msgstr "カーソルのメモの題 (無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-switch-back"
msgid "Switch to the buffer NAME if it exists."
msgstr "バッファがあれば, そこへ移る"

#: lisp/howm.scm
msgctxt "function:howm-open"
msgid "Open FILE and go to LINE."
msgstr "ファイルを開いて, 行へ動く"

#: lisp/howm.scm
msgctxt "function:howm-mode"
msgid ""
"Make the current buffer a memo buffer.\n"
"RET runs actions and links are underlined.  The keywords are collected again."
msgstr "メモのバッファにする (RET で動かし, 下線を引く. キーワードは集め直す)"

#: lisp/howm.scm
msgctxt "function:howm-set-mode-p"
msgid ""
"Return #t if the current buffer visits a memo file.\n"
"The file must be under `howm-directory' and match `howm-file-name-regexp'."
msgstr "今のバッファが, メモのファイルなら #t (howm-directory の下で, howm-file-name-regexp に合う)"

#: lisp/howm.scm
msgctxt "function:howm-find-file-hook"
msgid ""
"Turn on `howm-mode' when a memo is opened.\n"
"This is added to `find-file-hook'."
msgstr "ファイルを開いたとき (find-file-hook): メモなら, メモのバッファにする"

#: lisp/howm.scm
msgctxt "function:howm-after-save"
msgid ""
"Refresh keywords, underlines and the menu after saving a memo.\n"
"This is added to `after-save-hook'."
msgstr "保存したとき (after-save-hook): メモなら, キーワードを集め直し, 下線を引き直し, メニューを出し直す"

#: lisp/howm.scm
msgctxt "function:howm-menu-refresh-background"
msgid "Refresh the menu if it is shown, and return to the current buffer."
msgstr "メニューを出していれば, 出し直して, 今のバッファに戻る"

#: lisp/howm.scm
msgctxt "variable:howm-highlight-regexps"
msgid "Regexps to underline, written as JavaScript regexps for the editor."
msgstr "下線を引く正規表現 (画面のエディタの, JavaScript の正規表現で書く)"

#: lisp/howm.scm
msgctxt "function:howm-highlight"
msgid "Underline links, dates, keywords and the regexps in EXTRA again."
msgstr "下線を引き直す (リンク, 日付, キーワードと, extra の正規表現)"

#: lisp/howm.scm
msgctxt "function:howm-summary-line"
msgid "Return the line of the summary for ITEM."
msgstr "一覧の 1 行"

#: lisp/howm.scm
msgctxt "function:howm-show-summary"
msgid ""
"Show ITEMS, a list of (FILE LINE TEXT), in the summary buffer.\n"
"If there are no items, show EMPTY-MESSAGE."
msgstr "項目 ((ファイル 行の番号 文字) のリスト) を, 一覧のバッファに出す"

#: lisp/howm.scm
msgctxt "function:howm-summary-item"
msgid "Return the item of the current line of the summary, or #f."
msgstr "カーソルの行の項目 (無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-summary-contents"
msgid "Show the memo of the current line in the other window."
msgstr "カーソルの行のメモを, もう 1 つの窓に出す"

#: lisp/howm.scm
msgctxt "function:howm-summary-open"
msgid ""
"Open the item of the current line.\n"
"If the item has no file, search for its text."
msgstr "カーソルの行の項目を開く (ファイルが無ければ, 文字を探す)"

#: lisp/howm.scm
msgctxt "function:howm-summary-next"
msgid "Move to the next line and show its memo."
msgstr "次と前の行へ動いて, その行のメモを出す (一覧の n と p)"

#: lisp/howm.scm
msgctxt "function:howm-summary-previous"
msgid "Move to the previous line and show its memo."
msgstr "前の行へ動き, その行のメモを出す"

#: lisp/howm.scm
msgctxt "function:howm-file-items"
msgid "Return the title lines of FILES as summary items."
msgstr "ファイルごとに, 題の行を項目にする"

#: lisp/howm.scm
msgctxt "function:howm-search"
msgid ""
"Search the memos for REGEXP.\n"
"Lines of \"<<< KEYWORD\" come first, then newer files first."
msgstr "正規表現で探して, come-from (<<< 言葉) の行を先に, あとは新しいファイルの順に並べる"

#: lisp/howm.scm
msgctxt "function:howm-search-keyword"
msgid "Search the memos for KEYWORD as a fixed string."
msgstr "言葉 (そのままの文字) で探す"

#: lisp/howm.scm
msgctxt "function:howm-search-keyword-with-history"
msgid "Search the memos for KEYWORD and add it to the history."
msgstr "履歴に残して, 言葉で探す"

#: lisp/howm.scm
msgctxt "function:howm-search-fixed"
msgid "Read a keyword with completion and search the memos for it."
msgstr "言葉を (キーワードを補完して) 聞いて探す (C-c , s. メニューの s)"

#: lisp/howm.scm
msgctxt "function:howm-search-regexp"
msgid "Read a regexp and search the memos for it."
msgstr "正規表現を聞いて探す (C-c , g. メニューの g)"

#: lisp/howm.scm
msgctxt "function:howm-search-day"
msgid "Search the memos for the date DAYS days after today."
msgstr "今日から n 日後の日付の, メモ"

#: lisp/howm.scm
msgctxt "function:howm-today"
msgid "Search the memos for the date of today."
msgstr "今日と昨日の日付のメモ (メニューの . と :)"

#: lisp/howm.scm
msgctxt "function:howm-yesterday"
msgid "Search the memos for the date of yesterday."
msgstr "昨日の日付で, メモを探す"

#: lisp/howm.scm
msgctxt "function:howm-occur"
msgid "Read a regexp and list its matches in the current buffer."
msgstr "今のバッファの中を, 正規表現で探す (C-c , o. メニューの o)"

#: lisp/howm.scm
msgctxt "variable:howm-roma-table"
msgid "Alist of romaji and hiragana."
msgstr "ローマ字と, ひらがなの表"

#: lisp/howm.scm
msgctxt "variable:howm-hiragana"
msgid "Hiragana letters, in the same order as `howm-katakana'."
msgstr "ひらがな (`howm-katakana' と同じ順)"

#: lisp/howm.scm
msgctxt "variable:howm-katakana"
msgid "Katakana letters, in the same order as `howm-hiragana'."
msgstr "カタカナ (`howm-hiragana' と同じ順)"

#: lisp/howm.scm
msgctxt "function:howm-roma-lookup"
msgid ""
"Return the romaji spelling at index I of ROMA, or #f.\n"
"The result is (ROMAJI KANA); longer spellings are tried first."
msgstr "ローマ字の, i 文字目からの綴り ((ローマ字 かな). 長いものを先に. 無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-roma-to-hiragana"
msgid ""
"Convert ROMA to hiragana.\n"
"Letters that cannot be converted are kept."
msgstr "ローマ字を, ひらがなにする (かなにできない文字は, そのまま)"

#: lisp/howm.scm
msgctxt "function:howm-hiragana-to-katakana"
msgid "Convert the hiragana in TEXT to katakana."
msgstr "ひらがなを, カタカナにする"

#: lisp/howm.scm
msgctxt "function:howm-migemo-regexp"
msgid "Return a regexp matching ROMA as romaji, hiragana or katakana."
msgstr "ローマ字, ひらがな, カタカナのどれかに合う正規表現"

#: lisp/howm.scm
msgctxt "function:howm-search-migemo"
msgid ""
"Read romaji and search the memos for it.\n"
"Hiragana and katakana are also searched for."
msgstr "ローマ字を聞いて探す (C-c , m. メニューの m)"

#: lisp/howm.scm
msgctxt "function:howm-history-path"
msgid "Return the path of the history file."
msgstr "履歴のファイル"

#: lisp/howm.scm
msgctxt "function:howm-history-load"
msgid ""
"Return the search history, newest first.\n"
"The history is read from the file the first time."
msgstr "履歴 (新しい順. 始めに, ファイルから読む)"

#: lisp/howm.scm
msgctxt "function:howm-history-add"
msgid "Add KEYWORD to the search history and write the history file."
msgstr "履歴に足して, ファイルに書く"

#: lisp/howm.scm
msgctxt "function:howm-history"
msgid ""
"List the search history.\n"
"RET on a line searches for its keyword."
msgstr "履歴の一覧 (C-c , h. RET で, その言葉を探す)"

#: lisp/howm.scm
msgctxt "function:howm-list-all"
msgid "List all memos, newest first."
msgstr "全てのメモの一覧 (新しい順. C-c , a)"

#: lisp/howm.scm
msgctxt "function:howm-list-recent"
msgid "List the recent memos."
msgstr "最近のメモの一覧 (C-c , l)"

#: lisp/howm.scm
msgctxt "function:howm-list-around"
msgid "List all memos with point on the current memo."
msgstr "前後のメモ (全てのメモの一覧で, 今のメモの行にカーソルを置く. C-c , A)"

#: lisp/howm.scm
msgctxt "function:howm-buffer-links"
msgid ""
"Return the words to search for in the current buffer.\n"
"These are the links and the keywords."
msgstr "今のバッファの, 探せる言葉 (リンクとキーワード)"

#: lisp/howm.scm
msgctxt "function:howm-random-walk"
msgid ""
"Take one step of a random walk.\n"
"In the summary, open a random line.  In a memo, search for a random link,\n"
"or open a random memo if there are no links.  Call it again to continue."
msgstr "酔歩 (C-c , w): 一覧なら, ランダムな行を開く. メモなら, ランダムなリンクを探す. リンクが無ければ, ランダムなメモを開く. 1 回に 1 歩なので, 続けるときは, もう一度呼ぶ"

#: lisp/howm.scm
msgctxt "variable:howm-reminder-regexp"
msgid ""
"Regexp of a reminder, such as [2026-10-25]+7.\n"
"The groups are the date, the type, the laziness and the rest."
msgstr "予定と todo の正規表現 ([2026-10-25]+7 の, 日付, 種類, 猶予, 残り)"

#: lisp/howm.scm
msgctxt "variable:howm-reminder-action-regexp"
msgid ""
"Regexp of the parts of a reminder that RET acts on.\n"
"The groups are the date, the type and laziness, the type and the laziness."
msgstr "RET で動かす所 (日付, 種類と猶予, 種類, 猶予)"

#: lisp/howm.scm
msgctxt "variable:howm-reminder-laziness"
msgid "Alist of reminder types and their default laziness in days."
msgstr "種類ごとの, 猶予の既定の日数"

#: lisp/howm.scm
msgctxt "variable:howm-huge"
msgid "Priority of the bottom and the top, as howm-huge of howm."
msgstr "底と天井 (howm の howm-huge)"

#: lisp/howm.scm
msgctxt "variable:howm-huge+"
msgid "Priority above `howm-huge'."
msgstr "`howm-huge' より上の優先度"

#: lisp/howm.scm
msgctxt "variable:howm-huge++"
msgid "Priority above `howm-huge+'."
msgstr "`howm-huge+' より上の優先度"

#: lisp/howm.scm
msgctxt "function:howm-priority"
msgid ""
"Return the priority of a reminder of TYPE.\n"
"LATE is the number of days since its date; LAZINESS is in days.\n"
"This is howm-todo-priority-* of howm."
msgstr "優先度 (howm の howm-todo-priority-*). late は, 日付から今までの日数"

#: lisp/howm.scm
msgctxt "function:howm-reminders"
msgid ""
"Return the reminders in the memos.\n"
"Each is a list of (PRIORITY DATE TYPE FILE LINE TEXT)."
msgstr "予定と todo の項目 ((優先度 日付 種類 ファイル 行の番号 文字) のリスト)"

#: lisp/howm.scm
msgctxt "function:howm-reminder-item"
msgid "Return REMINDER as a summary item, (FILE LINE TEXT)."
msgstr "項目を, 一覧の項目 ((ファイル 行の番号 文字)) にする"

#: lisp/howm.scm
msgctxt "function:howm-schedule"
msgid ""
"Return the schedule (@), sorted by date.\n"
"If DAYS is a number, only the next DAYS days from today."
msgstr "予定 (@) を日付の順に. days が数なら, 今日からその日数先まで"

#: lisp/howm.scm
msgctxt "function:howm-todo"
msgid ""
"Return the todo items, sorted by priority.\n"
"Schedules, done items and items sunk to the bottom are excluded."
msgstr "todo (@ と . のほか) を優先度の順に (底に沈んだものは除く)"

#: lisp/howm.scm
msgctxt "function:howm-list-schedule"
msgid "List the schedule."
msgstr "予定と todo の一覧 (C-c , y と C-c , t)"

#: lisp/howm.scm
msgctxt "function:howm-list-todo"
msgid "List the todo items."
msgstr "todo を一覧にする"

#: lisp/howm.scm
msgctxt "function:howm-reminder-action"
msgid ""
"Act on the type of the reminder in the current line.\n"
"RET marks it done, x cancels it, a type letter or a number changes the\n"
"type or the laziness.  FROM is the column of the date."
msgstr "予定と todo の記号の上の RET: 済み (RET), 取り消し (x), 種類 (記号) と猶予 (数) を変える. from は, 行の中の, 日付の位置"

#: lisp/howm.scm
msgctxt "function:howm-date-action"
msgid ""
"Act on the date from FROM to TO in the current line.\n"
"RET lists it (unless NEW?), +3 or -1 shifts it, yymmdd changes it, . sets\n"
"today, ~yymmdd repeats it, and [ or ] shifts it by one day."
msgstr "日付の上の RET: 一覧 (RET. new? なら何もしない), ずらす (+3, -1), 変える (yymmdd), 今日 (.), 繰り返す (~yymmdd), 1 日ずつずらす ([ と ]). 日付は, カーソルの行の from から to まで"

#: lisp/howm.scm
msgctxt "function:howm-date-quickshift"
msgid ""
"Shift DATE by DAYS days and call REPLACE with the new date.\n"
"Then read [ or ] to shift it by one more day, or . for today; anything\n"
"else ends."
msgstr "1 日ずつずらす (続けて [ か ] を入れる. . は今日. ほかは終わり)"

#: lisp/howm.scm
msgctxt "function:howm-date-repeat"
msgid ""
"Repeat the current line below it with the date changed until UNTIL.\n"
"The date is DATE, from FROM to TO in the line."
msgstr "カーソルの行を, until の日付まで, 日付を変えて繰り返す (下に足す)"

#: lisp/howm.scm
msgctxt "function:howm-create-memo"
msgid ""
"Create a new memo with TITLE and open it.\n"
"If TITLE is empty, put point where the title goes."
msgstr "新しいメモを作って開く (題の行と日時を入れる. 題が空なら, 題の所にカーソルを置く)"

#: lisp/howm.scm
msgctxt "function:howm-create"
msgid "Create a new memo."
msgstr "新しいメモ (C-c , c)"

#: lisp/howm.scm
msgctxt "function:howm-wiki"
msgid ""
"Act on [[KEYWORD]].\n"
"Create a memo of \"<<< KEYWORD\" if there is none, or search for it.\n"
"If KEYWORD is %name%, open that menu."
msgstr "[[言葉]] の上の RET: \"<<< 言葉\" のメモが無ければ作り, あれば探す. %名前% なら, そのメニューを開く"

#: lisp/howm.scm
msgctxt "function:howm-remember"
msgid ""
"Write a quick note in a buffer of its own.\n"
"\\[howm-remember-submit] saves it as a new memo whose title is its first line.\n"
"\\[howm-remember-discard] discards it."
msgstr "速記 (C-c , e): *howm-remember* に書いて, C-c C-c で新しいメモにする (1 行目が題). C-c C-k で取り消す"

#: lisp/howm.scm
msgctxt "function:howm-remember-close"
msgid "Kill the quick note buffer and return to the previous buffer."
msgstr "速記のバッファを消して, 前のバッファに戻る"

#: lisp/howm.scm
msgctxt "function:howm-remember-submit"
msgid "Save the quick note as a new memo."
msgstr "手早く書いたメモを, 新しいメモとして保存する"

#: lisp/howm.scm
msgctxt "function:howm-remember-discard"
msgid "Discard the quick note."
msgstr "手早く書いたメモを捨てる"

#: lisp/howm.scm
msgctxt "function:howm-dup"
msgid "Copy the memo at point to a new memo and open it."
msgstr "複製 (C-c , D): カーソルのメモ (題の行から, 次の題の行の前まで) を, 新しいメモにして開く"

#: lisp/howm.scm
msgctxt "function:howm-title-to-kill-ring"
msgid ""
"Put the title of the memo at point in the kill ring.\n"
"If it has no title, use the file name."
msgstr "カーソルのメモの題を, kill ring に入れる (無ければ, ファイルの名前. C-c , K)"

#: lisp/howm.scm
msgctxt "function:howm-name-to-kill-ring"
msgid "Put the file name of the current buffer in the kill ring."
msgstr "ファイルの名前を, kill ring に入れる"

#: lisp/howm.scm
msgctxt "function:howm-insert-keyword"
msgid "Read a keyword with completion and insert it."
msgstr "キーワードを補完して入れる (C-c , i)"

#: lisp/howm.scm
msgctxt "function:howm-insert-date"
msgid "Insert the date of today and act on it as RET on a date does."
msgstr "今日の日付を入れて, 日付の RET と同じく変えられるようにする (C-c , d)"

#: lisp/howm.scm
msgctxt "function:howm-insert-dtime"
msgid "Insert the current date and time."
msgstr "今の日時を入れる (C-c , T)"

#: lisp/howm.scm
msgctxt "function:howm-buffer?"
msgid ""
"Return #t if NAME is a howm buffer.\n"
"Memos, the menu, the summary and quick notes are howm buffers."
msgstr "howm のバッファ (メモ, メニュー, 一覧, 速記) なら #t"

#: lisp/howm.scm
msgctxt "function:howm-kill-all"
msgid "Kill all howm buffers except modified ones."
msgstr "howm のバッファを全て消す (書き換えたものは残す. C-c , Q)"

#: lisp/howm.scm
msgctxt "function:howm-list-buffers"
msgid "List the buffers."
msgstr "バッファの一覧 (C-c , b)"

#: lisp/howm.scm
msgctxt "function:howm-refresh"
msgid "Underline the current buffer again, or refresh it if it is the menu."
msgstr "下線を引き直す (メニューなら, 出し直す. C-c , r)"

#: lisp/howm.scm
msgctxt "function:howm-settings"
msgid "Open the init file."
msgstr "初期設定ファイルを開く ([設定])"

#: lisp/howm.scm
msgctxt "function:howm-link-action"
msgid ""
"Act on the word of \">>> KEYWORD\".\n"
"If KEYWORD is %name%, open that menu; otherwise search for it."
msgstr ">>> の言葉 (%名前% なら, そのメニューを開く)"

#: lisp/howm.scm
msgctxt "function:howm-action-rules"
msgid ""
"Return the rules of the parts that RET acts on.\n"
"Each is (REGEXP GROUP MAKE-ACTION); earlier rules win.\n"
"If MENU? is true, the rules of the menu are included."
msgstr "RET で動く所の規則 ((正規表現 位置の括弧 動きを作る手続き) のリスト). 先のものを優先する"

#: lisp/howm.scm
msgctxt "function:howm-line-actions"
msgid ""
"Return the parts of LINE that RET acts on, a list of (START END ACTION).\n"
"If MENU? is true, the rules of the menu are used too."
msgstr "行の中の, RET で動く所 ((始め 終わり 動き) のリスト. 規則の順)"

#: lisp/howm.scm
msgctxt "function:howm-action-at"
msgid ""
"Return the action at COLUMN of LINE, or #f.\n"
"If MENU? is true, the rules of the menu are used too."
msgstr "行の中の, 位置 (0 から) で動くもの (無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-run-action"
msgid "Run ACTION."
msgstr "動かす"

#: lisp/howm.scm
msgctxt "function:howm-action-at-point"
msgid "Run the action at point.  Return #t if there was one."
msgstr "カーソルの所のものを動かす. 動かしたら #t"

#: lisp/howm.scm
msgctxt "function:howm-menu-open-item"
msgid ""
"Open the menu item of the current line among ITEMS.\n"
"On a reminder type or a date, act on it in the memo.  Return #t if opened."
msgstr "メニューの項目を開く. 予定と todo の記号か日付の上なら, メモのその所で RET を押す. 開いたら #t"

#: lisp/howm.scm
msgctxt "function:howm-action"
msgid ""
"Act on the thing at point.\n"
"In the summary, open the memo of the line.  In the menu, open the item.\n"
"On a button or a link, run it."
msgstr "RET: 一覧なら, その行のメモを開く. メニューの項目なら開く. ボタンやリンクなら動かす"

#: lisp/howm.scm
msgctxt "function:howm-action-or-newline"
msgid ""
"Act on the thing at point, or insert a newline if there is none.\n"
"This is RET in memo buffers."
msgstr "動くものがあれば動かし, 無ければ改行する (メモのバッファの RET)"

#: lisp/howm.scm
msgctxt "function:howm-menu-buffer?"
msgid "Return #t if the current buffer is a menu."
msgstr "メニューのバッファなら #t"

#: lisp/howm.scm
msgctxt "function:howm-menu-keyword?"
msgid "Return #t if KEYWORD has the form %name%."
msgstr "%名前% の形なら #t"

#: lisp/howm.scm
msgctxt "function:howm-button"
msgid "Return the button of LABEL, (LABEL COMMAND [menu]), or #f."
msgstr "ボタン ((名前 コマンド [menu])). 無ければ #f"

#: lisp/howm.scm
msgctxt "function:howm-menu-in-previous"
msgid "Call THUNK in the buffer shown before the menu."
msgstr "メニューを開く前のバッファに戻って, 動かす"

#: lisp/howm.scm
msgctxt "function:howm-run-button"
msgid "Press the button of LABEL."
msgstr "ボタンを押す"

#: lisp/howm.scm
msgctxt "function:howm-menu-path"
msgid ""
"Return the path of the menu file.\n"
"Write the default menu if the file does not exist."
msgstr "メニューのファイル (無ければ, 既定のメニューを書く)"

#: lisp/howm.scm
msgctxt "function:howm-section-of"
msgid ""
"Return the memo of \"<<< KEYWORD\" in TEXT, or #f.\n"
"It runs from the title line to the line before the next title line."
msgstr "文字の中の, \"<<< 言葉\" の題の行から, 次の題の行の前まで (無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-menu-find-section"
msgid ""
"Find the menu of \"<<< KEYWORD\".\n"
"The menu file is searched first, then the memos.\n"
"Return (FILE TEXT), or #f."
msgstr "\"<<< %名前%\" のメニュー ((ファイル 文字). メニューのファイル, メモの順に探す. 無ければ #f)"

#: lisp/howm.scm
msgctxt "function:howm-menu-current-data"
msgid "Return the entry of `howm-menu-data' for the current buffer, or #f."
msgstr "今のメニューのバッファの, データ (無ければ #f) と項目"

#: lisp/howm.scm
msgctxt "function:howm-menu-items"
msgid "Return the items of the current menu buffer."
msgstr "今のメニューのバッファの項目を返す"

#: lisp/howm.scm
msgctxt "function:howm-menu"
msgid "Show the howm menu."
msgstr "メニューを出す (M-x howm, C-c , ,)"

#: lisp/howm.scm
msgctxt "function:howm"
msgid "Show the howm menu."
msgstr "howm のメニューを出す"

#: lisp/howm.scm
msgctxt "function:howm-menu-open-section"
msgid "Show the menu of \"<<< KEYWORD\" (>>> %name%)."
msgstr "\"<<< %名前%\" のメニューを出す (>>> %名前%)"

#: lisp/howm.scm
msgctxt "function:howm-menu-open"
msgid ""
"Show FILE, relative to `howm-directory', as a menu.\n"
"For example, %eval%(howm-menu-open \"file.txt\")."
msgstr "ファイルを, メニューとして出す (howm-directory からのパス. %eval%(howm-menu-open \"file.txt\"))"

#: lisp/howm.scm
msgctxt "function:howm-menu-refresh"
msgid "Refresh the menu."
msgstr "メニューを出し直す ([menu 更新])"

#: lisp/howm.scm
msgctxt "function:howm-menu-edit"
msgid "Open the menu file."
msgstr "メニューのファイルを開く ([menu 編集])"

#: lisp/howm.scm
msgctxt "variable:howm-menu-key-regexp"
msgid ""
"Regexp of a shortcut in the menu, such as %\"c\"[New] or %\"fuga%\".\n"
"The groups are the word, the key, the rest of the word and the action-only %."
msgstr "メニューのショートカット (%\"c\"[新規] と %\"fuga%\") の正規表現 (言葉, キー, 言葉の続き, 動くだけの %)"

#: lisp/howm.scm
msgctxt "function:howm-menu-line-shortcuts"
msgid ""
"Return the shortcuts of LINE of the menu, a list of (KEY ACTION).\n"
"A shortcut runs the first action after its \"."
msgstr "メニューの元の 1 行の, ショートカット ((キー 動き) のリスト). \" の後の, 最初の動くものを動かす"

#: lisp/howm.scm
msgctxt "function:howm-menu-visible"
msgid ""
"Return (TEXT HIDDEN) for LINE of the menu.\n"
"TEXT is the part made visible by %|; HIDDEN is #t if the end of the line\n"
"is hidden, and then the newline is removed too."
msgstr "%| で切り替える, 見せる所だけの文字と, 行の終わりを見せないなら #t (改行も消す)"

#: lisp/howm.scm
msgctxt "variable:howm-menu-display-rules"
msgid "Rules that turn %sdays and others into the form of %here%."
msgstr "%sdays などを, %here% の形にする"

#: lisp/howm.scm
msgctxt "variable:howm-menu-here-regexp"
msgid "Regexp of %here%."
msgstr "%here% の正規表現"

#: lisp/howm.scm
msgctxt "function:howm-menu-here"
msgid ""
"Return the value of the %here% expression TEXT.\n"
"It is the value of a variable, or of a procedure in `howm-menu-allow'.\n"
"The arguments are not evaluated."
msgstr "%here% の式の値 (変数の値か, howm-menu-allow の手続きを呼んだ値. 引数は評価しない)"

#: lisp/howm.scm
msgctxt "function:howm-menu-value-lines"
msgid ""
"Return VALUE as menu lines.\n"
"Each line is a string or (STRING FILE LINE)."
msgstr "値を, メニューの行 (文字か (文字 ファイル 行の番号)) のリストにする"

#: lisp/howm.scm
msgctxt "function:howm-menu-value-text"
msgid "Return VALUE as a string."
msgstr "値を, 文字にする"

#: lisp/howm.scm
msgctxt "function:howm-menu-expand"
msgid ""
"Replace the %here% in the visible LINE with its value.\n"
"If LINE is only %here%, it is replaced with the lines of the value."
msgstr "見せる 1 行の %here% を, 値にする (行が %here% だけなら, 値の行に置き換える)"

#: lisp/howm.scm
msgctxt "function:howm-menu-strip-keys"
msgid "Show the shortcuts of LINE as they look (%\"c\" to c, %\"fuga%\" to fuga)."
msgstr "ショートカットを, 見せる形にする (%\"c\" → c. %\"fuga%\" → fuga)"

#: lisp/howm.scm
msgctxt "function:howm-menu-render"
msgid ""
"Render the menu TEMPLATE into lines and shortcuts.\n"
"Each line is a string or (STRING FILE LINE)."
msgstr "メニューの元を, 行 (文字か (文字 ファイル 行の番号)) とショートカットにする"

#: lisp/howm.scm
msgctxt "function:howm-menu-item-lines"
msgid "Return the item lines of LINES, a list of (LINE FILE FILE-LINE)."
msgstr "行の中の, 項目の行 ((行の番号 ファイル 行の番号))"

#: lisp/howm.scm
msgctxt "function:howm-menu-key-command"
msgid ""
"Return the command of the shortcut KEY.\n"
"It runs the action of KEY in the current menu."
msgstr "ショートカットのキーのコマンド (キーごとに作る. 今のメニューの, そのキーの動きを動かす)"

#: lisp/howm.scm
msgctxt "function:howm-menu-run-key"
msgid "Run the action of the shortcut KEY in the current menu."
msgstr "今のメニューで, ショートカットのキー KEY の動作を実行する"

#: lisp/howm.scm
msgctxt "function:howm-menu-show"
msgid ""
"Show the menu NAME, such as %menu%, rendered from TEMPLATE.\n"
"FILE is the file of the template; RELOAD refreshes the menu."
msgstr "メニューを出す. name は %menu% など, file は元のファイル, reload は出し直す手続き"

#: lisp/howm.scm
msgctxt "function:howm-menu-legend"
msgid "Return the legend of the reminder types, for %here%."
msgstr "%here% で呼べる手続き (予定と todo の説明, 予定, todo, 最近, ランダム, 検索, 出した時刻)"

#: lisp/howm.scm
msgctxt "function:howm-reminder-lines"
msgid "Return REMINDERS as menu lines."
msgstr "REMINDERS を, メニューの行にして返す"

#: lisp/howm.scm
msgctxt "function:howm-menu-schedule"
msgid "Return the schedule for the menu, for %here%."
msgstr "メニューの予定を返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-todo"
msgid "Return the todo items for the menu, for %here%."
msgstr "メニューの todo を返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-reminder"
msgid "Return the schedule and the todo items for the menu, for %here%."
msgstr "メニューの予定と todo を返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-file-lines"
msgid "Return FILES as menu lines."
msgstr "FILES を, メニューの行にして返す"

#: lisp/howm.scm
msgctxt "function:howm-menu-recent"
msgid "Return the recent memos for the menu, for %here%."
msgstr "メニューの, 最近のメモを返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-random"
msgid "Return random memos for the menu, for %here%."
msgstr "メニューの, 無作為に選んだメモを返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-search"
msgid "Return the memos matching KEYWORD for the menu, for %here%."
msgstr "メニューの, KEYWORD に合うメモを返す (%here% 用)"

#: lisp/howm.scm
msgctxt "function:howm-menu-last-update"
msgid "Return the current date and time for the menu, for %here%."
msgstr "メニューの, 今の日時を返す (%here% 用)"
